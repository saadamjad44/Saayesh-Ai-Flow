---
/**
 * Content entry pages rendered from MDX, on PageLayout: pillar hubs, cluster
 * articles, and the free interactive tools (which share the same editorial
 * frontmatter, so they share this shell too).
 * Header: category eyebrow, last updated, affiliate note, and an optional
 * category image. After the body: related internal pages, then the FAQ (with
 * its own FAQPage schema).
 *
 * Every entry page also gets the contextual sidebar, built from the registry by
 * getContentSidebar(): the current category and its articles, then the other
 * categories. PageLayout switches to its two-column grid because that slot is
 * filled, so no page has to opt in.
 *
 * `testingStatus` stays in frontmatter and is still validated (see
 * content.config.ts and ScoreTable); it is simply not surfaced as a badge.
 *
 * An entry may set a `heading` in frontmatter when its visible <h1> should read
 * more fully than its <title>; with no `heading` the <h1> is the title.
 */
import type { CollectionEntry } from "astro:content";
import PageLayout from "./PageLayout.astro";
import AffiliateNote from "@/components/content/AffiliateNote.astro";
import FaqSection from "@/components/content/FaqSection.astro";
import FeaturedImage from "@/components/content/FeaturedImage.astro";
import LastUpdated from "@/components/content/LastUpdated.astro";
import RelatedPages, { type RelatedPage } from "@/components/content/RelatedPages.astro";
import ContentSidebar from "@/components/layout/ContentSidebar.astro";
import { AUTHOR } from "@/config/author";
import type { MediaId } from "@/config/media";
import { getPage } from "@/config/pages";
import type { EntryCollection } from "@/lib/content";
import { getContentSidebar } from "@/lib/sidebar";
import { absoluteUrl, type JsonLd } from "@/lib/seo";

interface Props {
  entry: CollectionEntry<EntryCollection>;
  ogType: "website" | "article";
  jsonLd: readonly JsonLd[];
  relatedHeading: string;
  related: readonly RelatedPage[];
  /** Small label above the <h1>, e.g. the parent category. */
  eyebrow?: string;
  /** Category image shown below the header. Omit where a picture adds nothing. */
  mediaId?: MediaId;
}

const { entry, ogType, jsonLd, relatedHeading, related, eyebrow, mediaId } = Astro.props;
const { data } = entry;

const currentPath = Astro.url.pathname;
const sidebar = await getContentSidebar(getPage(data.pageId));

/**
 * Article-only Open Graph tags, from the entry's own dates and the author page.
 * The same values the visible byline shows and the Article schema carries, so
 * an og: tag can never disagree with either.
 */
const openGraphArticle =
  ogType === "article"
    ? {
        publishedTime: data.publishedDate.toISOString(),
        modifiedTime: data.updatedDate.toISOString(),
        authorUrl: absoluteUrl(AUTHOR.path),
      }
    : undefined;
---

<PageLayout
  pageId={data.pageId}
  title={data.title}
  heading={data.heading}
  description={data.description}
  eyebrow={eyebrow}
  intro={data.description}
  ogType={ogType}
  article={openGraphArticle}
  jsonLd={jsonLd}
>
  <Fragment slot="meta">
    <LastUpdated updated={data.updatedDate} pricingVerified={data.pricingVerifiedDate} />
    {data.hasAffiliateLinks && <AffiliateNote />}
  </Fragment>

  {mediaId && (
    <Fragment slot="hero">
      {/* Padding comes from PageLayout's container; only the measure is set here. */}
      <div class="pb-10 lg:max-w-3xl">
        <FeaturedImage id={mediaId} priority />
      </div>
    </Fragment>
  )}

  {sidebar && (
    <Fragment slot="sidebar">
      <ContentSidebar sidebar={sidebar} currentPath={currentPath} />
    </Fragment>
  )}

  <slot />

  <Fragment slot="after">
    <RelatedPages id="related-pages" heading={relatedHeading} items={related} />
    {data.faq && <FaqSection items={data.faq} />}
  </Fragment>
</PageLayout>
