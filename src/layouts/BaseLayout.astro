---
/**
 * Shared page shell: SEO head, font preloads, skip link, header, main, footer.
 * Content search lives inside the header now (see SearchBox), so there is no
 * separate search band under it.
 *
 * Registry pages pass `pageId`; the canonical URL, noindex flag, and
 * breadcrumbs then come from src/config/pages.ts. Pages outside the registry
 * (only the 404 page) omit `pageId` and are always noindexed with no canonical.
 *
 * This is also the one place the SEO snippet registry is applied. Every page on
 * the site renders through here, so resolveSnippet() gives
 * src/config/seo-snippets.ts authority over the <title>, meta description and
 * Open Graph pair without a single page template having to know it exists. A
 * page's own `title` and `description` remain the fallback, which is why pillar,
 * article and tool pages still read theirs from frontmatter.
 *
 * The BreadcrumbList JSON-LD is emitted here, but the *visible* trail is not:
 * it is rendered by each page template inside that page's own header, so it
 * lines up with the measured column instead of a container of its own. Both are
 * built from getBreadcrumbs(), so the trail and the schema always match.
 *
 * The body uses `overflow-x-clip`, not `overflow-x-hidden`: `hidden` would turn
 * the body into a scroll container and stop the sticky header from sticking.
 */
import "@/styles/global.css";
/**
 * The two latin font subsets every page needs for its first paint, imported for
 * their hashed build URLs so they can be preloaded. The latin-extended and
 * monospace faces are deliberately not preloaded: `unicode-range` means the
 * extended files are only fetched by a page that needs those glyphs, and the
 * monospace face is used for small labels well after first paint.
 */
import displayFontUrl from "@/assets/fonts/plus-jakarta-sans-latin.woff2?url";
import bodyFontUrl from "@/assets/fonts/inter-latin.woff2?url";
import SeoHead, { type OpenGraphArticle } from "@/components/seo/SeoHead.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import { SITE } from "@/config/site";
import { getPage, type PageId } from "@/config/pages";
import { resolveSnippet } from "@/config/seo-snippets";
import { breadcrumbSchema, getBreadcrumbs, getSocialImage, type JsonLd } from "@/lib/seo";

interface Props {
  /**
   * The page's own title, used when the snippet registry declares none. Pages
   * with no content entry behind them declare their title in the registry
   * instead, which assertValidSeoSnippets() enforces.
   */
  title?: string;
  /** The page's own meta description, used when the registry declares none. */
  description?: string;
  pageId?: PageId;
  /** Forces noindex. Registry pages marked `noindex` are always noindexed. */
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Article-only Open Graph tags, for `ogType: "article"` pages. */
  article?: OpenGraphArticle;
  jsonLd?: readonly JsonLd[];
}

const { title, description, pageId, noindex = false, ogType, article, jsonLd = [] } = Astro.props;

const page = pageId ? getPage(pageId) : undefined;
const currentPath = Astro.url.pathname;

if (page && page.path !== currentPath) {
  throw new Error(`Layout pageId "${pageId}" expects ${page.path} but is rendering ${currentPath}`);
}

const snippet = resolveSnippet({ pageId, title, description });

const breadcrumbs = page ? getBreadcrumbs(page) : [];
const schemas = breadcrumbs.length > 1 ? [...jsonLd, breadcrumbSchema(breadcrumbs)] : jsonLd;

// Every page gets a social image: its own, its pillar's, or the site default.
const socialImage = await getSocialImage(page);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Self-hosted fonts, so there is no third-party connection to open and no
      external stylesheet in front of the first paint. Both files are
      same-origin but still need `crossorigin`: fonts are always fetched in
      CORS mode, and a preload without it would be fetched twice.
    */}
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin />
    <SeoHead
      title={snippet.title}
      description={snippet.description}
      ogTitle={snippet.ogTitle}
      ogDescription={snippet.ogDescription}
      canonicalPath={page?.path}
      noindex={noindex || page?.noindex === true || !page}
      ogType={ogType}
      article={article}
      image={socialImage}
      jsonLd={schemas}
    />
    {/*
      Favicons, all square rasterisations of the Saayesh AI Flow "SAF" monogram
      in src/assets/brand/. Root-relative and stable, so Google Search can keep
      a single crawled icon across the site.

      The .ico carries 16/32/48 so browsers and legacy clients pick their own
      size without a 404 fallback; the 48px PNG is the 1:1, multiple-of-48
      source Google Search asks for; the 192px PNG covers high-DPI tabs and
      Android home screens. There is deliberately no SVG icon: Google Search
      does not use one, and a second mark in a different format is exactly what
      makes a crawler choose the wrong asset.
    */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip bg-paper text-ink-700 antialiased">
    <a
      href="#main-content"
      class="sr-only rounded-md bg-brand-700 px-4 py-2 font-semibold text-white focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60]"
    >
      Skip to main content
    </a>

    <SiteHeader currentPath={currentPath} />

    <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
