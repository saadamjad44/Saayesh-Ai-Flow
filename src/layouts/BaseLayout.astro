---
/**
 * Shared page shell: SEO head, font preloads, skip link, header, main, footer.
 * Content search lives inside the header now (see SearchBox), so there is no
 * separate search band under it.
 *
 * Registry pages pass `pageId`; the canonical URL, noindex flag, and
 * breadcrumbs then come from src/config/pages.ts. Pages outside the registry
 * (only the 404 page) omit `pageId` and are always noindexed with no canonical.
 *
 * This is also the one place the SEO snippet registry is applied. Every page on
 * the site renders through here, so resolveSnippet() gives
 * src/config/seo-snippets.ts authority over the <title>, meta description and
 * Open Graph pair without a single page template having to know it exists. A
 * page's own `title` and `description` remain the fallback, which is why pillar,
 * article and tool pages still read theirs from frontmatter.
 *
 * The BreadcrumbList JSON-LD is emitted here, but the *visible* trail is not:
 * it is rendered by each page template inside that page's own header, so it
 * lines up with the measured column instead of a container of its own. Both are
 * built from getBreadcrumbs(), so the trail and the schema always match.
 *
 * The body uses `overflow-x-clip`, not `overflow-x-hidden`: `hidden` would turn
 * the body into a scroll container and stop the sticky header from sticking.
 */
import "@/styles/global.css";
/**
 * The one latin font subset every page needs for its first paint — headings and
 * body copy are the same family — imported for its hashed build URL so it can
 * be preloaded. The latin-extended and monospace faces are deliberately not
 * preloaded: `unicode-range` means the extended files are only fetched by a
 * page that needs those glyphs, and the monospace face is used for small labels
 * well after first paint.
 */
import bodyFontUrl from "@/assets/fonts/inter-latin.woff2?url";
import SeoHead, { type OpenGraphArticle } from "@/components/seo/SeoHead.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import { SITE } from "@/config/site";
import { getPage, type PageId } from "@/config/pages";
import { resolveSnippet } from "@/config/seo-snippets";
import { breadcrumbSchema, getBreadcrumbs, getSocialImage, type JsonLd } from "@/lib/seo";

interface Props {
  /**
   * The page's own title, used when the snippet registry declares none. Pages
   * with no content entry behind them declare their title in the registry
   * instead, which assertValidSeoSnippets() enforces.
   */
  title?: string;
  /** The page's own meta description, used when the registry declares none. */
  description?: string;
  pageId?: PageId;
  /** Forces noindex. Registry pages marked `noindex` are always noindexed. */
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Article-only Open Graph tags, for `ogType: "article"` pages. */
  article?: OpenGraphArticle;
  jsonLd?: readonly JsonLd[];
}

const { title, description, pageId, noindex = false, ogType, article, jsonLd = [] } = Astro.props;

const page = pageId ? getPage(pageId) : undefined;
const currentPath = Astro.url.pathname;

if (page && page.path !== currentPath) {
  throw new Error(`Layout pageId "${pageId}" expects ${page.path} but is rendering ${currentPath}`);
}

const snippet = resolveSnippet({ pageId, title, description });

const breadcrumbs = page ? getBreadcrumbs(page) : [];
const schemas = breadcrumbs.length > 1 ? [...jsonLd, breadcrumbSchema(breadcrumbs)] : jsonLd;

// Every page gets a social image: its own, its pillar's, or the site default.
const socialImage = await getSocialImage(page);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Two things that must be settled before the first paint, so neither can
      flash: the visitor's saved theme, and whether scroll-reveal is on. The
      reveal class is only set where the observer exists and motion is welcome
      — see "Scroll reveal" in global.css — so everywhere else the page simply
      renders with everything visible.
    */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          if (localStorage.getItem("theme") === "dark") d.setAttribute("data-theme", "dark");
        } catch (e) {}
        if (
          "IntersectionObserver" in window &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches
        )
          d.classList.add("reveal-ready");
      })();
    </script>
    {/*
      Self-hosted fonts, so there is no third-party connection to open and no
      external stylesheet in front of the first paint. The file is same-origin
      but still needs `crossorigin`: fonts are always fetched in CORS mode, and
      a preload without it would be fetched twice.
    */}
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin />
    <SeoHead
      title={snippet.title}
      description={snippet.description}
      ogTitle={snippet.ogTitle}
      ogDescription={snippet.ogDescription}
      canonicalPath={page?.path}
      noindex={noindex || page?.noindex === true || !page}
      ogType={ogType}
      article={article}
      image={socialImage}
      jsonLd={schemas}
    />
    {/*
      Favicons, all square rasterisations of the Saayesh AI Flow "SAF" monogram
      in src/assets/brand/. Root-relative and stable, so Google Search can keep
      a single crawled icon across the site.

      The .ico carries 16/32/48 so browsers and legacy clients pick their own
      size without a 404 fallback; the 48px PNG is the 1:1, multiple-of-48
      source Google Search asks for; the 192px PNG covers high-DPI tabs and
      Android home screens. There is deliberately no SVG icon: Google Search
      does not use one, and a second mark in a different format is exactly what
      makes a crawler choose the wrong asset.
    */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip bg-paper text-ink-700 antialiased">
    <a
      href="#main-content"
      class="btn btn-primary sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60]"
    >
      Skip to main content
    </a>

    <SiteHeader currentPath={currentPath} />

    <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>

    <SiteFooter />
    <script is:inline>
      document.querySelectorAll('a[href^="http"]').forEach(function (a) {
        if (a.hostname !== location.hostname) {
          a.target = "_blank";
          a.rel = "noopener noreferrer";
        }
      });

      /*
        Scroll reveal. `reveal-ready` was set in <head> under the same two
        conditions checked there, so this only ever runs where the hidden state
        exists. Each element is revealed once and then left alone.
      */
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains("reveal-ready")) return;
        var items = document.querySelectorAll("[data-reveal]");
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.06 },
        );
        items.forEach(function (item) {
          observer.observe(item);
        });
      })();

      /*
        Two pointer- and scroll-driven effects, both decoration:
        - the spotlight: a card marked `.spotlight` is told where the pointer
          is, and its own CSS draws the pool of light there;
        - the showcase tilt: `[data-scroll-tilt]` starts leaning back and
          stands up as it scrolls into view.
        Neither runs for a visitor who has asked for reduced motion.
      */
      (function () {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        document.addEventListener(
          "pointermove",
          function (event) {
            var card = event.target.closest && event.target.closest(".spotlight");
            if (!card) return;
            var box = card.getBoundingClientRect();
            card.style.setProperty("--mx", event.clientX - box.left + "px");
            card.style.setProperty("--my", event.clientY - box.top + "px");
          },
          { passive: true },
        );

        var board = document.querySelector("[data-scroll-tilt]");
        if (!board) return;
        var queued = false;
        var tilt = function () {
          queued = false;
          var box = board.parentElement.getBoundingClientRect();
          var view = window.innerHeight;
          var progress = Math.min(Math.max((view - box.top) / (view * 0.75), 0), 1);
          board.style.transform =
            "perspective(1600px) rotateX(" +
            (26 * (1 - progress)).toFixed(2) +
            "deg) scale(" +
            (0.88 + 0.12 * progress).toFixed(3) +
            ")";
        };
        var schedule = function () {
          if (queued) return;
          queued = true;
          requestAnimationFrame(tilt);
        };
        tilt();
        window.addEventListener("scroll", schedule, { passive: true });
        window.addEventListener("resize", schedule, { passive: true });
      })();
    </script>
  </body>
</html>
