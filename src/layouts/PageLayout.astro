---
/**
 * Page shell on BaseLayout for core, legal, pillar, article, and tool pages:
 * breadcrumbs, eyebrow, heading, optional standfirst, optional legal-draft
 * notice, and a prose body.
 *
 * Slots: default (prose body), "meta" (end of the header, e.g. the byline),
 * "hero" (below the header), "after" (below the prose), "sidebar" (the
 * contextual rail: table of contents and category navigation).
 *
 * With no "sidebar" slot the page is a single measured column. Fill that slot
 * and the page widens at `lg` into a two-column grid — the same measured
 * column, plus the rail on the right. Below `lg` the rail sits above the prose
 * (its parts collapse into accordions; see TableOfContents and ContentSidebar)
 * and the column width is unchanged, so nothing is pushed off-screen and body
 * copy keeps the same measure at every width.
 *
 * The visible breadcrumb trail is rendered here rather than in BaseLayout so it
 * lines up with this page's measured column. The matching BreadcrumbList schema
 * is emitted by BaseLayout from the same getBreadcrumbs() call.
 */
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import PillarIcon from "@/components/layout/PillarIcon.astro";
import type { PillarIconId } from "@/config/pillars";
import ContentGap from "@/components/content/ContentGap.astro";
import type { OpenGraphArticle } from "@/components/seo/SeoHead.astro";
import { getPage, type PageId } from "@/config/pages";
import { getBreadcrumbs, type JsonLd } from "@/lib/seo";

interface Props {
  pageId: PageId;
  /**
   * The page's own SEO title, where it is not declared in the snippet registry
   * (src/config/seo-snippets.ts). Content entries pass their frontmatter title
   * here; the registry overrides it for the <title> and leaves the visible page
   * untouched.
   */
  title?: string;
  /** The page's own meta description, same. Never the visible intro — that is `intro`. */
  description?: string;
  /** Visible <h1>; defaults to `title`, then to the registry page title. */
  heading?: string;
  /** Small uppercase label above the <h1>, e.g. the parent category. */
  eyebrow?: string;
  /** Makes the eyebrow a link, e.g. a category label pointing at its hub. */
  eyebrowHref?: string;
  /** Teal eyebrow, for the free interactive tools. */
  eyebrowAccent?: boolean;
  /** Category glyph above the eyebrow. Pillar hubs only. */
  icon?: PillarIconId;
  intro?: string;
  /** Legal pages: shows the draft notice and effective-date placeholder. */
  legalDraft?: boolean;
  ogType?: "website" | "article";
  /** Article-only Open Graph tags, for `ogType: "article"` pages. */
  article?: OpenGraphArticle;
  jsonLd?: readonly JsonLd[];
}

const {
  pageId,
  title,
  description,
  heading,
  eyebrow,
  eyebrowHref,
  eyebrowAccent = false,
  icon,
  intro,
  legalDraft = false,
  ogType,
  article: openGraphArticle,
  jsonLd,
} = Astro.props;

const hasSidebar = Astro.slots.has("sidebar");
const page = getPage(pageId);
const breadcrumbs = getBreadcrumbs(page);

/**
 * The visible heading: an explicit `heading`, else the page's own title, else
 * the registry title. The last fallback is what lets a page leave its metadata
 * entirely to the snippet registry and still render an <h1>.
 */
const pageHeading = heading ?? title ?? page.title;
---

<BaseLayout
  pageId={pageId}
  title={title}
  description={description}
  ogType={ogType}
  article={openGraphArticle}
  jsonLd={jsonLd}
>
  <article
    class:list={[
      "mx-auto max-w-3xl px-4 pb-16 sm:px-6 sm:pb-24",
      // Only the grid row widens; the prose column keeps its measure.
      hasSidebar && "lg:max-w-6xl",
    ]}
  >
    <header class:list={["pt-6 pb-8 sm:pt-8 sm:pb-10", hasSidebar && "lg:max-w-3xl"]}>
      <Breadcrumbs items={breadcrumbs} class="mb-6" />

      {icon && (
        <span class="mb-5 flex size-12 items-center justify-center rounded-xl border border-ink-200 bg-surface text-brand-700 shadow-card">
          <PillarIcon icon={icon} class="size-6" />
        </span>
      )}

      {eyebrow && (
        <p class:list={["eyebrow", eyebrowAccent && "eyebrow-accent"]}>
          {eyebrowHref ? (
            <a
              href={eyebrowHref}
              class="-my-1 inline-block py-1 transition-colors duration-180 ease-ui hover:text-ink-900 motion-reduce:transition-none"
            >
              {eyebrow}
            </a>
          ) : (
            eyebrow
          )}
        </p>
      )}

      <h1 class:list={["type-title", eyebrow && "mt-3"]}>{pageHeading}</h1>

      {intro && <p class="type-lead mt-5">{intro}</p>}

      {legalDraft && (
        <>
          <div
            role="note"
            data-content-gap
            class="callout mt-7 border-yellow-300 bg-yellow-50 text-sm text-yellow-900"
          >
            <p class="font-semibold">Draft template — not final</p>
            <p class="mt-1">
              This page is a draft and requires final legal review before launch. It is not legal
              advice.
            </p>
          </div>
          <p class="mt-4 text-sm text-ink-500">
            Effective date: <ContentGap label="Effective date" />
          </p>
        </>
      )}

      {Astro.slots.has("meta") && (
        <div class="mt-8 space-y-4 border-t border-ink-200 pt-6">
          <slot name="meta" />
        </div>
      )}
    </header>

    <slot name="hero" />

    <div
      class:list={[
        hasSidebar && "lg:grid lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-start lg:gap-x-12",
      ]}
    >
      {hasSidebar && (
        <aside class="mb-8 space-y-3 lg:sticky lg:top-24 lg:order-2 lg:mb-0 lg:max-h-[calc(100vh-7.5rem)] lg:space-y-7 lg:overflow-y-auto lg:overscroll-contain lg:border-l lg:border-ink-200 lg:pl-7">
          <slot name="sidebar" />
        </aside>
      )}

      <div class:list={["min-w-0", hasSidebar && "lg:order-1 lg:max-w-3xl"]}>
        <div class="prose max-w-none">
          <slot />
        </div>

        <slot name="after" />
      </div>
    </div>
  </article>
</BaseLayout>
