---
/**
 * Page shell on BaseLayout for core, legal, pillar, and article pages:
 * eyebrow, heading, optional intro, optional legal-draft notice, and a prose body.
 * Slots: default (prose body), "meta" (end of the header), "hero" (below the
 * header), "after" (below the prose), "sidebar" (contextual navigation).
 *
 * With no "sidebar" slot the page is a single measured column, exactly as
 * before. Fill that slot and the page widens at `lg` into a two-column grid —
 * the same measured column, plus contextual navigation on the right. Below `lg`
 * the sidebar sits above the prose (as a collapsed accordion, see
 * ContentSidebar) and the column width is unchanged, so nothing is pushed
 * off-screen and body copy keeps the same measure at every width.
 */
import BaseLayout from "./BaseLayout.astro";
import ContentGap from "@/components/content/ContentGap.astro";
import type { OpenGraphArticle } from "@/components/seo/SeoHead.astro";
import type { PageId } from "@/config/pages";
import type { JsonLd } from "@/lib/seo";

interface Props {
  pageId: PageId;
  title: string;
  description: string;
  /** Visible <h1>; defaults to `title`. */
  heading?: string;
  /** Small uppercase label above the <h1>, e.g. the parent category. */
  eyebrow?: string;
  intro?: string;
  /** Legal pages: shows the draft notice and effective-date placeholder. */
  legalDraft?: boolean;
  ogType?: "website" | "article";
  /** Article-only Open Graph tags, for `ogType: "article"` pages. */
  article?: OpenGraphArticle;
  jsonLd?: readonly JsonLd[];
}

const {
  pageId,
  title,
  description,
  heading = title,
  eyebrow,
  intro,
  legalDraft = false,
  ogType,
  article: openGraphArticle,
  jsonLd,
} = Astro.props;

const hasSidebar = Astro.slots.has("sidebar");
---

<BaseLayout
  pageId={pageId}
  title={title}
  description={description}
  ogType={ogType}
  article={openGraphArticle}
  jsonLd={jsonLd}
>
  <article
    class:list={[
      "mx-auto max-w-3xl px-4 pb-16 sm:px-6 sm:pb-20",
      // Only the grid row widens; the prose column keeps its measure.
      hasSidebar && "lg:max-w-6xl",
    ]}
  >
    <header class:list={["pt-8 pb-8 sm:pt-12 sm:pb-10", hasSidebar && "lg:max-w-3xl"]}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1
        class:list={[
          "text-3xl font-extrabold tracking-display text-balance text-ink-900 sm:text-[2.75rem] sm:leading-[1.1]",
          eyebrow && "mt-3",
        ]}
      >
        {heading}
      </h1>
      {intro && (
        <p class="mt-5 text-lg leading-relaxed text-pretty text-ink-600 sm:text-xl">{intro}</p>
      )}

      {legalDraft && (
        <>
          <div
            role="note"
            data-content-gap
            class="callout mt-7 border-yellow-300 bg-yellow-50 text-sm text-yellow-900"
          >
            <p class="font-semibold">Draft template — not final</p>
            <p class="mt-1">
              This page is a draft and requires final legal review before launch. It is not legal
              advice.
            </p>
          </div>
          <p class="mt-4 text-sm text-ink-500">
            Effective date: <ContentGap label="Effective date" />
          </p>
        </>
      )}

      {Astro.slots.has("meta") && (
        <div class="mt-8 space-y-3 border-t border-ink-200 pt-6">
          <slot name="meta" />
        </div>
      )}
    </header>

    <slot name="hero" />

    <div
      class:list={[
        hasSidebar && "lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start lg:gap-12",
      ]}
    >
      {hasSidebar && (
        <aside class="mb-8 lg:sticky lg:top-20 lg:order-2 lg:mb-0">
          <slot name="sidebar" />
        </aside>
      )}

      <div class:list={["min-w-0", hasSidebar && "lg:order-1 lg:max-w-3xl"]}>
        <div class="prose max-w-none">
          <slot />
        </div>

        <slot name="after" />
      </div>
    </div>
  </article>
</BaseLayout>
