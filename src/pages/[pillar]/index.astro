---
/**
 * Pillar hubs from the `pillars` collection; paths come from the page registry.
 *
 * A hub gets the category treatment: its glyph above the heading, its own MDX
 * body, and then every published guide in the category as cards rather than the
 * compact list a cluster page uses — the hub's job is to send a visitor into
 * the right guide.
 */
import { render } from "astro:content";
import EntryLayout from "@/layouts/EntryLayout.astro";
import CategoryGuides from "@/components/content/CategoryGuides.astro";
import { MDX_COMPONENTS } from "@/components/content/mdx";
import { getPublishedEntries, pathSegments, toArticleCard } from "@/lib/content";
import { isMediaId } from "@/config/media";
import { getPillarPresentation } from "@/config/pillars";
import type { PillarId } from "@/config/pages";
import { collectionPageSchema } from "@/lib/seo";

export async function getStaticPaths() {
  const [pillars, articles] = await Promise.all([
    getPublishedEntries("pillars"),
    getPublishedEntries("articles"),
  ]);

  /** Pillar id → its hub title, so a guide card's kicker matches the hub's <h1>. */
  const categoryTitles = new Map(pillars.map(({ entry, page }) => [page.id, entry.data.title]));

  return pillars.map(({ entry, page }) => {
    const [pillar] = pathSegments(page);
    const inCategory = articles.filter((article) => article.page.pillar === page.id);

    return {
      params: { pillar },
      props: {
        entry,
        mediaId: isMediaId(page.id) ? page.id : undefined,
        icon: getPillarPresentation(page.id as PillarId).icon,
        /** Cards for the hub's own guide grid. */
        guides: inCategory.map((article) => toArticleCard(article, categoryTitles)),
        /** The same guides as plain links, for the CollectionPage ItemList. */
        articles: inCategory.map(({ entry: article, page: articlePage }) => ({
          title: article.data.title,
          path: articlePage.path,
          description: article.data.description,
        })),
      },
    };
  });
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]["props"];

const { entry, articles, guides, mediaId, icon } = Astro.props;
const { Content, headings } = await render(entry);
const path = Astro.url.pathname;
---

<EntryLayout
  entry={entry}
  eyebrow="Category"
  icon={icon}
  headings={headings}
  mediaId={mediaId}
  ogType="website"
  jsonLd={[
    collectionPageSchema(
      { name: entry.data.title, description: entry.data.description, path },
      articles.map((article) => ({ label: article.title, path: article.path })),
    ),
  ]}
  relatedHeading={`${entry.data.title} guides`}
  related={articles}
>
  {/* Shared element overrides: link policy, heading anchors, table scrolling. */}
  <Content components={MDX_COMPONENTS} />

  <Fragment slot="related">
    <CategoryGuides id="category-guides" heading={`${entry.data.title} guides`} guides={guides} />
  </Fragment>
</EntryLayout>
