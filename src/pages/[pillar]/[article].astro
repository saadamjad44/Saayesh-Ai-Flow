---
/** Cluster articles from the `articles` collection, nested under their pillar. */
import { render } from "astro:content";
import EntryLayout from "@/layouts/EntryLayout.astro";
import { getPublishedEntries, pathSegments } from "@/lib/content";
import { getPage } from "@/config/pages";
import { articleSchema, getSocialImage } from "@/lib/seo";

export async function getStaticPaths() {
  const [pillars, articles] = await Promise.all([
    getPublishedEntries("pillars"),
    getPublishedEntries("articles"),
  ]);

  return articles.map(({ entry, page }) => {
    const parent = pillars.find((pillar) => pillar.page.id === page.pillar);
    if (!parent) {
      throw new Error(`Article "${page.id}" needs its pillar "${page.pillar}" to be published`);
    }

    const siblings = articles
      .filter((article) => article.page.pillar === page.pillar && article.page.id !== page.id)
      .map(({ entry: sibling, page: siblingPage }) => ({
        title: sibling.data.title,
        path: siblingPage.path,
        description: sibling.data.description,
        kicker: "In this category",
      }));

    const [pillar, article] = pathSegments(page);
    return {
      params: { pillar, article },
      props: {
        entry,
        /** Category label above the <h1>, from the parent pillar. */
        eyebrow: parent.entry.data.title,
        related: [
          {
            title: parent.entry.data.title,
            path: parent.page.path,
            description: parent.entry.data.description,
            kicker: "Category hub",
          },
          ...siblings,
        ],
      },
    };
  });
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]["props"];

const { entry, related, eyebrow } = Astro.props;
const { Content } = await render(entry);
// Same image the page shares socially, so the Article schema can't drift from it.
const socialImage = await getSocialImage(getPage(entry.data.pageId));
---

<EntryLayout
  entry={entry}
  eyebrow={eyebrow}
  ogType="article"
  jsonLd={[
    articleSchema({
      headline: entry.data.title,
      description: entry.data.description,
      path: Astro.url.pathname,
      datePublished: entry.data.publishedDate,
      dateModified: entry.data.updatedDate,
      image: socialImage.url,
    }),
  ]}
  relatedHeading="Keep reading"
  related={related}
>
  <Content />
</EntryLayout>
