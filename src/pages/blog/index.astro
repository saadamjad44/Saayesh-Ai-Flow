---
/**
 * /blog/ — the central index of every published guide.
 *
 * Generated entirely from the page registry and the MDX collections: there is
 * no second list of articles to maintain, and adding an article to
 * src/config/pages.ts with its entry file puts it here automatically.
 *
 * This page only links to existing URLs. Articles keep living under their
 * pillar (/[pillar]/[article]/) — nothing is moved, duplicated, or re-canonicalized.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PILLAR_NAV } from "@/config/navigation";
import { getPage } from "@/config/pages";
import { getPublishedEntries } from "@/lib/content";
import { formatDate, isoDate } from "@/lib/format";
import { collectionPageSchema } from "@/lib/seo";

const page = getPage("blog");

const [pillars, articles] = await Promise.all([
  getPublishedEntries("pillars"),
  getPublishedEntries("articles"),
]);

/** Pillar id → its hub title, for the category label on each article row. */
const pillarTitles = new Map(pillars.map(({ entry, page: hub }) => [hub.id, entry.data.title]));

/** Newest first; a stable id tiebreak keeps the order deterministic. */
const chronological = [...articles].sort((a, b) => {
  const delta = b.entry.data.publishedDate.getTime() - a.entry.data.publishedDate.getTime();
  return delta !== 0 ? delta : a.page.id.localeCompare(b.page.id);
});

/** Only categories that actually have a published hub page. */
const categories = PILLAR_NAV.filter((section) => pillarTitles.has(section.pillar)).map(
  (section) => ({
    ...section,
    title: pillarTitles.get(section.pillar) ?? section.label,
    count: articles.filter(({ page: article }) => article.pillar === section.pillar).length,
  }),
);

const description =
  "Every published guide on Saayesh AI Flow, newest first: AI writing tools, " +
  "business and productivity tools, automation workflows, prompts, and beginner guides.";
---

<BaseLayout
  pageId="blog"
  title="Blog: AI Tool Guides, Prompts & Automation Workflows"
  description={description}
  jsonLd={[
    collectionPageSchema(
      { name: "Blog", description, path: page.path },
      chronological.map(({ entry, page: article }) => ({
        label: entry.data.title,
        path: article.path,
      })),
    ),
  ]}
>
  <div class="mx-auto max-w-5xl px-4 pb-16 sm:px-6 sm:pb-20">
    <header class="pt-8 pb-8 sm:pt-12 sm:pb-10">
      <p class="eyebrow">All guides</p>
      <h1 class="mt-3 text-3xl font-extrabold tracking-display text-balance text-ink-900 sm:text-[2.75rem] sm:leading-[1.1]">
        Blog
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-ink-600 sm:text-xl">
        {description}
      </p>
    </header>

    <section aria-labelledby="blog-categories" class="border-t border-ink-200 pt-10">
      <h2 id="blog-categories" class="text-xl font-bold tracking-display text-ink-900 sm:text-2xl">
        Browse by category
      </h2>
      <ul class="mt-5 flex flex-wrap gap-2.5">
        {categories.map((category) => (
          <li>
            <a
              href={category.href}
              class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-surface px-4 py-2 text-sm font-medium text-ink-700 shadow-card hover:border-brand-300 hover:text-brand-700"
            >
              {category.title}
              <span class="text-xs text-ink-500">{category.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="blog-articles" class="mt-12 border-t border-ink-200 pt-10">
      <h2 id="blog-articles" class="text-xl font-bold tracking-display text-ink-900 sm:text-2xl">
        All articles
      </h2>
      <p class="mt-2 text-sm text-ink-500">
        {chronological.length} published guides, newest first.
      </p>

      <ul class="mt-7 space-y-4">
        {chronological.map(({ entry, page: article }) => {
          const pillarPath = article.pillar ? getPage(article.pillar).path : undefined;
          return (
            <li class="card card-link group relative flex flex-col p-5 sm:p-6">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                {article.pillar && (
                  <span class="font-bold tracking-[0.08em] text-accent-600 uppercase">
                    {pillarTitles.get(article.pillar)}
                  </span>
                )}
                <time datetime={isoDate(entry.data.publishedDate)} class="text-ink-500">
                  {formatDate(entry.data.publishedDate)}
                </time>
              </div>

              <h3 class="mt-2 text-lg font-bold tracking-display text-ink-900">
                <a
                  href={article.path}
                  class="after:absolute after:inset-0 group-hover:text-brand-700"
                >
                  {entry.data.title}
                </a>
              </h3>

              <p class="mt-2 leading-relaxed text-ink-600">{entry.data.description}</p>

              {pillarPath && (
                <p class="relative z-10 mt-4 text-sm text-ink-500">
                  In{" "}
                  <a
                    href={pillarPath}
                    class="font-medium text-brand-700 underline hover:text-brand-800"
                  >
                    {pillarTitles.get(article.pillar ?? "")}
                  </a>
                </p>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  </div>
</BaseLayout>
