---
/**
 * /blog/ — the editorial library: every published guide, newest first, with a
 * lead card, a category filter row, and a free-tools strip.
 *
 * Generated entirely from the page registry and the MDX collections: there is
 * no second list of articles to maintain, and adding an article to
 * src/config/pages.ts with its entry file puts it here automatically.
 *
 * This page only links to existing URLs. Articles keep living under their
 * pillar (/[pillar]/[article]/) — nothing is moved, duplicated, or
 * re-canonicalized, and the category chips link to the pillar hubs rather than
 * to filtered copies of this archive, so no new indexable page is created.
 */
import ArticleCard from "@/components/content/ArticleCard.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import PillarIcon from "@/components/layout/PillarIcon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PILLAR_NAV } from "@/config/navigation";
import { getPage } from "@/config/pages";
import { getPillarPresentation } from "@/config/pillars";
import { getPublishedEntries, toArticleCard } from "@/lib/content";
import { collectionPageSchema, getBreadcrumbs } from "@/lib/seo";

const page = getPage("blog");

const [pillars, articles, tools] = await Promise.all([
  getPublishedEntries("pillars"),
  getPublishedEntries("articles"),
  getPublishedEntries("tools"),
]);

/** Pillar id → its hub title, for the category label on each card. */
const categoryTitles = new Map(pillars.map(({ entry, page: hub }) => [hub.id, entry.data.title]));

/** Newest first; a stable id tiebreak keeps the order deterministic. */
const chronological = [...articles].sort((a, b) => {
  const delta = b.entry.data.publishedDate.getTime() - a.entry.data.publishedDate.getTime();
  return delta !== 0 ? delta : a.page.id.localeCompare(b.page.id);
});

const cards = chronological.map((article) => toArticleCard(article, categoryTitles));
const [lead, ...rest] = cards;

/** Only categories that actually have a published hub page. */
const categories = PILLAR_NAV.filter((section) => categoryTitles.has(section.pillar)).map(
  (section) => ({
    title: categoryTitles.get(section.pillar) ?? section.label,
    href: section.href,
    icon: getPillarPresentation(section.pillar).icon,
    count: articles.filter(({ page: article }) => article.pillar === section.pillar).length,
  }),
);

const toolLinks = tools.map(({ entry, page: tool }) => ({
  href: tool.path,
  title: entry.data.title,
  description: entry.data.description,
}));

const description =
  "Every published guide on Saayesh AI Flow, newest first: AI writing tools, " +
  "business and productivity tools, automation workflows, prompts, and beginner guides.";

const breadcrumbs = getBreadcrumbs(page);
---

<BaseLayout
  pageId="blog"
  title="Blog: AI Tool Guides, Prompts & Automation Workflows"
  description={description}
  jsonLd={[
    collectionPageSchema(
      { name: "Blog", description, path: page.path },
      chronological.map(({ entry, page: article }) => ({
        label: entry.data.title,
        path: article.path,
      })),
    ),
  ]}
>
  <div class="border-b border-ink-200 bg-surface">
    <div class="mx-auto max-w-6xl px-4 pt-6 pb-12 sm:px-6 sm:pb-14">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />

      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-rule">The library</p>
        <h1 class="type-title mt-3">Every guide we publish</h1>
        <p class="type-lead mt-5">{description}</p>
        <p class="mt-5 font-mono text-xs tracking-[0.06em] text-ink-500 uppercase">
          {cards.length} guides &middot; {categories.length} categories
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    {/* ---- Category row --------------------------------------------- */}
    <section aria-labelledby="blog-categories" class="py-10 sm:py-12">
      <h2 id="blog-categories" class="eyebrow">
        Browse by category
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2.5">
        {categories.map((category) => (
          <li>
            <a href={category.href} class="chip">
              <PillarIcon icon={category.icon} class="size-4 text-brand-700" />
              {category.title}
              <span class="chip-count">{category.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {/* ---- Newest guide ---------------------------------------------- */}
    {lead && (
      <section aria-labelledby="blog-latest" class="border-t border-ink-200 pt-10 sm:pt-12">
        <h2 id="blog-latest" class="eyebrow eyebrow-rule">
          Latest guide
        </h2>
        <div class="mt-5">
          <ArticleCard
            article={lead}
            variant="lead"
            as="h3"
            priority
            sizes="(min-width: 1024px) 72rem, 92vw"
          />
        </div>
      </section>
    )}

    {/* ---- Everything else -------------------------------------------- */}
    {rest.length > 0 && (
      <section aria-labelledby="blog-articles" class="mt-12 border-t border-ink-200 pt-10 sm:mt-14">
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
          <h2 id="blog-articles" class="type-section">
            All guides
          </h2>
          <p class="font-mono text-xs tracking-[0.06em] text-ink-500 uppercase">Newest first</p>
        </div>

        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {rest.map((article) => (
            <li class="flex">
              <ArticleCard article={article} as="h3" class="w-full" />
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ---- Free tools -------------------------------------------------- */}
    {toolLinks.length > 0 && (
      <section aria-labelledby="blog-tools" class="mt-12 border-t border-ink-200 pt-10 sm:mt-14">
        <h2 id="blog-tools" class="eyebrow eyebrow-accent eyebrow-rule">
          Free tools
        </h2>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {toolLinks.map((tool) => (
            <li class="card card-link group relative flex flex-col border-accent-200/70 p-5 sm:p-6">
              <h3 class="type-card-title">
                <a href={tool.href} class="stretch-target group-hover:text-accent-800">
                  {tool.title}
                </a>
              </h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-600">{tool.description}</p>
              <span
                aria-hidden="true"
                class="mt-4 inline-flex items-center gap-1.5 font-display text-sm font-bold text-accent-700"
              >
                Open the tool
                <svg
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="size-4 transition-transform duration-180 ease-ui group-hover:translate-x-0.5 motion-reduce:transition-none"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
