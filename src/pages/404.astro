---
// Custom 404. Astro emits dist/404.html, which Netlify serves for unknown URLs.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PRIMARY_NAV } from "@/config/navigation";
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for doesn't exist or may have moved."
>
  <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="eyebrow">404 error</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-display text-ink-900 sm:text-5xl">
      Page not found
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-600">
      The page you were looking for doesn't exist or may have moved. Check the URL, or start from
      one of the sections below.
    </p>

    <nav aria-label="Suggested pages" class="mt-10">
      <ul class="grid gap-3 sm:grid-cols-2">
        {[{ label: "Homepage", href: "/" }, ...PRIMARY_NAV].map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="card card-link flex min-h-11 items-center justify-between gap-3 px-4 py-3.5 font-semibold text-ink-900 hover:text-brand-700"
            >
              {label}
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="size-4 shrink-0 text-ink-400"
              >
                <path
                  fill-rule="evenodd"
                  d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
