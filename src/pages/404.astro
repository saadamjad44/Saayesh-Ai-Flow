---
/**
 * Custom 404. Astro emits dist/404.html, which the host serves for unknown URLs.
 *
 * The suggestions are the six categories plus the archive and the homepage —
 * built from the registry and the published collections, so this page can never
 * offer a route that does not exist.
 */
import PillarIcon from "@/components/layout/PillarIcon.astro";
import SearchBox from "@/components/layout/SearchBox.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FALLBACK_NAV, PILLAR_NAV } from "@/config/navigation";
import { getPage } from "@/config/pages";
import { getPillarPresentation } from "@/config/pillars";
import { getPublishedEntries } from "@/lib/content";

const pillars = await getPublishedEntries("pillars");
const titles = new Map(pillars.map(({ entry, page }) => [page.id, entry.data.title]));

const categories = PILLAR_NAV.filter((entry) => titles.has(entry.pillar)).map((entry) => {
  const page = getPage(entry.pillar);
  return {
    title: titles.get(page.id) ?? page.title,
    href: page.path,
    icon: getPillarPresentation(entry.pillar).icon,
  };
});
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for doesn't exist or may have moved."
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="eyebrow eyebrow-rule">404 error</p>
    <h1 class="type-title mt-4">Page not found</h1>
    <p class="type-lead mt-5">
      The page you were looking for doesn't exist or may have moved. Search for it, or start from
      one of the sections below.
    </p>

    <div class="mt-8">
      <SearchBox
        id="notfound"
        variant="hero"
        label="Search guides, tools and prompts"
        placeholder="Search guides, tools and prompts..."
      />
    </div>

    <nav aria-label="Categories" class="mt-12">
      <h2 class="eyebrow">Browse a category</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {categories.map((category) => (
          <li>
            <a
              href={category.href}
              class="card card-link group flex min-h-14 items-center gap-3.5 px-4 py-3"
            >
              <span class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-ink-200 bg-paper text-brand-700 transition-colors duration-180 ease-ui group-hover:border-brand-200 group-hover:bg-brand-50 motion-reduce:transition-none">
                <PillarIcon icon={category.icon} class="size-5" />
              </span>
              <span class="font-sans font-bold text-ink-900 group-hover:text-brand-800">
                {category.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Other pages" class="mt-8 border-t border-ink-200 pt-6">
      <ul class="flex flex-wrap gap-2.5">
        {FALLBACK_NAV.map(({ label, href }) => (
          <li>
            <a href={href} class="chip">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
