---
// Custom 404. Astro emits dist/404.html, which Netlify serves for unknown URLs.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PRIMARY_NAV } from "@/config/navigation";
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for doesn't exist or may have moved."
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="text-sm font-semibold tracking-wide text-indigo-700 uppercase">404 error</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mt-4 text-lg text-slate-600">
      The page you were looking for doesn't exist or may have moved. Check the URL, or start from
      one of the sections below.
    </p>

    <nav aria-label="Suggested pages" class="mt-8">
      <ul class="grid gap-3 sm:grid-cols-2">
        <li>
          <a
            href="/"
            class="block rounded-lg border border-slate-200 px-4 py-3 font-medium hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700"
          >
            Homepage
          </a>
        </li>
        {PRIMARY_NAV.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="block rounded-lg border border-slate-200 px-4 py-3 font-medium hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
