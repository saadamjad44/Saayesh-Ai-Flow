<style>
  /*
   * The hero background.
   *
   * The artwork is composed with its subject on the right and open sky on the
   * left, so the copy sits in the empty half and the picture is never asked to
   * carry text on its busy side. The scrim is the part that guarantees it: an
   * opaque wash of the surface colour under the copy, fading out before the
   * subject, so the headline keeps full ink-on-surface contrast no matter how
   * the image crops at a given viewport.
   */
  .hero-art {
    /*
     * A narrow viewport crops this hard horizontally — roughly a sixth of the
     * picture survives — so hold the subject rather than the empty sky, or the
     * hero is a blank wash on a phone.
     */
    object-position: 68% 50%;
  }

  /*
   * Phones have no empty column to put the copy in, so the wash covers the
   * whole frame: heaviest under the headline, easing off down the page where
   * only buttons sit, which lets the artwork read without ever costing the
   * text its contrast.
   */
  .hero-scrim {
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--color-surface) 93%, transparent) 0%,
      color-mix(in oklab, var(--color-surface) 88%, transparent) 55%,
      color-mix(in oklab, var(--color-surface) 62%, transparent) 100%
    );
  }

  @media (min-width: 1024px) {
    .hero-art {
      /* Wide boxes crop vertically only, so centre is the whole composition. */
      object-position: 50% 50%;
    }

    .hero-scrim {
      background: linear-gradient(
        to right,
        var(--color-surface) 0%,
        color-mix(in oklab, var(--color-surface) 90%, transparent) 32%,
        color-mix(in oklab, var(--color-surface) 45%, transparent) 54%,
        transparent 72%
      );
    }
  }
</style>

<script>
  /**
   * The homepage's only analytics listener: a call to action that declares an
   * event name gets one, and nothing else on the page is instrumented.
   *
   * What is sent is that the click happened, and where. Never a value — the
   * calculators' own figures are not touched here and must never be; see the
   * contract in src/lib/analytics.ts. The presentation viewer tracks its own
   * two events in its own script, so nothing below fires twice.
   */
  import { trackEvent, type AnalyticsEventName } from "@/lib/analytics";

  for (const element of document.querySelectorAll<HTMLElement>("[data-analytics-event]")) {
    const name = element.dataset.analyticsEvent as AnalyticsEventName | undefined;
    if (!name) continue;
    element.addEventListener("click", () => trackEvent(name, { location: "homepage" }));
  }
</script>
