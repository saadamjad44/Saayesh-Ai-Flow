<style>
  /*
   * The hero background.
   *
   * Nothing dark goes over the artwork. It runs at full strength and the only
   * layer between it and the copy is a flat white veil at 76%.
   *
   * Flat, rather than a wash shaped around the copy, because the copy is
   * centred and the crop moves: between a phone and a wide monitor the box
   * goes from taller-than-square to nearly 2:1, and any part of the picture
   * can end up under any line of the masthead. A veil that is only strong
   * where the text sits today is a veil that fails at some width nobody
   * checked. One value that holds everywhere cannot.
   *
   * 76% is set by the darkest pixel in the picture — #001536, in the core of
   * the brain. Under the veil that composites to #c2c7cf, which gives 10.9:1
   * to the ink-900 headline and figures, 6.8:1 to the ink-700 lead, 5.3:1 to
   * the iris kicker, and 4.8:1 to the ink-600 colophon labels. Those labels
   * are the smallest type on the section and the floor for the whole
   * arrangement: thinning the veil drops them below AA, so the picture cannot
   * be brought up without darkening them in the same move.
   *
   * The second gradient closes the foot of the section into the warm paper
   * below it, so the picture does not stop dead against the next section.
   */
  .hero-art {
    object-position: 60% 42%;
  }

  .hero-veil {
    /* The colour is the veil; the gradient paints over it, which is the order
       the foot of the section needs — paper on top of the wash, not under. */
    background-color: rgb(255 255 255 / 0.76);
    background-image: linear-gradient(to top, var(--color-paper) 0%, transparent 22%);
  }

  /*
   * The grid is texture under the copy, and it has no business over the
   * subject. Its mask fades out over a long run: a short ramp reads as an
   * edge, a long one as depth.
   */
  .hero-grid {
    mask-image: radial-gradient(120% 105% at 50% 44%, #000 0%, #000 48%, transparent 86%);
  }

  @media (min-width: 1024px) {
    /*
     * A floor, not a fixed height: the copy sets the height whenever it needs
     * more, and the vh term keeps the masthead off a full screen on a large
     * monitor. Below `lg` the section is as tall as its copy, which on a phone
     * crops the artwork to a strip through the middle of the picture — hence
     * the object-position above, which holds the head and the top of the
     * network rather than the empty sky beside them.
     */
    .hero {
      min-height: min(52vw, 84vh);
    }

    /*
     * From `lg` up the box is close enough to the master's own 1672x941 that
     * centring it trims only a little off the top and bottom, and the copy now
     * sits over the subject rather than beside it, so there is no empty column
     * left to protect.
     */
    .hero-art {
      object-position: center;
    }
  }
</style>

<script>
  /**
   * The homepage's only analytics listener: a call to action that declares an
   * event name gets one, and nothing else on the page is instrumented.
   *
   * What is sent is that the click happened, and where. Never a value — the
   * calculators' own figures are not touched here and must never be; see the
   * contract in src/lib/analytics.ts. The presentation viewer tracks its own
   * two events in its own script, so nothing below fires twice.
   */
  import { trackEvent, type AnalyticsEventName } from "@/lib/analytics";

  for (const element of document.querySelectorAll<HTMLElement>("[data-analytics-event]")) {
    const name = element.dataset.analyticsEvent as AnalyticsEventName | undefined;
    if (!name) continue;
    element.addEventListener("click", () => trackEvent(name, { location: "homepage" }));
  }

  /**
   * The colophon counters.
   *
   * Each figure is rendered at its final value by the build, so it is already
   * right for a crawler and for a visitor with scripting off. This only
   * decorates it: the counter reads the number the build wrote, runs up to it
   * from zero whenever the row scrolls into view, and lands on exactly the
   * text it started with. The observer is never disconnected, so scrolling
   * away and back runs it again; the width each figure occupies is reserved in
   * the markup, so a count that passes 9 cannot reflow the row.
   *
   * Anyone who has asked for reduced motion is left with the rendered numbers.
   */
  const COUNT_MS = 1100;
  const COUNT_THRESHOLD = 0.6;

  const counters = document.querySelectorAll<HTMLElement>("[data-count-to]");

  if (counters.length > 0 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    /* Fast first, easing out — a count that decelerates into its final value
       reads as arriving somewhere rather than as a stopwatch. */
    const easeOut = (progress: number) => 1 - Math.pow(1 - progress, 3);

    /* One pending frame per element, so a re-entry replaces its own run
       instead of racing it. */
    const frames = new WeakMap<HTMLElement, number>();

    const count = (element: HTMLElement) => {
      const target = Number(element.dataset.countTo);
      if (!Number.isFinite(target)) return;

      const pending = frames.get(element);
      if (pending !== undefined) cancelAnimationFrame(pending);

      const started = performance.now();
      element.textContent = "0";

      const step = (now: number) => {
        const progress = Math.min((now - started) / COUNT_MS, 1);
        element.textContent = String(Math.round(target * easeOut(progress)));
        if (progress < 1) frames.set(element, requestAnimationFrame(step));
        else frames.delete(element);
      };

      frames.set(element, requestAnimationFrame(step));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) count(entry.target as HTMLElement);
        }
      },
      { threshold: COUNT_THRESHOLD },
    );

    for (const counter of counters) observer.observe(counter);
  }
</script>
