---
/**
 * Homepage.
 *
 * Eight sections, in the order a visitor needs them: a centred masthead that
 * says what this site is and gives a way to search it, the categories, a short
 * editorial selection of guides, four routes in for someone who does not know
 * which category they want, both free calculators, an eight-slide introduction
 * to the site, the newest guides, and how the site works.
 *
 * Nothing on this page is hand-listed. The categories come from PILLAR_NAV
 * filtered to published pillars; the featured and "start here" selections are
 * editor's picks in src/config/homepage.ts, typed to the registry so an
 * unpublished pick fails the build; the latest row is the collections sorted by
 * date; the tool panels are rendered from TOOL_PROMOS; and each calculator
 * preview is produced by that calculator's own function at build time, so the
 * figures shown cannot be arithmetic the real tool would not do.
 *
 * The one set of figures on the page — the colophon under the hero headline —
 * is counted from the published collections at build time for the same reason.
 *
 * Deliberately absent: visitor counts, "most popular" claims, review scores,
 * testimonials, partner logos, and any email opt-in. The site has none of them.
 */
import { Image } from "astro:assets";

import ArticleCard from "@/components/content/ArticleCard.astro";
import PresentationViewer from "@/components/home/PresentationViewer.astro";
import ToolPromoPanel from "@/components/home/ToolPromoPanel.astro";
import PillarIcon from "@/components/layout/PillarIcon.astro";
import SearchBox from "@/components/layout/SearchBox.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AUTHOR } from "@/config/author";
import {
  CALCULATOR_PREVIEW,
  FEATURED_GUIDES,
  FEATURED_GUIDES_INTRO,
  LATEST_GUIDE_COUNT,
  START_HERE,
  TOOL_PROMOS,
} from "@/config/homepage";
import { getMedia } from "@/config/media";
import { PILLAR_NAV, menuLabel } from "@/config/navigation";
import { getPage, type PageId } from "@/config/pages";
import { getPillarPresentation } from "@/config/pillars";
import { SITE } from "@/config/site";
import {
  computeTotals,
  formatMoney,
  DEFAULT_CURRENCY,
} from "@/components/tools/ai-cost-calculator";
import {
  DEFAULTS as EMAIL_DEFAULTS,
  computeEmailSavings,
  formatCount,
  formatHours,
  formatSignedMoney,
} from "@/components/tools/ai-email-savings-calculator";
import { SLIDE_COUNT } from "@/config/presentation";
import { getPublishedEntries, toArticleCard } from "@/lib/content";
import { formatShortDate, isoDate } from "@/lib/format";
import { organizationSchema, websiteSchema } from "@/lib/seo";

const [pillars, articles, tools] = await Promise.all([
  getPublishedEntries("pillars"),
  getPublishedEntries("articles"),
  getPublishedEntries("tools"),
]);

/** Pillar id → hub title, from the pillar's own frontmatter. */
const categoryTitles = new Map(pillars.map(({ entry, page }) => [page.id, entry.data.title]));
const publishedPillarIds = new Set(pillars.map(({ page }) => page.id));

/** Every published pillar, in PILLAR_NAV order, with its guide count. */
const categories = PILLAR_NAV.filter((entry) => publishedPillarIds.has(entry.pillar)).map(
  (entry) => {
    const page = getPage(entry.pillar);
    const { summary, icon } = getPillarPresentation(entry.pillar);
    return {
      title: categoryTitles.get(page.id) ?? page.title,
      href: page.path,
      summary,
      icon,
      count: articles.filter(({ page: article }) => article.pillar === entry.pillar).length,
    };
  },
);

/**
 * How many columns the last category card takes.
 *
 * The grid is two columns from `sm` and three from `lg`, and the number of
 * published categories is whatever the pillars happen to be — seven today,
 * which divides evenly by neither. Left alone that ends the section on a
 * half-empty row, which is the most visible sign of a layout nobody looked at.
 *
 * So the final card absorbs whatever columns its row has spare. It is derived
 * from the count rather than written for seven, so publishing or retiring a
 * pillar can never bring the ragged row back.
 */
const spareColumns = {
  sm: ["", "sm:col-span-2"][categories.length % 2],
  lg: ["", "lg:col-span-3", "lg:col-span-2"][categories.length % 3],
};

const lastCategory = categories.length - 1;

/** Articles by registry id, for the editor's picks below. */
const articlesById = new Map(articles.map((article) => [article.page.id, article]));

/** A picked guide, or a build failure naming the pick that cannot be rendered. */
function pick(id: PageId) {
  const article = articlesById.get(id);
  if (!article) {
    throw new Error(`Homepage features "${id}", which is not a published article`);
  }
  return toArticleCard(article, categoryTitles);
}

const [featuredLead, ...featuredRest] = FEATURED_GUIDES.map(pick);

const startHere = START_HERE.map((path) => ({
  ...path,
  hub: getPage(path.pillar),
  hubTitle: categoryTitles.get(path.pillar) ?? getPage(path.pillar).title,
  guidePage: getPage(path.guide),
  guideTitle: articlesById.get(path.guide)?.entry.data.title ?? getPage(path.guide).title,
  icon: getPillarPresentation(path.pillar).icon,
}));

/** Newest first; a stable id tiebreak keeps the order deterministic. */
const latest = [...articles]
  .sort((a, b) => {
    const delta = b.entry.data.publishedDate.getTime() - a.entry.data.publishedDate.getTime();
    return delta !== 0 ? delta : a.page.id.localeCompare(b.page.id);
  })
  .slice(0, LATEST_GUIDE_COUNT)
  .map((article) => toArticleCard(article, categoryTitles));

/*
 * The hero background. Its own `alt` in the registry describes the picture
 * for the social card; here it is decorative — the h1 beside it already says
 * what the page is — so it is given an empty alt and hidden from assistive
 * technology.
 */
const heroArt = getMedia("home");

const blogPath = getPage("blog").path;
const aboutPath = getPage("about").path;

/* ---- Masthead facts --------------------------------------------------- */

/**
 * The four figures under the hero headline.
 *
 * Every one of them is counted from what is actually published in this
 * repository at build time — guides, category hubs, free tools, and the most
 * recent `updatedDate` across all three collections. None of them can be
 * inflated without publishing the thing it counts, which is the only reason
 * they are allowed on the page at all: the site has no visitor numbers, no
 * "tools reviewed" total, and no popularity claims to put here instead.
 *
 * They are typeset as a colophon rather than as a row of big marketing
 * numerals, because what makes them worth showing is that they are checkable,
 * not that they are large.
 */
const lastUpdated = [...pillars, ...articles, ...tools]
  .map(({ entry }) => entry.data.updatedDate)
  .reduce((latest, date) => (date > latest ? date : latest));

const MASTHEAD: { value: string; label: string; dateTime?: string }[] = [
  { value: String(articles.length), label: "Guides published" },
  { value: String(categories.length), label: "Categories" },
  { value: String(tools.length), label: "Free tools" },
  { value: formatShortDate(lastUpdated), label: "Last updated", dateTime: isoDate(lastUpdated) },
];

/* ---- Free tools ------------------------------------------------------- */

/**
 * Both calculators get a panel, rendered from TOOL_PROMOS rather than written
 * out twice. A promo for a tool that is not published is skipped rather than
 * rendered as a dead card, which matters because a tool can be unpublished by
 * its own frontmatter without the registry changing.
 *
 * Any free tool with no panel of its own is listed under the first panel's
 * actions instead, so every tool keeps a route in from the homepage however the
 * promo list changes. With both current tools promoted, that list is empty and
 * nothing is rendered. Tools are also reachable from the header's Free tools
 * menu, the footer, the blog archive and each category sidebar.
 */
const publishedToolIds = new Set(tools.map(({ page }) => page.id));

const promos = TOOL_PROMOS.filter((promo) => publishedToolIds.has(promo.tool)).map((promo) => ({
  ...promo,
  page: getPage(promo.tool),
  secondary: promo.secondary
    ? { href: getPage(promo.secondary.page).path, label: promo.secondary.label }
    : undefined,
}));

const promotedToolIds = new Set<string>(promos.map((promo) => promo.tool));

const alsoFree = tools
  .filter(({ page }) => !promotedToolIds.has(page.id))
  .map(({ page }) => ({ href: page.path, label: menuLabel(page) }));

/**
 * The cost calculator preview's figures, from the calculator's own function.
 * The inputs are round illustrative numbers, labelled as such on the page — no
 * vendor price appears anywhere.
 */
const preview = computeTotals(
  CALCULATOR_PREVIEW.tools.map((tool) => ({ ...tool })),
  { ...CALCULATOR_PREVIEW.business },
);
const money = (value: number | null) => formatMoney(value, DEFAULT_CURRENCY.symbol);

/**
 * The email calculator preview, computed the same way — from that tool's own
 * engine, run on its own published defaults, so the homepage shows exactly the
 * worked example a visitor sees when the calculator first opens. Those defaults
 * are illustrative placeholders, not averages or benchmarks, and the panel says
 * so; deriving the figures here rather than typing them means the two pages
 * cannot drift apart, and the homepage can never claim arithmetic the
 * calculator would not produce.
 */
const emailPreview = computeEmailSavings(EMAIL_DEFAULTS);
const emailMoney = (value: number) => formatSignedMoney(value, DEFAULT_CURRENCY.symbol);

/** Headline figure first, then the volume it came from. Four rows, no more. */
const EMAIL_PREVIEW_ROWS = [
  {
    label: "Hours saved, monthly",
    value: `${formatHours(emailPreview.hoursSaved)} hours`,
    size: "text-2xl font-extrabold text-ink-900",
  },
  {
    label: "Net benefit, monthly",
    value: emailMoney(emailPreview.monthlyNetBenefit),
    size: "text-xl font-bold text-accent-700",
  },
  {
    label: "Emails a month",
    value: formatCount(emailPreview.monthlyEmails),
    size: "text-base font-bold text-ink-900",
  },
  {
    label: "AI-eligible",
    value: formatCount(emailPreview.eligibleEmails),
    size: "text-base font-bold text-ink-900",
  },
];

/* ---- Presentation ----------------------------------------------------- */

/**
 * Where the eight-slide introduction sends people next. Three destinations that
 * already exist: the guide archive, the category grid further up this page, and
 * the free tools band directly above the presentation. No new page is invented
 * to give a button somewhere to point.
 */
const EXPLORE_ACTIONS = [
  { href: blogPath, label: "Explore AI guides", summary: "Every published guide, newest first." },
  {
    href: "#categories",
    label: "Browse categories",
    summary: "Six topics, from first steps to industry use cases.",
  },
  {
    href: "#free-tools",
    label: "Try our free tools",
    summary: "Two calculators, no sign-up, nothing stored.",
  },
];

/* ---- Editorial method ------------------------------------------------- */

/**
 * How the guides are made, summarised from the About + Editorial Process page.
 * Every line restates something that page already commits to; none of it is a
 * claim about testing, popularity, or endorsement.
 */
const METHOD = [
  {
    title: "Research you can check",
    body: "Guides are written from official product documentation, pricing pages, and product announcements, summarised in our own words with the sources linked.",
  },
  {
    title: "Testing is labelled",
    body: "A tool is only called tested when it has actually been tested. Research-based guides say so on the page and carry no scores.",
  },
  {
    title: "Dates are visible",
    body: "Every guide shows when it was last updated, and where it quotes prices, the date those prices were checked on the vendor's own page.",
  },
  {
    title: "Affiliate links are disclosed",
    body: "Some pages carry affiliate links and say so before the recommendation. Commissions do not decide what gets recommended or how it ranks.",
  },
];
---

<BaseLayout pageId="home" jsonLd={[websiteSchema(), organizationSchema()]}>
  {/* ---- 1. Hero ---------------------------------------------------- */}
  {/*
    A light masthead, centred on one measure.

    The artwork is a bright cool-blue field. It used to carry white copy, which
    meant dimming the picture to 80% and laying a near-opaque midnight panel
    over one half of it: the headline read, but what a visitor met first was a
    black rectangle with a photograph somewhere behind it. So the ink is
    flipped instead. The picture now runs at full strength and the only thing
    between it and the copy is one even white veil, thin enough that the face,
    the network and all four panels still read through it. The styles at the
    foot of this file hold the arithmetic that sets how thin it can be.

    Kicker, headline, lead, search box, both buttons and the colophon are all
    centred on the same 48rem measure, so the masthead reads as one column down
    the middle of the picture rather than as a copy half and a picture half.
  */}
  <section class="hero relative isolate flex items-center overflow-hidden bg-paper">
    <Image
      src={heroArt.src}
      alt=""
      aria-hidden="true"
      widths={[640, 960, 1280, 1672]}
      sizes="100vw"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      class="hero-art absolute inset-0 -z-10 size-full object-cover"
    />
    <div aria-hidden="true" class="hero-veil absolute inset-0 -z-10"></div>
    <div aria-hidden="true" class="hero-grid bg-grid absolute inset-0 -z-10 opacity-40"></div>

    <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:py-28">
      <div class="mx-auto max-w-3xl text-center">
        {/*
          Iris rather than jade. Jade is reserved for the free interactive
          tools — see global.css — and a masthead kicker is not one of them.
          The short rule the section heads carry beside their eyebrow is
          dropped here: on a centred line it would hang off one end only.
        */}
        <p class="eyebrow">Independent AI tool guides</p>

        <h1 class="type-display mt-5 text-ink-900">{SITE.tagline}</h1>

        <p class="type-lead mx-auto mt-6 max-w-2xl text-ink-700">
          Independent guides to AI tools, automation workflows, and prompts for solopreneurs and
          small business owners — what each tool actually does, what it costs, and when it is not
          worth paying for.
        </p>

        <div class="mx-auto mt-8 max-w-xl">
          <SearchBox
            id="hero"
            variant="hero"
            label="Search guides, tools and prompts"
            placeholder="Search guides, tools and prompts..."
          />
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center">
          <a href="#categories" class="btn btn-primary">
            Browse categories
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
              <path
                fill-rule="evenodd"
                d="M10 3a.75.75 0 0 1 .75.75v10.638l3.96-4.158a.75.75 0 1 1 1.08 1.04l-5.25 5.5a.75.75 0 0 1-1.08 0l-5.25-5.5a.75.75 0 1 1 1.08-1.04l3.96 4.158V3.75A.75.75 0 0 1 10 3Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
          <a href={blogPath} class="btn btn-secondary">
            Explore AI guides
          </a>
        </div>
      </div>

      {/*
        The colophon. A hairline and four counted facts, set in the technical
        register the rest of the site uses for metadata — not a statistics
        band. It is held to the copy's own measure and centred under it.

        The three figures count up from zero each time the row scrolls into
        view. The markup is rendered at the final value, so the count is
        decoration over a number that is already correct — a crawler, a visitor
        with scripting off, and anyone who has asked for reduced motion all get
        the figure and no animation. The date does not count: counting a date
        up from zero would be nonsense, and it is a time element whose text has
        to stay the date it is marked up as.
      */}
      <dl class="mx-auto mt-12 grid max-w-3xl grid-cols-2 gap-x-6 gap-y-6 border-t border-ink-900/15 pt-7 text-center sm:mt-14 sm:grid-cols-4">
        {MASTHEAD.map((fact) => (
          <div>
            <dt class="font-mono text-[0.625rem] tracking-[0.08em] text-ink-600 uppercase">
              {fact.label}
            </dt>
            <dd class="mt-1.5 font-sans text-lg font-bold text-ink-900 tabular-nums">
              {fact.dateTime ? (
                <time datetime={fact.dateTime}>{fact.value}</time>
              ) : (
                /* The reserved width is the final value's own digit count, so
                   the row cannot reflow as a counter passes 9. */
                <span
                  class="inline-block text-center"
                  style={`min-width:${fact.value.length}ch`}
                  data-count-to={fact.value}
                >
                  {fact.value}
                </span>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ---- 2. Categories ---------------------------------------------- */}
  <section id="categories" aria-labelledby="categories-heading" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
        <div class="max-w-2xl">
          <p class="eyebrow eyebrow-rule">Categories</p>
          <h2 id="categories-heading" class="type-section mt-3">
            Explore AI by category
          </h2>
        </div>
        <a
          href={blogPath}
          class="-my-1.5 inline-flex items-center gap-1.5 py-1.5 font-sans text-sm font-bold text-brand-700 transition-colors duration-180 ease-ui hover:text-brand-800 motion-reduce:transition-none"
        >
          All guides
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      </div>

      <ul class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((category, index) => (
          <li
            class:list={[
              "card card-link group relative flex flex-col p-6",
              index === lastCategory && [spareColumns.sm, spareColumns.lg],
            ]}
          >
            <span class="flex size-11 items-center justify-center rounded-xl border border-ink-200 bg-paper text-brand-700 transition-colors duration-180 ease-ui group-hover:border-brand-200 group-hover:bg-brand-50 motion-reduce:transition-none">
              <PillarIcon icon={category.icon} class="size-6" />
            </span>

            <h3 class="type-card-title mt-5">
              <a href={category.href} class="stretch-target group-hover:text-brand-800">
                {category.title}
              </a>
            </h3>

            {/* Capped, so the one card that may span the row does not set a
                40-word line the six beside it never do. */}
            <p class="mt-2.5 max-w-2xl flex-1 text-[0.9375rem] leading-relaxed text-ink-600">
              {category.summary}
            </p>

            <p class="mt-5 flex items-center justify-between gap-3 border-t border-ink-100 pt-4">
              <span class="font-mono text-[0.6875rem] tracking-[0.06em] text-ink-500 uppercase">
                {category.count} {category.count === 1 ? "guide" : "guides"}
              </span>
              <span
                aria-hidden="true"
                class="inline-flex items-center gap-1.5 font-sans text-sm font-bold text-brand-700"
              >
                Explore
                <svg
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="size-4 transition-transform duration-180 ease-ui group-hover:translate-x-0.5 motion-reduce:transition-none"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ---- 3. Featured guides ----------------------------------------- */}
  <section aria-labelledby="featured-heading" class="border-y border-ink-200 bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="max-w-2xl">
        <p class="eyebrow eyebrow-rule">Editor's picks</p>
        <h2 id="featured-heading" class="type-section mt-3">
          Featured guides
        </h2>
        <p class="type-body mt-3">{FEATURED_GUIDES_INTRO}</p>
      </div>

      <div class="mt-9 grid gap-5 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-8">
        {featuredLead && (
          <ArticleCard
            article={featuredLead}
            variant="lead"
            as="h3"
            sizes="(min-width: 1024px) 36rem, 92vw"
          />
        )}

        <ul class="grid gap-3 self-start">
          {featuredRest.map((article) => (
            <li>
              <ArticleCard article={article} variant="row" as="h3" />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ---- 4. Start here ---------------------------------------------- */}
  <section aria-labelledby="start-here-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="max-w-2xl">
        <p class="eyebrow eyebrow-rule">Start here</p>
        <h2 id="start-here-heading" class="type-section mt-3">
          Where do you want to begin?
        </h2>
        <p class="type-body mt-3">
          Four ways in. Each one opens a category and points at the guide most people read first.
        </p>
      </div>

      <ul class="mt-9 grid gap-4 sm:grid-cols-2">
        {startHere.map((path) => (
          <li class="card group relative flex flex-col p-6">
            <div class="flex items-start gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-ink-200 bg-paper text-brand-700 transition-colors duration-180 ease-ui group-hover:border-brand-200 group-hover:bg-brand-50 motion-reduce:transition-none">
                <PillarIcon icon={path.icon} class="size-5" />
              </span>
              <div class="min-w-0">
                <h3 class="font-display text-lg font-bold tracking-[-0.008em] text-ink-900">
                  “{path.question}”
                </h3>
                <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-600">{path.summary}</p>
              </div>
            </div>

            <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-ink-100 pt-4 text-sm">
              <a
                href={path.hub.path}
                class="inline-flex items-center gap-1.5 font-sans font-bold text-brand-700 transition-colors duration-180 ease-ui hover:text-brand-800 motion-reduce:transition-none"
              >
                {path.hubTitle}
                <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
              <a
                href={path.guidePage.path}
                class="text-ink-500 underline decoration-ink-300 underline-offset-2 transition-colors duration-180 ease-ui hover:text-brand-700 hover:decoration-current motion-reduce:transition-none"
              >
                Start with: {path.guideTitle}
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ---- 5. Free tools ----------------------------------------------- */}
  {/*
    Both calculators, one band. Each panel is its own <section> with its own
    <h2>, so neither tool is demoted to a sub-heading of the other and the
    heading outline stays flat under the page's single <h1>. The band itself is
    a plain wrapper: it groups them visually without inventing a heading of its
    own that would say nothing a visitor needs.
  */}
  {promos.length > 0 && (
    <div id="free-tools" class="scroll-mt-20 border-y border-ink-200 bg-surface">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 py-16 sm:px-6 sm:py-20">
        {promos.map((promo, index) => (
          <section aria-labelledby={promo.headingId}>
            <ToolPromoPanel
              tone={index === 0 ? "dark" : "light"}
              reverse={index > 0}
              eyebrow={promo.eyebrow}
              heading={promo.heading}
              headingId={promo.headingId}
              description={promo.description}
              features={promo.features}
              primary={{
                href: promo.page.path,
                label: promo.primaryLabel,
                event: promo.primaryEvent,
              }}
              secondary={promo.secondary}
              note={promo.note}
              alsoFree={index === 0 ? alsoFree : []}
