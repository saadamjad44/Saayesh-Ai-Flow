---
/**
 * Homepage.
 *
 * Built as a sequence of distinct scenes rather than a stack of card grids:
 *
 *   1. Masthead     dark, full-bleed, running up behind the floating navbar:
 *                   headline, a search bar inside a turning gradient ring, the
 *                   categories as pills, and a "look inside" board of real
 *                   guides that leans back and stands up as it scrolls in
 *   2. Marquee      the tools in the pricing record, sliding past
 *   3. Categories   a bento of the category artwork, uneven on purpose
 *   4. Featured     one magazine-size lead and a numbered list beside it
 *   5. Compare      the head-to-head guides, a dark rail
 *   6. Start here   four numbered routes in, joined by a line
 *   7. Pricing      what the pricing dataset shows
 *   8. Free tools   both calculators
 *   9. Latest       the newest guides
 *  10. Email, method, FAQ
 *
 * Nothing on this page is hand-listed. Categories come from PILLAR_NAV
 * filtered to published pillars; featured and "start here" are editor's picks
 * in src/config/homepage.ts, typed to the registry; the board is the newest
 * guide of each category; the comparison rail is every guide whose id marks it
 * a head-to-head; the marquee is the pricing dataset's own tool names; and
 * each calculator preview is computed by that calculator's own function.
 *
 * Every figure shown is counted or computed at build time. Deliberately
 * absent: visitor counts, "most popular" claims, review scores, testimonials,
 * partner logos, and any subscriber figure. The site has none of them.
 */
import { Image } from "astro:assets";

import ArticleCard from "@/components/content/ArticleCard.astro";
import FaqSection from "@/components/content/FaqSection.astro";
import NewsletterSignup from "@/components/forms/NewsletterSignup.astro";
import PricingFindings from "@/components/home/PricingFindings.astro";
import SectionHeading from "@/components/home/SectionHeading.astro";
import ToolPromoPanel from "@/components/home/ToolPromoPanel.astro";
import PillarTile from "@/components/layout/PillarTile.astro";
import SearchBox from "@/components/layout/SearchBox.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AUTHOR } from "@/config/author";
import {
  CALCULATOR_PREVIEW,
  FEATURED_GUIDES,
  FEATURED_GUIDES_INTRO,
  HOME_FAQ,
  LATEST_GUIDE_COUNT,
  START_HERE,
  TOOL_PROMOS,
} from "@/config/homepage";
import { getMedia, isMediaId } from "@/config/media";
import { PILLAR_NAV, menuLabel } from "@/config/navigation";
import { getPage, type PageId } from "@/config/pages";
import { getPillarPresentation } from "@/config/pillars";
import { INTEGRATIONS, SITE } from "@/config/site";
import {
  computeTotals,
  formatMoney,
  DEFAULT_CURRENCY,
} from "@/components/tools/ai-cost-calculator";
import {
  DEFAULTS as EMAIL_DEFAULTS,
  computeEmailSavings,
  formatCount,
  formatHours,
  formatSignedMoney,
} from "@/components/tools/ai-email-savings-calculator";
import { PRICING_ROWS } from "@/data/ai-tool-pricing";
import { getPublishedEntries, toArticleCard } from "@/lib/content";
import { formatShortDate, isoDate } from "@/lib/format";
import {
  homeBreadcrumbSchema,
  itemListSchema,
  organizationSchema,
  siteNavigationSchema,
  websiteSchema,
} from "@/lib/seo";

const [pillars, articles, tools] = await Promise.all([
  getPublishedEntries("pillars"),
  getPublishedEntries("articles"),
  getPublishedEntries("tools"),
]);

/** Pillar id → hub title, from the pillar's own frontmatter. */
const categoryTitles = new Map(pillars.map(({ entry, page }) => [page.id, entry.data.title]));
const publishedPillarIds = new Set(pillars.map(({ page }) => page.id));

/** Newest first; a stable id tiebreak keeps the order deterministic. */
const newestFirst = [...articles].sort((a, b) => {
  const delta = b.entry.data.publishedDate.getTime() - a.entry.data.publishedDate.getTime();
  return delta !== 0 ? delta : a.page.id.localeCompare(b.page.id);
});

/** Every published pillar, in PILLAR_NAV order, with its artwork and count. */
const categories = PILLAR_NAV.filter((entry) => publishedPillarIds.has(entry.pillar)).map(
  (entry) => {
    const page = getPage(entry.pillar);
    const { summary, icon } = getPillarPresentation(entry.pillar);
    return {
      id: entry.pillar,
      title: categoryTitles.get(page.id) ?? page.title,
      href: page.path,
      summary,
      icon,
      art: isMediaId(entry.pillar) ? getMedia(entry.pillar) : undefined,
      count: articles.filter(({ page: article }) => article.pillar === entry.pillar).length,
    };
  },
);

/**
 * The bento's column spans, on a four-column grid.
 *
 * A repeating wide/narrow rhythm, so the grid reads as composed rather than as
 * eight equal boxes; whatever the last row has spare is given to the last
 * card, so the grid closes flush however many categories are published.
 */
const BENTO_RHYTHM = [2, 1, 1, 1, 1, 2];
const bentoSpans = categories.map((_, index) => BENTO_RHYTHM[index % BENTO_RHYTHM.length] ?? 1);
const bentoSpare = (4 - (bentoSpans.reduce((sum, span) => sum + span, 0) % 4)) % 4;
if (bentoSpans.length > 0) {
  bentoSpans[bentoSpans.length - 1] = Math.min(
    4,
    (bentoSpans[bentoSpans.length - 1] ?? 1) + bentoSpare,
  );
}
const SPAN_CLASS = ["", "", "lg:col-span-2", "lg:col-span-3", "lg:col-span-4"];

/** Articles by registry id, for the editor's picks below. */
const articlesById = new Map(articles.map((article) => [article.page.id, article]));

/** A picked guide, or a build failure naming the pick that cannot be rendered. */
function pick(id: PageId) {
  const article = articlesById.get(id);
  if (!article) {
    throw new Error(`Homepage features "${id}", which is not a published article`);
  }
  return toArticleCard(article, categoryTitles);
}

const [featuredLead, ...featuredRest] = FEATURED_GUIDES.map(pick);
const featuredArt = featuredLead ? getMedia(featuredLead.mediaId) : undefined;

const startHere = START_HERE.map((path) => ({
  ...path,
  hub: getPage(path.pillar),
  hubTitle: categoryTitles.get(path.pillar) ?? getPage(path.pillar).title,
  guidePage: getPage(path.guide),
  guideTitle: articlesById.get(path.guide)?.entry.data.title ?? getPage(path.guide).title,
  icon: getPillarPresentation(path.pillar).icon,
}));

const latest = newestFirst
  .slice(0, LATEST_GUIDE_COUNT)
  .map((article) => toArticleCard(article, categoryTitles));

/** The head-to-head guides: a guide whose registry id says "-vs-". */
const comparisons = newestFirst
  .filter(({ page }) => page.id.includes("-vs-"))
  .map((article) => toArticleCard(article, categoryTitles));

/**
 * The masthead's "look inside" board: the newest guide from each category that
 * has a photo of its own, six at most — so the board is a cross-section of the
 * site rather than six guides from whichever category published last.
 */
const showcase = categories
  .map((category) =>
    newestFirst.find(
      (article) =>
        article.page.pillar === category.id &&
        toArticleCard(article, categoryTitles).articleMedia !== undefined,
    ),
  )
  .filter((article) => article !== undefined)
  .slice(0, 6)
  .map((article) => toArticleCard(article, categoryTitles));

/** Every product in the pricing record, once, alphabetically. */
const trackedTools = [...new Set(PRICING_ROWS.map((row) => row.tool))].sort((a, b) =>
  a.localeCompare(b),
);

const heroArt = getMedia("home");
const blogPath = getPage("blog").path;
const aboutPath = getPage("about").path;
const trackerPath = getPage("ai-tool-pricing-tracker").path;

/**
 * The headline is SITE.tagline, word for word — the gradient only picks out
 * one phrase of it. Without that phrase the headline simply renders plain.
 */
const HEADLINE_MARK = "earn their place";
const markAt = SITE.tagline.indexOf(HEADLINE_MARK);
const headline =
  markAt === -1
    ? { before: SITE.tagline, mark: "", after: "" }
    : {
        before: SITE.tagline.slice(0, markAt),
        mark: HEADLINE_MARK,
        after: SITE.tagline.slice(markAt + HEADLINE_MARK.length),
      };

/** Four facts, each counted from what is published at build time. */
const lastUpdated = [...pillars, ...articles, ...tools]
  .map(({ entry }) => entry.data.updatedDate)
  .reduce((latestDate, date) => (date > latestDate ? date : latestDate));

const MASTHEAD: { value: string; label: string; dateTime?: string }[] = [
  { value: String(articles.length), label: "Guides published" },
  { value: String(categories.length), label: "Categories" },
  { value: String(tools.length), label: "Free tools" },
  { value: formatShortDate(lastUpdated), label: "Last updated", dateTime: isoDate(lastUpdated) },
];

/* ---- Free tools ------------------------------------------------------- */

const publishedToolIds = new Set(tools.map(({ page }) => page.id));

const promos = TOOL_PROMOS.filter((promo) => publishedToolIds.has(promo.tool)).map((promo) => ({
  ...promo,
  page: getPage(promo.tool),
  secondary: promo.secondary
    ? { href: getPage(promo.secondary.page).path, label: promo.secondary.label }
    : undefined,
}));

const promotedToolIds = new Set<string>(promos.map((promo) => promo.tool));

const alsoFree = tools
  .filter(({ page }) => !promotedToolIds.has(page.id))
  .map(({ page }) => ({ href: page.path, label: menuLabel(page) }));

/** Cost preview: the calculator's own function over illustrative inputs. */
const preview = computeTotals(
  CALCULATOR_PREVIEW.tools.map((tool) => ({ ...tool })),
  { ...CALCULATOR_PREVIEW.business },
);
const money = (value: number | null) => formatMoney(value, DEFAULT_CURRENCY.symbol);

const COST_PREVIEW_ROWS = [
  { label: "Monthly", value: money(preview.monthlyRecurring), size: "text-3xl text-ink-900" },
  { label: "Annual", value: money(preview.annualRecurring), size: "text-xl text-ink-900" },
  {
    label: "First year, with setup",
    value: money(preview.firstYearTotal),
    size: "text-xl text-accent-700",
  },
  {
    label: "Per employee, monthly",
    value: money(preview.perEmployee),
    size: "text-base text-ink-900",
  },
];

/** Email preview: that calculator's engine over its own published defaults. */
const emailPreview = computeEmailSavings(EMAIL_DEFAULTS);
const emailMoney = (value: number) => formatSignedMoney(value, DEFAULT_CURRENCY.symbol);

const EMAIL_PREVIEW_ROWS = [
  {
    label: "Hours saved, monthly",
    value: `${formatHours(emailPreview.hoursSaved)} hours`,
    size: "text-3xl text-ink-900",
  },
  {
    label: "Net benefit, monthly",
    value: emailMoney(emailPreview.monthlyNetBenefit),
    size: "text-xl text-accent-700",
  },
  {
    label: "Emails a month",
    value: formatCount(emailPreview.monthlyEmails),
    size: "text-base text-ink-900",
  },
  {
    label: "AI-eligible",
    value: formatCount(emailPreview.eligibleEmails),
    size: "text-base text-ink-900",
  },
];

/**
 * How the guides are made, summarised from the About + Editorial Process page.
 * Every line restates something that page already commits to.
 */
const METHOD = [
  {
    title: "Research you can check",
    body: "Guides are written from official product documentation, pricing pages, and product announcements, summarised in our own words with the sources linked.",
  },
  {
    title: "Testing is labelled",
    body: "A tool is only called tested when it has actually been tested. Research-based guides say so on the page and carry no scores.",
  },
  {
    title: "Dates are visible",
    body: "Every guide shows when it was last updated, and where it quotes prices, the date those prices were checked on the vendor's own page.",
  },
  {
    title: "Affiliate links are disclosed",
    body: "Some pages carry affiliate links and say so before the recommendation. Commissions do not decide what gets recommended or how it ranks.",
  },
];

const ARROW =
  "M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z";

const stagger = (index: number, step = 80) => `--reveal-delay:${index * step}ms`;
const two = (index: number) => String(index + 1).padStart(2, "0");

/** The dark wash under white type on a photograph. Fixed in both themes. */
const SHADE = "bg-gradient-to-t from-[#060918] via-[#060918]/75 to-[#060918]/5";
---

{/*
  WebSite, Organization, the breadcrumb root, the category navigation and the
  editor's picks — the last three built from the arrays rendered below.
  FAQPage is emitted by <FaqSection> itself, from the strings it renders.
*/}
<BaseLayout
  pageId="home"
  jsonLd={[
    websiteSchema(),
    organizationSchema(),
    homeBreadcrumbSchema(),
    siteNavigationSchema(
      categories.map((category) => ({ name: category.title, path: category.href })),
    ),
    itemListSchema({
      name: `Featured guides on ${SITE.name}`,
      items: [featuredLead, ...featuredRest]
        .filter((article) => article !== undefined)
        .map((article) => ({ name: article.title, path: article.path })),
    }),
  ]}
>
  {/* ==== 1. Masthead ================================================= */}
  <section class="hero theme-dark bg-night relative isolate -mt-[4.75rem] overflow-hidden pt-[4.75rem]">
    {/* Atmosphere: drifting colour, a fading grid, and the brand artwork as light. */}
    <div aria-hidden="true" class="orb orb-sky -top-32 -left-24 size-[30rem]"></div>
    <div
      aria-hidden="true"
      class="orb orb-violet top-10 -right-32 size-[34rem] [animation-delay:-6s]"
    ></div>
    <div
      aria-hidden="true"
      class="orb orb-indigo top-[38rem] left-1/3 size-[30rem] [animation-delay:-11s]"
    ></div>
    <div
      aria-hidden="true"
      class="bg-grid-inverse pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(75%_60%_at_50%_0%,#000,transparent)]"
    ></div>
    <Image
      src={heroArt.src}
      alt={heroArt.alt}
      widths={[640, 960, 1280]}
      sizes="60vw"
      loading="eager"
      class="hero-art pointer-events-none absolute top-0 right-0 -z-10 hidden h-[44rem] w-[62%] object-cover lg:block"
    />

    <div class="relative mx-auto max-w-6xl px-4 pt-14 pb-10 text-center sm:px-6 sm:pt-20 lg:pt-24">
      <p class="rise" style="--d:0ms">
        <a
          href={blogPath}
          class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/[0.06] py-1.5 pr-4 pl-3 font-mono text-[0.6875rem] font-semibold tracking-[0.08em] text-ink-800 uppercase backdrop-blur-md transition-colors duration-180 ease-ui hover:border-white/35 hover:bg-white/10 motion-reduce:transition-none"
        >
          <span
            aria-hidden="true"
            class="pulse-dot size-1.5 rounded-full bg-emerald-400 text-emerald-400"
          ></span>
          Independent AI tool guides
          <span aria-hidden="true" class="text-ink-500">
            &rarr;
          </span>
        </a>
      </p>

      <h1 class="hero-title rise-solid mx-auto mt-7 max-w-5xl" style="--d:90ms">
        {headline.before}
        {headline.mark && <span class="text-shine">{headline.mark}</span>}
        {headline.after}
      </h1>

      <p
        class="rise mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-700 sm:text-xl"
        style="--d:180ms"
      >
        Independent guides to AI tools, automation workflows, and prompts for solopreneurs and small
        business owners — what each tool actually does, what it costs, and when it is not worth
        paying for.
      </p>

      {/* The search bar, inside a turning ring of the brand colours. */}
      <div class="rise relative z-20 mx-auto mt-9 max-w-2xl" style="--d:270ms">
        <div class="glow-border">
          <div class="rounded-2xl bg-[#0b1128]">
            <SearchBox
              id="hero"
              variant="hero"
              label="Search guides, tools and prompts"
              placeholder="Search guides, tools and prompts..."
            />
          </div>
        </div>
      </div>

      {/* Every category, one tap away. */}
      <ul
        class="rise mx-auto mt-7 flex max-w-4xl flex-wrap justify-center gap-2.5"
        style="--d:360ms"
      >
        {categories.map((category) => (
          <li>
            <a
              href={category.href}
              class="group inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/[0.05] py-1.5 pr-3.5 pl-1.5 text-sm font-semibold text-ink-800 backdrop-blur-md transition-[border-color,background-color,transform] duration-180 ease-ui hover:-translate-y-0.5 hover:border-white/35 hover:bg-white/12 motion-reduce:transition-none motion-reduce:hover:transform-none"
            >
              <PillarTile icon={category.icon} size="sm" class="size-7! rounded-full!" />
              {category.title}
            </a>
          </li>
        ))}
      </ul>

      {/*
        The board: real guides, one per category, in a window frame. It starts
        leaning back and stands upright as it scrolls into view — the tilt is
        applied by script, so without it the board is simply flat.
      */}
      {showcase.length > 0 && (
        <div
          class="rise relative mx-auto mt-16 max-w-5xl [perspective:1600px] sm:mt-20"
          style="--d:460ms"
        >
          <div
            aria-hidden="true"
            class="absolute -inset-x-10 -top-10 bottom-10 -z-10 rounded-[3rem] bg-[image:var(--gradient-brand)] opacity-35 blur-3xl"
          ></div>
          <div
            class="board origin-top overflow-hidden rounded-2xl border border-white/15 bg-[#0b1128]/85 text-left shadow-[0_40px_120px_-30px_rgb(79_70_229/0.9)] backdrop-blur-xl will-change-transform"
            data-scroll-tilt
          >
            <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
              <span aria-hidden="true" class="size-2.5 rounded-full bg-[#ff5f57]"></span>
              <span aria-hidden="true" class="size-2.5 rounded-full bg-[#febc2e]"></span>
              <span aria-hidden="true" class="size-2.5 rounded-full bg-[#28c840]"></span>
              <p class="ml-3 font-mono text-[0.6875rem] tracking-[0.06em] text-ink-500">
                A look inside — the newest guide from each category
              </p>
            </div>
            <ul class="grid gap-3 p-3 sm:grid-cols-2 sm:p-4 lg:grid-cols-3">
              {showcase.map((article) => (
                <li>
                  <a
                    href={article.path}
                    class="group relative isolate block overflow-hidden rounded-xl"
                  >
                    {article.articleMedia && (
                      <Image
                        src={article.articleMedia.src}
                        alt=""
                        widths={[320, 480, 640]}
                        sizes="(min-width: 1024px) 20rem, (min-width: 640px) 45vw, 92vw"
                        loading="lazy"
                        decoding="async"
                        class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-ui group-hover:scale-110 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                      />
                    )}
                    <span aria-hidden="true" class:list={["absolute inset-0", SHADE]}></span>
                    <span class="absolute inset-x-0 bottom-0 p-3.5">
                      {article.category && (
                        <span class="block font-mono text-[0.5625rem] font-semibold tracking-[0.1em] text-sky-300 uppercase">
                          {article.category.title}
                        </span>
                      )}
                      <span class="mt-1 line-clamp-2 block text-[0.9375rem] leading-snug font-bold tracking-[-0.015em] text-white">
                        {article.title}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}

      {/*
        Four counted facts. The figures count up when they scroll into view;
        the markup holds the final value, so the count is decoration over a
        number that is already right.
      */}
      <dl class="mx-auto mt-14 grid max-w-4xl grid-cols-2 gap-y-8 sm:mt-16 sm:grid-cols-4">
        {MASTHEAD.map((fact, index) => (
          <div
            class="sm:border-l sm:border-white/10 sm:first:border-l-0"
            style={stagger(index)}
            data-reveal
          >
            <dd class="font-display text-4xl font-bold tracking-[-0.04em] tabular-nums sm:text-5xl">
              {fact.dateTime ? (
                <time datetime={fact.dateTime} class="text-2xl text-ink-900 sm:text-[1.75rem]">
                  {fact.value}
                </time>
              ) : (
                <span
                  class="text-gradient inline-block text-center"
                  style={`min-width:${fact.value.length}ch`}
                  data-count-to={fact.value}
                >
                  {fact.value}
                </span>
              )}
            </dd>
            <dt class="mt-2 font-mono text-[0.6875rem] tracking-[0.1em] text-ink-500 uppercase">
              {fact.label}
            </dt>
          </div>
        ))}
      </dl>
    </div>

    {/* ==== 2. Marquee ================================================ */}
    {/*
      The products in the pricing record — what the site has actually checked
      a price for, not partners and not endorsements, and the label says so.
      The second copy of the list is aria-hidden; it only closes the loop.
    */}
    <div class="relative border-t border-white/10 py-7">
      <p class="mb-5 text-center font-mono text-[0.6875rem] tracking-[0.1em] text-ink-500 uppercase">
        List prices tracked for {trackedTools.length} tools —{" "}
        <a
          href={trackerPath}
          class="text-ink-700 underline decoration-white/30 underline-offset-4 hover:text-ink-900"
        >
          see the tracker
        </a>
      </p>
      <div class="marquee">
        <div class="marquee-track">
          {[0, 1].map((copy) => (
            <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? "true" : undefined}>
              {trackedTools.map((tool) => (
                <li class="flex items-center font-display text-xl font-bold tracking-[-0.02em] whitespace-nowrap text-ink-600 sm:text-2xl">
                  {tool}
                  <span
                    aria-hidden="true"
                    class="mx-7 size-1.5 rounded-full bg-[image:var(--gradient-brand)]"
                  ></span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ==== 3. Categories — the bento ==================================== */}
  <section id="categories" aria-labelledby="categories-heading" class="scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="eyebrow eyebrow-rule eyebrow-center">Categories</p>
        <h2 id="categories-heading" class="section-title mt-4">
          AI tools for small business, <span class="text-gradient">by category</span>
        </h2>
        <p class="type-lead mt-5">
          Different ways into the same question: which tool is worth it for the job in front of you.
        </p>
      </div>

      <ul class="mt-14 grid auto-rows-[17rem] gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
        {categories.map((category, index) => (
          <li
            class:list={[
              "group spotlight relative isolate flex flex-col justify-end overflow-hidden rounded-panel p-6 shadow-panel ring-1 ring-black/5 transition-transform duration-300 ease-ui hover:-translate-y-1.5 motion-reduce:transition-none motion-reduce:hover:transform-none",
              SPAN_CLASS[bentoSpans[index] ?? 1],
            ]}
            style={stagger(index, 60)}
            data-reveal
          >
            {category.art && (
              <Image
                src={category.art.src}
                alt=""
                widths={[480, 768, 1024]}
                sizes="(min-width: 1024px) 40rem, (min-width: 640px) 50vw, 92vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-[900ms] ease-ui group-hover:scale-110 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              />
            )}
            <div aria-hidden="true" class:list={["absolute inset-0 -z-10", SHADE]}></div>

            <div class="absolute top-5 right-5 left-5 flex items-start justify-between">
              <PillarTile icon={category.icon} size="lg" />
