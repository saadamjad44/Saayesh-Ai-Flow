---
// Placeholder homepage on the shared layout. The real homepage is built in
// Step 4; remove `noindex` then so the page matches its sitemap entry.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config/site";
import { websiteSchema } from "@/lib/seo";
---

<BaseLayout
  pageId="home"
  title={SITE.name}
  description={SITE.tagline}
  noindex
  jsonLd={[websiteSchema()]}
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{SITE.name}</h1>
    <p class="mt-4 text-lg text-slate-600">{SITE.tagline}</p>
  </div>
</BaseLayout>
