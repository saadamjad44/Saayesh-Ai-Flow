    filter: invert(1) hue-rotate(180deg) saturate(1.3);
    mix-blend-mode: screen;
    opacity: 0.55;
    object-position: 100% 30%;
    mask-image: radial-gradient(70% 75% at 78% 30%, #000 20%, transparent 78%);
