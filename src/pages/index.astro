---
/**
 * Homepage: positioning and the live category pillars. Editorial methodology
 * lives on the About + Editorial Process page, not here.
 * Still omitted: the latest-articles row, the email opt-in, "Popular
 * Comparisons", and unverified trust claims.
 *
 * PILLARS is ordered to match PRIMARY_NAV, and every entry needs its own image
 * in the media registry — the `PageId & MediaId` type enforces that.
 */
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config/site";
import { getPage, type PageId } from "@/config/pages";
import { getMedia, type MediaId } from "@/config/media";
import { websiteSchema } from "@/lib/seo";

const PILLARS: readonly { id: PageId & MediaId; summary: string }[] = [
  {
    id: "getting-started",
    summary:
      "New to AI? Start here for what these tools actually do, where to begin, and the mistakes that waste the most time.",
  },
  {
    id: "ai-writing-tools",
    summary:
      "Roundups and head-to-head comparisons to help you choose an AI writing tool for your work.",
  },
  {
    id: "ai-business-tools",
    summary:
      "AI tools for solopreneurs and small business owners, including what they cost and what they can take off your plate.",
  },
  {
    id: "ai-automation",
    summary:
      "Step-by-step automation examples and workflows for email, scheduling, and other repeat tasks.",
  },
];
---

<BaseLayout
  pageId="home"
  title={`${SITE.name}: AI Tools, Automation & Workflow Guides`}
  description="Research-based guides to AI writing tools, AI business tools, and AI automation workflows for solopreneurs and small business owners."
  jsonLd={[websiteSchema()]}
>
  <section class="relative overflow-hidden border-b border-ink-200 bg-surface">
    {/* Decorative grid wash; hidden from assistive tech. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 opacity-[0.55]"
      style="background-image: linear-gradient(to right, var(--color-ink-100) 1px, transparent 1px), linear-gradient(to bottom, var(--color-ink-100) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 80% 60% at 70% 0%, black, transparent);"
    ></div>

    <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:py-28">
      <div class="max-w-3xl">
        <p class="eyebrow">Independent AI tool guides</p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-display text-balance text-ink-900 sm:text-5xl lg:text-6xl lg:leading-[1.05]">
          {SITE.tagline}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-ink-600 sm:text-xl">
          Practical guides to AI writing tools, AI business tools, and AI automation for
          solopreneurs and small business owners, written to help you choose with less guesswork.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="#categories" class="btn btn-primary">
            Browse categories
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
              <path
                fill-rule="evenodd"
                d="M10 3a.75.75 0 0 1 .75.75v10.638l3.96-4.158a.75.75 0 1 1 1.08 1.04l-5.25 5.5a.75.75 0 0 1-1.08 0l-5.25-5.5a.75.75 0 1 1 1.08-1.04l3.96 4.158V3.75A.75.75 0 0 1 10 3Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
          <a href={getPage("about").path} class="btn btn-secondary">
            How we work
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="categories" aria-labelledby="categories-heading" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="max-w-2xl">
        <p class="eyebrow">Four categories</p>
        <h2
          class="mt-2 text-2xl font-bold tracking-display text-ink-900 sm:text-3xl"
          id="categories-heading"
        >
          Explore by category
        </h2>
      </div>

      <ul class="mt-9 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {PILLARS.map(({ id, summary }, index) => {
          const pillar = getPage(id);
          const media = getMedia(id);
          return (
            <li class="card card-link group relative flex flex-col overflow-hidden">
              <Image
                src={media.src}
                alt={media.alt}
                widths={[400, 640, 800]}
                sizes="(min-width: 1024px) 270px, (min-width: 640px) 45vw, 100vw"
                loading={index === 0 ? "eager" : "lazy"}
                decoding={index === 0 ? "sync" : "async"}
                class="aspect-video w-full border-b border-ink-200 object-cover"
              />
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-lg font-bold tracking-display text-ink-900">
                  <a
                    href={pillar.path}
                    class="after:absolute after:inset-0 group-hover:text-brand-700"
                  >
                    {pillar.title}
                  </a>
                </h3>
                <p class="mt-2.5 flex-1 leading-relaxed text-ink-600">{summary}</p>
                <span
                  aria-hidden="true"
                  class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700"
                >
                  Explore
                  <svg
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="size-4 transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>
