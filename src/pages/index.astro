<style>
  /*
   * The hero background.
   *
   * Two layers over the section's own midnight ground: the artwork, dimmed so
   * it reads as light in a dark room rather than as a photo with text on top,
   * and a scrim that keeps the copy column at full white-on-midnight contrast
   * however the image crops.
   *
   * The artwork is composed with its subject on the right and open sky on the
   * left, so the copy sits in the empty half and the picture is never asked to
   * carry text on its busy side.
   *
   * Measured at the worst case — the brightest pixel in the artwork, under the
   * thinnest part of the scrim that any text reaches — white copy still clears
   * 16:1. The right-hand third, where the scrim thins out far enough for the
   * picture to come through properly, has no text over it at any width.
   */
  .hero-art {
    /*
     * A narrow viewport crops this hard horizontally — roughly a sixth of the
     * picture survives — so hold the subject rather than the empty sky, or the
     * hero is a blank wash on a phone.
     */
    object-position: 68% 50%;
    opacity: 0.42;
  }

  /*
   * Phones have no empty column to put the copy in, so the wash covers the
   * whole frame: heaviest at the top under the headline, lifting through the
   * middle where the artwork can still be seen behind the search box, and
   * closing again at the foot so the colophon sits on flat ink.
   */
  .hero-scrim {
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--color-ink-950) 88%, transparent) 0%,
      color-mix(in oklab, var(--color-ink-950) 78%, transparent) 55%,
      color-mix(in oklab, var(--color-ink-950) 92%, transparent) 100%
    );
  }

  @media (min-width: 1024px) {
    .hero-art {
      /* Wide boxes crop vertically only, so centre is the whole composition. */
      object-position: 55% 50%;
      opacity: 0.6;
    }

    /*
     * Horizontal from `lg`, where there is an empty column to work with: flat
     * midnight under the 34rem copy column, then a fall-off that lets the
     * picture carry the right-hand third. The second gradient settles the
     * bottom edge so the colophon rule does not cut across the artwork.
     */
    .hero-scrim {
      background:
        linear-gradient(
          to right,
          var(--color-ink-950) 0%,
          var(--color-ink-950) 42%,
          color-mix(in oklab, var(--color-ink-950) 88%, transparent) 56%,
          color-mix(in oklab, var(--color-ink-950) 45%, transparent) 78%,
          color-mix(in oklab, var(--color-ink-950) 22%, transparent) 100%
        ),
        linear-gradient(to top, var(--color-ink-950) 0%, transparent 35%);
    }
  }
</style>

<script>
  /**
   * The homepage's only analytics listener: a call to action that declares an
   * event name gets one, and nothing else on the page is instrumented.
   *
   * What is sent is that the click happened, and where. Never a value — the
   * calculators' own figures are not touched here and must never be; see the
   * contract in src/lib/analytics.ts. The presentation viewer tracks its own
   * two events in its own script, so nothing below fires twice.
   */
  import { trackEvent, type AnalyticsEventName } from "@/lib/analytics";

  for (const element of document.querySelectorAll<HTMLElement>("[data-analytics-event]")) {
    const name = element.dataset.analyticsEvent as AnalyticsEventName | undefined;
    if (!name) continue;
    element.addEventListener("click", () => trackEvent(name, { location: "homepage" }));
  }
</script>
