---
/**
 * Site header: brand lockup, two disclosure menus — Categories over the content
 * pillars and Tools over the free calculators — three stable links, and the
 * content search box.
 *
 * Every link in here — including the ones inside the collapsed menus — is a
 * plain <a> rendered on the server, so a crawler sees the same navigation a
 * visitor does and no pillar depends on JavaScript to be discoverable. Each
 * destination appears exactly once in the desktop bar: the tools used to ride
 * along in a column of the Categories panel, which meant the two calculators
 * were only findable by someone who had already opened a menu about something
 * else, and gave every tool URL two header links on every page.
 *
 * Three disclosure panels, because desktop and mobile want different shapes and
 * trying to serve both from one element produced a menu that was wrong on one
 * of them:
 *   - `#categories-menu` is the desktop dropdown over the pillars, full-bleed
 *     under the bar because seven categories with descriptions need the width.
 *   - `#tools-menu` is the desktop dropdown over the free tools, anchored to
 *     its own button: two items do not earn a full-width panel.
 *   - `#mobile-menu` is the sheet, in the flow under the bar, carrying search,
 *     the categories, the free tools, and the links.
 * Each is hidden at the width it does not serve, so only one is ever reachable.
 *
 * The bar switches to the sheet below `lg`, not below `md`. Two menus, three
 * links, the wordmark and a usable search field do not fit across a 768px
 * tablet — measured, the row wants roughly 990px — and a bar that overflows is
 * worse than a tablet tapping the same sheet a phone does.
 *
 * Every toggle carries `data-disclosure` and names its panel with
 * `aria-controls`, which is the whole contract the script at the foot works
 * from — a fourth menu needs no change there.
 *
 * A <noscript> rule shows the mobile sheet at every width and hides the
 * toggles, so with scripting off the whole navigation is still open and usable.
 */
import { Image } from "astro:assets";

import PillarIcon from "./PillarIcon.astro";
import SearchBox from "./SearchBox.astro";
import ToolIcon from "./ToolIcon.astro";
import { PRIMARY_NAV, PILLAR_NAV, getAllToolLinks, isCurrentSection } from "@/config/navigation";
import { getPillarPresentation } from "@/config/pillars";
import { BRAND_LOGO } from "@/config/media";
import { getPage } from "@/config/pages";
import { SITE } from "@/config/site";
import { getPublishedEntries } from "@/lib/content";

interface Props {
  /** Pathname of the current page, used to mark the active nav item. */
  currentPath: string;
}

const { currentPath } = Astro.props;

/** Wordmark: first word plain, the rest in the brand colour. */
const [brandLead, ...brandTail] = SITE.name.split(" ");

/** Intrinsic ratio of the trimmed mark, so the width never has to be guessed. */
const logoWidth = Math.round(
  (BRAND_LOGO.src.width / BRAND_LOGO.src.height) * BRAND_LOGO.headerHeight,
);

const [publishedPillars, publishedTools] = await Promise.all([
  getPublishedEntries("pillars"),
  getPublishedEntries("tools"),
]);

const publishedPillarIds = new Set(publishedPillars.map(({ page }) => page.id));

/** Menu rows for every published pillar, in PILLAR_NAV order. */
const categories = PILLAR_NAV.filter((entry) => publishedPillarIds.has(entry.pillar)).map(
  (entry) => {
    const page = getPage(entry.pillar);
    const { menu, icon } = getPillarPresentation(entry.pillar);
    return { title: page.title, href: page.path, description: menu, icon };
  },
);

const tools = getAllToolLinks(new Set(publishedTools.map(({ page }) => page.id)));
const blogPath = getPage("blog").path;

/** A menu button is "in section" on any page the menu links to, or below one. */
const inCategories = categories.some(({ href }) => currentPath.startsWith(href));
const inTools = tools.some(({ href }) => currentPath === href);

/**
 * One shape for every item in the desktop bar — a pill the width of its label,
 * so the row reads as a set of controls rather than a line of raw links. The
 * two states are kept in separate strings on purpose: an open menu and a
 * current section both want a filled pill, and letting one class list carry
 * both backgrounds leaves which one wins up to the order Tailwind happens to
 * emit them in.
 */
const navPill =
  "relative inline-flex min-h-9 items-center gap-1.5 rounded-full px-3.5 transition-colors duration-180 ease-ui motion-reduce:transition-none";
const navPillRest =
  "text-ink-600 hover:bg-ink-100 hover:text-ink-900 aria-expanded:bg-ink-100 aria-expanded:text-ink-900";
const navPillHere = "bg-brand-50 text-brand-800 ring-1 ring-brand-100 ring-inset";

/**
 * Hairline between the two menus and the three plain links, drawn as a
 * pseudo-element on the first link so the list holds no empty <li>.
 */
const navDivider =
  "relative ml-2.5 pl-2.5 before:absolute before:top-1/2 before:left-0 before:h-5 before:w-px before:-translate-y-1/2 before:bg-ink-200";
---

<header
  class="sticky top-0 z-50 border-b border-ink-200/80 bg-paper/85 backdrop-blur-md transition-shadow duration-180 ease-ui data-[scrolled]:border-ink-200 data-[scrolled]:shadow-header supports-[backdrop-filter]:bg-paper/75 motion-reduce:transition-none"
  data-site-header
>
  <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3 sm:px-6 lg:gap-6">
    <a
      href="/"
      class="group flex shrink-0 items-center gap-2.5 py-1"
      aria-current={currentPath === "/" ? "page" : undefined}
    >
      {/*
        The image carries the brand's accessible name (BRAND_LOGO.alt) and the
        wordmark below is marked aria-hidden, so this link announces the brand
        once rather than twice. The wordmark stays visible and stays in the DOM.
      */}
      <Image
        src={BRAND_LOGO.src}
        alt={BRAND_LOGO.alt}
        width={logoWidth}
        height={BRAND_LOGO.headerHeight}
        densities={[1, 2]}
        loading="eager"
        decoding="sync"
        class="h-7 w-auto shrink-0 sm:h-[30px]"
      />
      <span
        aria-hidden="true"
        class="font-display text-[1.0625rem] font-extrabold tracking-[-0.01em] text-ink-900 transition-colors duration-180 ease-ui group-hover:text-brand-800 sm:text-lg motion-reduce:transition-none"
      >
        {brandLead} <span class="text-brand-700">{brandTail.join(" ")}</span>
      </span>
    </a>

    {/* Desktop navigation. */}
    <nav aria-label="Main" class="max-lg:hidden">
      <ul class="flex items-center gap-x-0.5 text-[0.9375rem] font-medium">
        <li>
          <button
            type="button"
            aria-expanded="false"
            aria-controls="categories-menu"
            class:list={["group", navPill, inCategories ? navPillHere : navPillRest]}
            data-disclosure
          >
            Categories
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="size-4 text-ink-400 transition-transform duration-180 ease-ui group-aria-expanded:rotate-180 motion-reduce:transition-none"
            >
              <path
                fill-rule="evenodd"
                d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        </li>

        {/*
          Tools, beside Categories rather than inside it. The two calculators
          are the only things on the site a visitor uses rather than reads, so
          they get a name in the bar — and the panel is anchored to this button
          rather than to the header, because a two-item menu stretched across
          the viewport reads as a mistake.
        */}
        {tools.length > 0 && (
          <li class="relative">
            <button
              type="button"
              aria-expanded="false"
              aria-controls="tools-menu"
              class:list={["group", navPill, inTools ? navPillHere : navPillRest]}
              data-disclosure
            >
              Tools
              <span
                aria-hidden="true"
                class="rounded-full bg-accent-50 px-1.5 py-0.5 font-mono text-[0.625rem] leading-none font-semibold tracking-[0.04em] text-accent-700 tabular-nums"
              >
                {tools.length}
              </span>
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="size-4 text-ink-400 transition-transform duration-180 ease-ui group-aria-expanded:rotate-180 motion-reduce:transition-none"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>

            {/* ---- Tools dropdown ------------------------------------- */}
            <div id="tools-menu" hidden class="absolute top-full left-0 pt-2.5">
              <div class="w-[25rem] overflow-hidden rounded-panel border border-ink-200 bg-surface shadow-menu">
                <p class="eyebrow eyebrow-accent px-4 pt-4">Free tools</p>
                <ul class="space-y-1.5 p-3 pt-3.5">
                  {tools.map((tool) => (
                    <li>
                      <a
                        href={tool.href}
                        aria-current={currentPath === tool.href ? "page" : undefined}
                        class="group flex gap-3.5 rounded-xl border border-transparent p-3 transition-colors duration-180 ease-ui hover:border-accent-200 hover:bg-accent-50 aria-[current=page]:border-accent-200 aria-[current=page]:bg-accent-50 motion-reduce:transition-none"
                      >
                        <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border border-ink-200 bg-paper text-accent-700 transition-colors duration-180 ease-ui group-hover:border-accent-200 motion-reduce:transition-none">
                          <ToolIcon icon={tool.icon} class="size-5" />
                        </span>
                        <span class="min-w-0">
                          <span class="flex items-center gap-1.5 font-sans text-[0.9375rem] font-bold text-ink-900 group-hover:text-accent-800">
                            {tool.label}
                            <svg
                              aria-hidden="true"
                              viewBox="0 0 20 20"
                              fill="currentColor"
                              class="size-3.5 shrink-0 text-ink-400 transition-transform duration-180 ease-ui group-hover:translate-x-0.5 group-hover:text-accent-700 motion-reduce:transition-none"
                            >
                              <path
                                fill-rule="evenodd"
                                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                                clip-rule="evenodd"
                              />
                            </svg>
                          </span>
                          {tool.blurb && (
                            <span class="mt-0.5 block text-[0.8125rem] leading-snug text-ink-500">
                              {tool.blurb}
                            </span>
                          )}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
                {/*
                  Not a marketing line: neither calculator has a <form>, a
                  fetch, or an analytics hook on its values — see the contract
                  at the head of each component.
                */}
                <p class="border-t border-ink-200 px-4 py-3 text-[0.8125rem] leading-snug text-ink-500">
                  No sign-up, and your figures never leave the browser.
                </p>
              </div>
            </div>
          </li>
        )}

        {PRIMARY_NAV.map((entry, index) => {
          const isCurrent = currentPath === entry.href;
          const inSection = isCurrentSection(entry, currentPath);
          return (
            <li
              data-nav-divider={index === 0 ? "" : undefined}
              class:list={[index === 0 && navDivider]}
            >
              <a
                href={entry.href}
                aria-current={isCurrent ? "page" : undefined}
                class:list={[navPill, inSection ? navPillHere : navPillRest]}
              >
                {entry.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    {/* Search fills the remaining width at desktop and is capped so it never dominates. */}
    <div class="ml-auto hidden w-full max-w-xs lg:block lg:max-w-sm">
      <SearchBox
        id="header"
        label="Search guides and tools"
        placeholder="Search guides, tools..."
      />
    </div>

    <button
      type="button"
      class="group -mr-2 ml-auto inline-flex size-11 shrink-0 items-center justify-center rounded-full text-ink-700 transition-colors duration-180 ease-ui hover:bg-ink-100 hover:text-brand-700 aria-expanded:bg-ink-100 aria-expanded:text-brand-700 lg:hidden motion-reduce:transition-none"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-disclosure
    >
      <span class="sr-only">Menu</span>
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="size-6 group-aria-expanded:hidden"
      >
        <path
          fill-rule="evenodd"
          d="M2 5.75A.75.75 0 0 1 2.75 5h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 5.75Zm0 4.25a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 10Zm0 4.25a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z"
          clip-rule="evenodd"
        />
      </svg>
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="hidden size-6 group-aria-expanded:block"
      >
        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
      </svg>
    </button>
  </div>

  {/* ---- Desktop categories menu ------------------------------------- */}
  <div id="categories-menu" hidden class="absolute inset-x-0 top-full max-lg:hidden">
    <div class="border-b border-ink-200 bg-surface shadow-menu">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
        <p class="eyebrow eyebrow-rule">Browse by category</p>
        <ul class="mt-5 grid gap-1.5 sm:grid-cols-2 xl:grid-cols-3">
          {categories.map((category) => (
            <li>
              <a
                href={category.href}
                aria-current={currentPath === category.href ? "page" : undefined}
                class="group flex gap-3.5 rounded-xl border border-transparent p-3 transition-colors duration-180 ease-ui hover:border-brand-100 hover:bg-brand-50 aria-[current=page]:border-brand-100 aria-[current=page]:bg-brand-50 motion-reduce:transition-none"
              >
                <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border border-ink-200 bg-paper text-brand-700 transition-colors duration-180 ease-ui group-hover:border-brand-200 group-hover:bg-surface motion-reduce:transition-none">
                  <PillarIcon icon={category.icon} class="size-5" />
                </span>
                <span class="min-w-0">
                  <span class="block font-sans text-[0.9375rem] font-bold text-ink-900 group-hover:text-brand-800">
                    {category.title}
                  </span>
                  <span class="mt-0.5 block text-[0.8125rem] leading-snug text-ink-500">
                    {category.description}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-6 border-t border-ink-200 pt-4">
          <a
            href={blogPath}
            class="inline-flex items-center gap-1.5 py-1.5 font-sans text-sm font-bold text-brand-700 transition-colors duration-180 ease-ui hover:text-brand-800 motion-reduce:transition-none"
          >
            Browse every guide
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  {/* ---- Small-screen sheet ------------------------------------------ */}
  <div id="mobile-menu" hidden class="border-t border-ink-200 bg-surface lg:hidden">
    <div class="mx-auto max-w-7xl space-y-6 px-4 py-5 sm:px-6">
      <SearchBox id="menu" label="Search guides and tools" placeholder="Search guides, tools..." />

      <nav aria-label="Categories">
        <p class="eyebrow">Categories</p>
        <ul class="mt-3 grid gap-1 sm:grid-cols-2">
          {categories.map((category) => (
            <li>
              <a
                href={category.href}
                aria-current={currentPath === category.href ? "page" : undefined}
                class="flex min-h-12 items-center gap-3 rounded-xl px-2.5 py-2 hover:bg-brand-50 aria-[current=page]:bg-brand-50"
              >
                <span class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-ink-200 bg-paper text-brand-700">
                  <PillarIcon icon={category.icon} class="size-5" />
                </span>
                <span class="font-sans text-[0.9375rem] font-bold text-ink-900">
                  {category.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {tools.length > 0 && (
        <nav aria-label="Free tools">
          <p class="eyebrow eyebrow-accent">Free tools</p>
          <ul class="mt-3 space-y-1.5">
            {tools.map((tool) => (
              <li>
                <a
                  href={tool.href}
                  aria-current={currentPath === tool.href ? "page" : undefined}
                  class="flex items-start gap-3 rounded-xl border border-ink-200 bg-paper p-3 hover:border-accent-200 hover:bg-accent-50 aria-[current=page]:border-accent-200 aria-[current=page]:bg-accent-50"
                >
                  <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border border-ink-200 bg-surface text-accent-700">
                    <ToolIcon icon={tool.icon} class="size-5" />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-sans text-[0.9375rem] font-bold text-ink-900">
                      {tool.label}
                    </span>
                    {tool.blurb && (
                      <span class="mt-0.5 block text-[0.8125rem] leading-snug text-ink-500">
                        {tool.blurb}
                      </span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <nav aria-label="More">
        <ul class="flex flex-col border-t border-ink-200 pt-4">
          {PRIMARY_NAV.map((entry) => {
            const inSection = isCurrentSection(entry, currentPath);
            return (
              <li>
                <a
                  href={entry.href}
                  aria-current={currentPath === entry.href ? "page" : undefined}
                  class:list={[
                    "flex min-h-12 items-center rounded-lg px-2.5 font-medium hover:bg-ink-50",
                    inSection ? "text-brand-700" : "text-ink-700",
                  ]}
                >
                  {entry.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </div>
  </div>

  {/*
    With scripting off no toggle can open anything, so show the sheet at every
    width — it carries every link the desktop menus hold.
  */}
  <noscript>
    <style>
      #mobile-menu {
        display: block !important;
      }
      [data-disclosure] {
        display: none !important;
      }
      /* Both menu buttons are gone, so the rule that separated them has nothing
         left to separate. */
      [data-nav-divider]::before {
        display: none !important;
      }
    </style>
  </noscript>
</header>

<script>
  /**
   * Header disclosure behaviour, for however many menus the markup declares:
   * every `[data-disclosure]` button is paired with the panel its
   * `aria-controls` names. Both are plain `hidden` toggles, so the markup is
   * identical with and without scripting and nothing reflows when the script
   * runs.
   */
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  interface Disclosure {
    button: HTMLButtonElement;
    panel: HTMLElement;
    isOpen: () => boolean;
    setOpen: (open: boolean) => void;
  }

  const panels: Disclosure[] = [];

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-disclosure]")) {
    const id = button.getAttribute("aria-controls");
    const panel = id ? document.getElementById(id) : null;
    if (!panel) continue;

    const isOpen = () => button.getAttribute("aria-expanded") === "true";

    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
    };

    panels.push({ button, panel, isOpen, setOpen });
  }

  /** Only one panel is ever open: opening any one closes the rest. */
  for (const disclosure of panels) {
    disclosure.button.addEventListener("click", () => {
      const open = !disclosure.isOpen();
      for (const other of panels) {
        if (other !== disclosure) other.setOpen(false);
      }
      disclosure.setOpen(open);
    });
  }

  const closeAll = (restoreFocus = false) => {
    for (const disclosure of panels) {
      if (!disclosure.isOpen()) continue;
      const hadFocus = disclosure.panel.contains(document.activeElement);
      disclosure.setOpen(false);
      if (restoreFocus && hadFocus) disclosure.button.focus();
    }
  };

  /** True when the event came from inside any toggle or any panel. */
  const isInside = (target: Node) =>
    panels.some(({ button, panel }) => button.contains(target) || panel.contains(target));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeAll(true);
  });

  document.addEventListener("click", (event) => {
    // Each button's own handler owns its state; don't undo it on the way up.
    if (isInside(event.target as Node)) return;
    closeAll();
  });

  document.addEventListener("focusin", (event) => {
    if (isInside(event.target as Node)) return;
    closeAll();
  });

  /** Crossing the lg breakpoint invalidates whichever panel was open. */
  window.matchMedia("(min-width: 64rem)").addEventListener("change", () => closeAll());

  /** Pages restored from the back/forward cache must not reappear with a menu open. */
  window.addEventListener("pageshow", () => closeAll());

  /**
   * A hairline shadow once the page has scrolled, so the sticky bar separates
   * from the content under it.
   *
   * The write is gated behind requestAnimationFrame rather than run straight
   * off the event, as in TableOfContents.astro: a wheel or trackpad gesture
   * fires scroll far more often than the screen refreshes, and this handler
   * touches an element that carries a backdrop-filter — so an un-gated write
   * asks the compositor to re-blur the bar several times inside one frame, for
   * one attribute that can only have changed once. Gated, it is at most one
   * style write per frame, and only when the state actually flips.
   */
  if (header) {
    let queued = false;

    const update = () => {
      queued = false;
      const scrolled = window.scrollY > 4;
      if (scrolled === header.hasAttribute("data-scrolled")) return;
      if (scrolled) header.setAttribute("data-scrolled", "");
      else header.removeAttribute("data-scrolled");
    };

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", schedule, { passive: true });
  }
</script>
