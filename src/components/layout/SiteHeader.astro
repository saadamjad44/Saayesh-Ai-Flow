---
/**
 * Site header: the brand lockup and five primary links. Topic navigation moved
 * out of here — pillars are reached through /blog/, the footer, the homepage
 * cards, and the contextual sidebar on every pillar and article page — so there
 * are no dropdowns left to manage and every link is a plain, crawlable <a>.
 *
 * Below `md` the nav collapses behind a menu button; the markup is the same
 * list at every width, with no second copy of the links for mobile. A
 * <noscript> rule re-shows the nav when scripting is off, so a no-JS visitor
 * still gets every link.
 */
import { Image } from "astro:assets";

import { PRIMARY_NAV, isCurrentSection } from "@/config/navigation";
import { BRAND_LOGO } from "@/config/media";
import { SITE } from "@/config/site";

interface Props {
  /** Pathname of the current page, used to mark the active nav item. */
  currentPath: string;
}

const { currentPath } = Astro.props;

/** Wordmark: first word plain, the rest in the brand colour. */
const [brandLead, ...brandTail] = SITE.name.split(" ");

/** Intrinsic ratio of the trimmed mark, so the width never has to be guessed. */
const logoWidth = Math.round(
  (BRAND_LOGO.src.width / BRAND_LOGO.src.height) * BRAND_LOGO.headerHeight,
);
---

<header class="sticky top-0 z-50 border-b border-ink-200 bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/75">
  <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-2.5 sm:px-6 md:flex-row md:items-center md:justify-between md:gap-6">
    {/* `md:contents` dissolves this row at desktop, leaving the logo + nav layout. */}
    <div class="flex items-center justify-between gap-3 md:contents">
      <a
        href="/"
        class="group flex items-center gap-2.5 self-start py-1 md:self-auto"
        aria-current={currentPath === "/" ? "page" : undefined}
      >
        {/*
          Decorative: the wordmark beside it already names the brand, so the
          link's accessible name is correct without the image repeating it.
        */}
        <Image
          src={BRAND_LOGO.src}
          alt={BRAND_LOGO.alt}
          width={logoWidth}
          height={BRAND_LOGO.headerHeight}
          densities={[1, 2]}
          loading="eager"
          decoding="sync"
          class="h-7 w-auto shrink-0 sm:h-[30px]"
        />
        <span class="text-lg font-extrabold tracking-display text-ink-900 group-hover:text-brand-700">
          {brandLead}{" "}
          <span class="text-brand-700 group-hover:text-brand-800">{brandTail.join(" ")}</span>
        </span>
      </a>

      <button
        type="button"
        class="group -mr-2 inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-ink-700 hover:bg-ink-100 hover:text-brand-700 md:hidden"
        aria-expanded="false"
        aria-controls="primary-nav"
        data-nav-burger
      >
        <span class="sr-only">Menu</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="size-6 group-aria-expanded:hidden"
        >
          <path
            fill-rule="evenodd"
            d="M2 5.75A.75.75 0 0 1 2.75 5h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 5.75Zm0 4.25a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 10Zm0 4.25a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z"
            clip-rule="evenodd"
          />
        </svg>
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="hidden size-6 group-aria-expanded:block"
        >
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
        </svg>
      </button>
    </div>

    {/* Hidden below `md` until the menu button opens it; always shown at `md`+. */}
    <nav id="primary-nav" aria-label="Main" class="max-md:hidden" data-primary-nav>
      <ul class="-mx-3 flex items-center gap-x-1 text-sm font-medium max-md:flex-col max-md:items-stretch max-md:pb-1">
        {PRIMARY_NAV.map((entry) => {
          const isCurrent = currentPath === entry.href;
          const inSection = isCurrentSection(entry, currentPath);
          return (
            <li>
              <a
                href={entry.href}
                aria-current={isCurrent ? "page" : undefined}
                class:list={[
                  "relative inline-flex min-h-11 items-center rounded-lg px-3 hover:bg-ink-100 hover:text-brand-700 max-md:w-full",
                  inSection ? "text-brand-700" : "text-ink-700",
                  inSection &&
                    "after:absolute after:inset-x-3 after:bottom-1.5 after:h-0.5 after:rounded-full after:bg-brand-600 max-md:after:hidden",
                ]}
              >
                {entry.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>

  {/* With scripting off the menu button can't open anything, so show the nav. */}
  <noscript>
    <style>
      [data-primary-nav] {
        display: block !important;
      }
      [data-nav-burger] {
        display: none !important;
      }
    </style>
  </noscript>
</header>

<script>
  // Mobile menu button. `max-md:hidden` is inert at desktop, so the same class
  // toggle collapses the nav on small screens and does nothing on large ones.
  const burger = document.querySelector<HTMLButtonElement>("[data-nav-burger]");
  const primaryNav = document.querySelector<HTMLElement>("[data-primary-nav]");

  const isMenuOpen = () => burger?.getAttribute("aria-expanded") === "true";

  function setMenuOpen(open: boolean) {
    if (!burger || !primaryNav) return;
    burger.setAttribute("aria-expanded", String(open));
    primaryNav.classList.toggle("max-md:hidden", !open);
  }

  burger?.addEventListener("click", () => setMenuOpen(!isMenuOpen()));

  // Leaving mobile width: drop the collapsed state so returning to it starts closed.
  window.matchMedia("(min-width: 48rem)").addEventListener("change", (event) => {
    if (event.matches) setMenuOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !isMenuOpen()) return;
    const hadFocus = primaryNav?.contains(document.activeElement);
    setMenuOpen(false);
    if (hadFocus) burger?.focus();
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    // The button's own handler owns its state; don't undo it on the way up.
    if (burger?.contains(target) || primaryNav?.contains(target)) return;
    setMenuOpen(false);
  });

  // Pages restored from the back/forward cache must not reappear with a menu open.
  window.addEventListener("pageshow", () => setMenuOpen(false));
</script>
