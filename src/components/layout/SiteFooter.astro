---
/**
 * Site footer: crawlable links to every live Phase 1 pillar and company page,
 * plus the affiliate disclosure one-liner. No email opt-in in Phase 1.
 */
import { FOOTER_NAV } from "@/config/navigation";
import { getPage } from "@/config/pages";
import { SITE } from "@/config/site";

const year = new Date().getFullYear();
const disclosurePath = getPage("affiliate-disclosure").path;
---

<footer class="mt-auto border-t border-slate-200 bg-slate-50 text-sm text-slate-600">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
    <div>
      <p class="text-base font-bold text-slate-900">{SITE.name}</p>
      <p class="mt-2">{SITE.tagline}</p>
    </div>

    {FOOTER_NAV.map(({ heading, links }) => (
      <nav aria-label={heading}>
        <h2 class="font-semibold text-slate-900">{heading}</h2>
        <ul class="mt-3 space-y-2">
          {links.map(({ label, href }) => (
            <li>
              <a href={href} class="hover:text-indigo-700 hover:underline">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-t border-slate-200">
    <div class="mx-auto max-w-6xl space-y-2 px-4 py-6 sm:px-6">
      <p>
        Some links on this site may be affiliate links. If you buy through them, we may earn a
        commission at no extra cost to you.{" "}
        <a href={disclosurePath} class="text-indigo-700 underline hover:text-indigo-900">
          Read our affiliate disclosure
        </a>
      </p>
      <p>
        &copy; {year} {SITE.name}
      </p>
    </div>
  </div>
</footer>
