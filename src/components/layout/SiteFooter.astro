---
/**
 * Site footer: the brand, crawlable links to every live pillar, guide index,
 * free tool, company and legal page, and the affiliate disclosure one-liner.
 *
 * The link groups come from FOOTER_NAV, so the footer cannot fall behind the
 * page registry. No email opt-in and no form of any kind: the site has none.
 *
 * The group labels are deliberately not headings — see the comment on them.
 */
import { Image } from "astro:assets";

import { FOOTER_NAV } from "@/config/navigation";
import { BRAND_LOGO } from "@/config/media";
import { getPage } from "@/config/pages";
import { SITE } from "@/config/site";
import { AUTHOR } from "@/config/author";

const year = new Date().getFullYear();
const disclosurePath = getPage("affiliate-disclosure").path;
const aboutPath = getPage("about").path;
const blogPath = getPage("blog").path;

const logoWidth = Math.round((BRAND_LOGO.src.width / BRAND_LOGO.src.height) * 32);
---

{/*
  Dark in both themes. `theme-dark` re-resolves every colour token inside the
  footer against the dark palette, so nothing below needs a dark variant of its
  own — see "Dark palette" in global.css.
*/}
<footer class="relative mt-auto overflow-hidden border-t border-[#2f2504]/15 bg-white">
  <div aria-hidden="true" class="h-[3px] bg-[#ff7733]"></div>

  <div class="relative mx-auto max-w-7xl px-4 pt-14 pb-14 sm:px-6 sm:pt-16 sm:pb-16">
    {/*
      One last route in, for a reader who reached the foot of a page without
      finding the next thing to read. It points at the archive, which lists
      every published guide — a page that already exists, not a new claim.
    */}
    <div class="mb-12 flex flex-col gap-5 border-b border-ink-200 pb-12 sm:mb-14 sm:flex-row sm:items-center sm:justify-between sm:pb-14">
      <p class="max-w-xl font-display text-2xl font-bold tracking-[-0.03em] text-balance text-ink-900 sm:text-[1.75rem]">
        Still deciding which AI tool is worth paying for?
      </p>
      <a href={blogPath} class="btn btn-primary shrink-0">
        Browse every guide
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
          <path
            fill-rule="evenodd"
            d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
            clip-rule="evenodd"
          />
        </svg>
      </a>
    </div>

    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[minmax(0,1.15fr)_repeat(4,minmax(0,1fr))] lg:gap-8">
      {/* Brand column */}
      <div class="md:col-span-2 lg:col-span-1">
        <a href="/" class="group inline-flex items-center gap-2.5">
          <Image
            src={BRAND_LOGO.src}
            alt={BRAND_LOGO.alt}
            width={logoWidth}
            height={32}
            densities={[1, 2]}
            loading="lazy"
            decoding="async"
            class="site-logo h-8 w-auto shrink-0"
          />
          {/*
            aria-hidden for the same reason as in the header: the logo image
            beside it now carries the brand's accessible name, and announcing
            both would say "Saayesh AI Flow logo Saayesh AI Flow" on one link.
          */}
          <span
            aria-hidden="true"
            class="font-display text-xl font-bold tracking-[-0.03em] text-ink-900"
          >
            {SITE.name.split(" ")[0]}{" "}
            <span class="text-gradient">{SITE.name.split(" ").slice(1).join(" ")}</span>
          </span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-600">
          Research-based guides to AI tools, prompts, and automation workflows for solopreneurs,
          freelancers, and small business owners. Written and researched by{" "}
          <a
            href={AUTHOR.path}
            class="font-medium text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-800 hover:decoration-current"
          >
            {AUTHOR.name}
          </a>
          .
        </p>
        <p class="mt-4 text-sm leading-relaxed text-ink-500">
          Guides state when prices were last checked, and say so when a tool has not been hands-on
          tested.{" "}
          <a
            href={aboutPath}
            class="font-medium text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-800 hover:decoration-current"
          >
            How we work
          </a>
        </p>
      </div>

      {/*
        The group labels are <p>, not <h2>.

        They were headings, which put four of them — Categories, Guides &
        tools, About, Legal — into the heading outline of all 58 pages, as
        siblings of the real <h2>s in the content above. On the homepage that
        meant a crawler parsing the page structure found four top-level
        sections at the end that are navigation, not content, and on a guide it
        put four more <h2>s after the FAQ.

        Nothing is lost by demoting them. Each group is already a landmark with
        an accessible name, from the <nav aria-label> around it, which is how a
        screen reader reaches footer navigation; the heading was a second,
        weaker label for the same thing.
      */}
      {FOOTER_NAV.map(({ heading, links }) => (
        <nav aria-label={heading}>
          <p class="eyebrow">{heading}</p>
          <ul class="mt-4 space-y-0.5 text-sm">
            {links.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="-mx-2 inline-block rounded px-2 py-1.5 text-ink-600 transition-colors duration-180 ease-ui hover:text-brand-700 motion-reduce:transition-none"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <p
    aria-hidden="true"
    class="text-gradient pointer-events-none relative -mb-[0.18em] overflow-hidden px-4 text-center font-display text-[17vw] leading-[0.85] font-bold tracking-[-0.06em] whitespace-nowrap opacity-25 select-none"
  >
    {SITE.name}
  </p>

  <div class="relative border-t border-ink-200">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 text-sm sm:px-6 md:flex-row-reverse md:items-center md:justify-between">
      <p class="max-w-2xl text-ink-500">
        Some links on this site may be affiliate links. If you buy through them, we may earn a
        commission at no extra cost to you.{" "}
        <a
          href={disclosurePath}
          class="font-medium text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-800 hover:decoration-current"
        >
          Read our affiliate disclosure
        </a>
      </p>
      <p class="shrink-0 font-mono text-xs text-ink-500">
        &copy; {year} {SITE.name}
      </p>
    </div>
  </div>
</footer>
