---
/**
 * Visible breadcrumb trail, rendered inside a page's own header so it lines up
 * with that page's measured column rather than with a container of its own.
 * The matching BreadcrumbList JSON-LD is emitted in <head> by BaseLayout from
 * the same items, so the two can never disagree.
 *
 * On a phone the trail is a single scrollable row: wrapping a four-level trail
 * over three lines pushed the <h1> down the screen for no benefit, and the last
 * crumb is the page you are already on.
 */
import type { BreadcrumbItem } from "@/lib/seo";

interface Props {
  items: readonly BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

{items.length > 1 && (
  <nav aria-label="Breadcrumb" class:list={["-mx-4 px-4 sm:mx-0 sm:px-0", className]}>
    <ol class="flex items-center gap-x-1 overflow-x-auto font-mono text-[0.6875rem] tracking-[0.04em] whitespace-nowrap text-ink-500 uppercase [scrollbar-width:none] sm:flex-wrap sm:whitespace-normal [&::-webkit-scrollbar]:hidden">
      {items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="flex min-w-0 items-center gap-1">
            {isLast ? (
              <span aria-current="page" class="font-medium text-ink-700">
                {item.label}
              </span>
            ) : (
              <>
                <a
                  href={item.path}
                  class="-mx-1 rounded px-1 py-1 transition-colors duration-180 ease-ui hover:text-brand-700 motion-reduce:transition-none"
                >
                  {item.label}
                </a>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="size-3 shrink-0 text-ink-300"
                >
                  <path
                    fill-rule="evenodd"
                    d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}
