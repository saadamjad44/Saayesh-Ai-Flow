---
/**
 * Visible breadcrumb trail. The matching BreadcrumbList JSON-LD is emitted
 * in <head> by the layout from the same items.
 */
import type { BreadcrumbItem } from "@/lib/seo";

interface Props {
  items: readonly BreadcrumbItem[];
}

const { items } = Astro.props;
---

{items.length > 1 && (
  <nav aria-label="Breadcrumb" class="mx-auto w-full max-w-6xl px-4 pt-6 text-sm sm:px-6">
    <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-ink-500">
      {items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="flex min-w-0 items-center gap-1.5">
            {isLast ? (
              <span aria-current="page" class="truncate font-medium text-ink-800">
                {item.label}
              </span>
            ) : (
              <>
                <a
                  href={item.path}
                  class="-mx-1.5 rounded px-1.5 py-1 hover:text-brand-700 hover:underline"
                >
                  {item.label}
                </a>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="size-3.5 text-ink-300"
                >
                  <path
                    fill-rule="evenodd"
                    d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}
