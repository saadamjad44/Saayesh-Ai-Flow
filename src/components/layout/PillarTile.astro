---
/**
 * A category's glyph on its own coloured tile.
 *
 * Each category owns a hue (see `.tile-*` in global.css), so the header menu,
 * the homepage grid, the archive chips and a hub's own header all show the same
 * category as the same coloured square. Before this component each of those
 * surfaces drew its own grey bordered box around the glyph, which made eight
 * categories look like one.
 *
 * Decorative, like the glyph inside it: the category name is always beside it.
 */
import PillarIcon from "./PillarIcon.astro";
import type { PillarIconId } from "@/config/pillars";

interface Props {
  icon: PillarIconId;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { icon, size = "md", class: className } = Astro.props;

/** Box and glyph sizes per step, kept together so they cannot drift apart. */
const SIZES = {
  sm: { box: "size-8 rounded-[0.625rem]", glyph: "size-4.5" },
  md: { box: "size-10", glyph: "size-5" },
  lg: { box: "size-12 rounded-2xl", glyph: "size-6" },
} as const;
---

<span class:list={["tile", `tile-${icon}`, SIZES[size].box, className]}>
  <PillarIcon icon={icon} class={SIZES[size].glyph} />
</span>
