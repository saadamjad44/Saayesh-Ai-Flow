---
/**
 * Contextual category navigation for pillar, article, and tool pages: the
 * current category and its articles, its free tools, then the other categories.
 * Content comes from getContentSidebar(), which reads the page registry and the
 * MDX collections — no page lists anything itself.
 *
 * At `lg` and up it sits in the sticky rail PageLayout provides, under the
 * table of contents. Below `lg` it collapses to an accordion above the article
 * body, closed by default so it never pushes the content a visitor came for off
 * the screen. The toggle is a real button with aria-expanded / aria-controls;
 * with scripting off the panel is simply shown, since nothing could open it.
 *
 * Every link is a plain <a> at every width — these are internal links, so the
 * crawler sees the same navigation whether or not the accordion is open.
 */
import type { ContentSidebar } from "@/lib/sidebar";

interface Props {
  sidebar: ContentSidebar;
  /** Pathname of the current page, used to mark the active entry. */
  currentPath: string;
}

const { sidebar, currentPath } = Astro.props;
const panelId = "content-sidebar-panel";
---

<nav aria-label={sidebar.label} class="not-prose" data-content-sidebar>
  <button
    type="button"
    class="group flex w-full items-center justify-between gap-3 rounded-xl border border-ink-200 bg-surface px-4 py-3 text-left shadow-card transition-colors duration-180 ease-ui hover:border-ink-300 motion-reduce:transition-none lg:hidden"
    aria-expanded="false"
    aria-controls={panelId}
    data-sidebar-toggle
  >
    <span class="flex items-center gap-2.5">
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="size-4.5 shrink-0 text-brand-700"
      >
        <path
          fill-rule="evenodd"
          d="M3.5 2.75a.75.75 0 0 0-1.5 0v14.5a.75.75 0 0 0 1.5 0v-4.392l1.657-.348a6.449 6.449 0 0 1 4.271.572 7.948 7.948 0 0 0 5.965.524l2.078-.64A.75.75 0 0 0 18 12.25v-8.5a.75.75 0 0 0-.904-.734l-2.38.501a7.25 7.25 0 0 1-4.186-.363l-.502-.2a8.75 8.75 0 0 0-5.053-.439l-1.475.31V2.75Z"
          clip-rule="evenodd"
        ></path>
      </svg>
      <span class="font-display text-sm font-bold text-ink-900">Browse this category</span>
    </span>
    <svg
      aria-hidden="true"
      viewBox="0 0 20 20"
      fill="currentColor"
      class="size-5 shrink-0 text-ink-400 transition-transform duration-180 ease-ui group-aria-expanded:rotate-180 motion-reduce:transition-none"
    >
      <path
        fill-rule="evenodd"
        d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
        clip-rule="evenodd"
      ></path>
    </svg>
  </button>

  <div
    id={panelId}
    class="max-lg:mt-2 max-lg:hidden max-lg:rounded-xl max-lg:border max-lg:border-ink-200 max-lg:bg-surface max-lg:p-4"
    data-sidebar-panel
  >
    {sidebar.sections.map((section, index) => (
      <div class:list={[index > 0 && "mt-7 border-t border-ink-200 pt-6"]}>
        {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}

        <h2
          class:list={["font-display text-sm font-bold text-ink-900", section.eyebrow && "mt-1.5"]}
        >
          {section.headingHref ? (
            <a
              href={section.headingHref}
              aria-current={currentPath === section.headingHref ? "page" : undefined}
              class:list={[
                "transition-colors duration-180 ease-ui hover:text-brand-700 motion-reduce:transition-none",
                currentPath === section.headingHref && "text-brand-700",
              ]}
            >
              {section.heading}
            </a>
          ) : (
            section.heading
          )}
        </h2>

        <ul class="mt-3 space-y-0.5 text-sm">
          {section.links.map((item) => {
            const isCurrent = currentPath === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={[
                    // The left rule reads as a docs tree; the current item fills it in.
                    "-ml-px flex min-h-9 items-center border-l-2 py-1.5 pl-3 leading-snug transition-colors duration-180 ease-ui motion-reduce:transition-none",
                    isCurrent
                      ? "border-brand-600 font-semibold text-brand-700"
                      : "border-ink-200 text-ink-600 hover:border-ink-400 hover:text-brand-700",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>

  {/* Without scripting the toggle can't open the panel, so show it. */}
  <noscript>
    <style>
      [data-sidebar-panel] {
        display: block !important;
      }
      [data-sidebar-toggle] {
        display: none !important;
      }
    </style>
  </noscript>
</nav>

<script>
  // Accordion below `lg`. `max-lg:hidden` is inert at desktop, so the same class
  // toggle collapses the panel on small screens and does nothing on large ones.
  const toggle = document.querySelector<HTMLButtonElement>("[data-sidebar-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-sidebar-panel]");

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("max-lg:hidden", !open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    toggle.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    // Leaving mobile width: drop the collapsed state so returning to it starts closed.
    window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });

    window.addEventListener("pageshow", () => setOpen(false));
  }
</script>
