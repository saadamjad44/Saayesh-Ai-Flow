---
/**
 * AI Email Time Savings & ROI Calculator — the interactive part of
 * /ai-automation/ai-email-time-savings-calculator/.
 *
 * Imported by that page's MDX body, so the calculator sits in the normal
 * content flow and the surrounding editorial copy is authored like any other
 * entry. All arithmetic, validation and formatting live in
 * ./ai-email-savings-calculator.ts, shared with this markup so the inputs'
 * `min`/`max`/`step` attributes and the script's limits cannot drift apart, and
 * checked on every build by ./ai-email-savings-calculator.spec.ts.
 *
 * Privacy, which the page states in writing and this implementation has to
 * guarantee: there is no `<form>` element (so no value can ever be submitted,
 * not even as a query string if scripting fails), no `fetch`, no analytics
 * call, and no `localStorage`, `sessionStorage` or cookie write anywhere in the
 * script below. Every figure stays in the page's own DOM while the tab is open.
 *
 * Honesty rules this component enforces in code, not just in copy:
 *   - a negative result is never given a positive colour (see `toneOf`);
 *   - a zero-cost scenario reports "N/A", never an infinite ROI;
 *   - an unreachable break-even says so instead of printing a huge number;
 *   - every default is an illustrative placeholder, labelled as one on screen.
 */
import {
  CURRENCIES,
  DEFAULT_CURRENCY,
  DEFAULTS,
  SECTIONS,
  type FieldSpec,
} from "./ai-email-savings-calculator";

/** The two figures a visitor came for, shown larger than the rest. */
const HEADLINE_RESULTS = [
  {
    key: "hoursSaved",
    label: "Monthly active hours saved",
    note: "Manual reply time minus AI-assisted human time",
    unit: "hours",
  },
  {
    key: "monthlyNet",
    label: "Monthly net estimated benefit",
    note: "Ongoing. Excludes the one-time setup cost",
    unit: "",
  },
] as const;

/**
 * The remaining reported figures, as a compact table so a narrow results column
 * stays readable. `tone` marks the rows where a negative number must be shown
 * as a caution rather than a gain.
 */
const RESULT_ROWS = [
  {
    key: "grossValue",
    label: "Estimated value of time saved",
    note: "Hours saved x your hourly value",
    tone: true,
  },
  {
    key: "operatingCost",
    label: "Monthly AI operating cost",
    note: "Software plus per-email usage fees",
    tone: false,
  },
  {
    key: "firstMonthNet",
    label: "First-month net benefit",
    note: "Includes the one-time setup cost",
    tone: true,
  },
  {
    key: "firstYearNet",
    label: "First-year net benefit",
    note: "12 months at these assumptions, plus setup",
    tone: true,
  },
  {
    key: "recurringRoi",
    label: "Estimated recurring ROI",
    note: "On the monthly operating cost only",
    tone: true,
  },
  {
    key: "breakEven",
    label: "Break-even eligible emails",
    note: "Per month, to cover the recurring cost",
    tone: false,
  },
] as const;

/** Volume and per-email figures, as a strip above the results. */
const VOLUME_FIGURES = [
  { key: "totalEmails", label: "Emails a month" },
  { key: "eligibleEmails", label: "AI-eligible" },
  { key: "aiMinutesPerEmail", label: "Active min each" },
] as const;

const headingId = "ai-email-savings-calculator";

/** Right padding for a unit suffix sitting inside the input. */
const suffixPadding = (suffix: string | undefined) => {
  if (!suffix) return "pr-3";
  return suffix.length <= 6 ? "pr-14" : "pr-24";
};

const fieldId = (field: FieldSpec) => `ai-email-${field.key}`;
---

<section
  aria-labelledby={headingId}
  class="not-prose my-10 overflow-hidden rounded-panel border border-ink-200 bg-surface shadow-panel"
  data-email-calculator
>
  <div class="border-b border-ink-200 bg-ink-50 px-4 py-5 sm:px-6 sm:py-6">
    <p class="eyebrow eyebrow-accent">Free calculator</p>
    <h2 id={headingId} class="type-section mt-2">
      Estimate your AI email time savings
    </h2>
    <p class="mt-2.5 leading-relaxed text-ink-600">
      Enter your own email workload, review time and costs. Every figure updates as you type — there
      is no Calculate button, no sign-up, and nothing is sent anywhere.
    </p>

    <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
      <p class="flex items-start gap-2 text-sm font-medium text-ink-700">
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="mt-0.5 size-4 shrink-0 text-accent-700"
        >
          <path
            fill-rule="evenodd"
            d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z"
            clip-rule="evenodd"
          />
        </svg>
        <span>Your figures stay in your browser. Nothing you enter is submitted.</span>
      </p>
      <p class="flex items-start gap-2 text-sm font-medium text-ink-700">
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="mt-0.5 size-4 shrink-0 text-ink-500"
        >
          <path
            fill-rule="evenodd"
            d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z"
            clip-rule="evenodd"
          />
        </svg>
        <span>
          The pre-filled values are illustrative placeholders, not industry averages. Replace them
          with your own.
        </span>
      </p>
    </div>

    {/* Live headline, so the figures are visible on a phone before scrolling. */}
    <p
      class="mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-1 rounded-lg border border-ink-200 bg-surface px-3 py-2.5 text-sm font-semibold text-ink-700 lg:hidden"
      data-mobile-summary
    >
      <span class="font-sans tabular-nums" data-result="hoursSaved">
        —
      </span>
      <span class="font-normal text-ink-500">hours saved a month ·</span>
      <span class="font-sans tabular-nums" data-result="monthlyNet">
        —
      </span>
      <span class="font-normal text-ink-500">estimated net benefit</span>
    </p>
  </div>

  {/*
    Deliberately not a <form>: nothing here is ever submitted, and a form would
    put the visitor's figures in a query string if its submit handler ever
    failed to run.
  */}
  <div class="px-4 py-6 sm:px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,19.5rem)] lg:items-start lg:gap-x-8">
    {/* ---- Inputs --------------------------------------------------- */}
    <div class="min-w-0 space-y-7">
      {SECTIONS.map((section, sectionIndex) => (
        <fieldset class:list={[sectionIndex > 0 && "border-t border-ink-200 pt-6"]}>
          <legend class="font-sans text-base font-bold tracking-tight text-ink-900">
            {section.title}
          </legend>
          <p class="mt-1 text-sm text-ink-500">{section.note}</p>

          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {section.fields.map((field) => {
              const id = fieldId(field);
              return (
                <div>
                  {/*
                    The minimum height keeps the two inputs in a row aligned
                    when one label wraps to a second line and the other does not.
                  */}
                  <label for={id} class="block text-sm font-semibold text-ink-900 sm:min-h-10">
                    {field.label}
                  </label>
                  <div class="relative mt-1.5">
                    {field.prefix === "currency" && (
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-sm font-medium text-ink-500"
                        data-currency-symbol
                      >
                        {DEFAULT_CURRENCY.symbol}
                      </span>
                    )}
                    <input
                      id={id}
                      type="number"
                      min={field.min}
                      max={field.max}
                      step={field.step}
                      inputmode={field.integer ? "numeric" : "decimal"}
                      autocomplete="off"
                      value={String(DEFAULTS[field.key])}
                      aria-describedby={`${id}-hint`}
                      class:list={[
                        "block min-h-11 w-full rounded-lg border border-ink-300 bg-surface py-2.5 text-ink-900 tabular-nums transition-colors duration-180 ease-ui hover:border-ink-400 focus:border-brand-500 focus:outline-none aria-[invalid=true]:border-red-600 motion-reduce:transition-none",
                        field.prefix === "currency" ? "pl-9" : "pl-3",
                        suffixPadding(field.suffix),
                      ]}
                      data-field={field.key}
                    />
                    {field.suffix && (
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 font-mono text-xs tracking-[0.04em] text-ink-500"
                      >
                        {field.suffix}
                      </span>
                    )}
                  </div>
                  <p id={`${id}-hint`} class="mt-1.5 text-sm text-ink-500">
                    {field.hint}
                  </p>
                  {/* Errors carry an icon and words, never colour alone. */}
                  <p
                    id={`${id}-error`}
                    hidden
                    class="mt-1.5 flex items-start gap-1.5 text-sm font-medium text-red-700"
                    data-field-error={field.key}
                  >
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="mt-0.5 size-4 shrink-0"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.63-1.516 2.63H3.72c-1.347 0-2.189-1.463-1.515-2.63L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span data-error-text>Enter a number.</span>
                  </p>
                </div>
              );
            })}
          </div>
        </fieldset>
      ))}

      <fieldset class="border-t border-ink-200 pt-6">
        <legend class="font-sans text-base font-bold tracking-tight text-ink-900">
          Display currency
        </legend>
        <select
          id="ai-email-currency"
          aria-describedby="ai-email-currency-hint"
          aria-label="Display currency"
          class="mt-3 block min-h-11 w-full max-w-xs rounded-lg border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-brand-500 focus:outline-none"
          data-currency
        >
          {CURRENCIES.map((currency) => (
            <option
              value={currency.code}
              data-symbol={currency.symbol}
              selected={currency.code === DEFAULT_CURRENCY.code}
            >
              {currency.code} ({currency.symbol}) — {currency.label}
            </option>
          ))}
        </select>
        <p id="ai-email-currency-hint" class="mt-2 text-sm text-ink-600">
          <strong class="font-semibold text-ink-900">No currency conversion happens here.</strong>{" "}
          This changes the symbol shown only, so enter every figure in the same currency.
        </p>
      </fieldset>
    </div>

    {/* ---- Results -------------------------------------------------- */}
    <div class="mt-8 min-w-0 rounded-xl border border-ink-200 bg-paper p-4 sm:p-5 lg:mt-0 lg:self-start">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h3 class="type-subsection">Your estimate</h3>
        <p class="font-mono text-[0.625rem] tracking-[0.08em] text-ink-500 uppercase">
          Updates as you type
        </p>
      </div>

      <p
        hidden
        class="mt-3 flex items-start gap-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2.5 text-sm font-medium text-red-800"
        data-invalid-note
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="mt-0.5 size-4 shrink-0"
        >
          <path
            fill-rule="evenodd"
            d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.63-1.516 2.63H3.72c-1.347 0-2.189-1.463-1.515-2.63L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
            clip-rule="evenodd"
          />
        </svg>
        <span data-invalid-note-text></span>
      </p>

      {/* Volume the rest of the figures are built from. */}
      <dl class="mt-4 grid grid-cols-3 gap-2 rounded-lg border border-ink-200 bg-surface px-3 py-2.5">
        {VOLUME_FIGURES.map((figure) => (
          <div class="min-w-0">
            {/* Wraps rather than truncates: a clipped label is not a label. */}
            <dt class="font-mono text-[0.625rem] leading-[1.35] tracking-[0.06em] text-ink-500 uppercase">
              {figure.label}
            </dt>
            <dd
              class="mt-0.5 font-sans text-base font-bold text-ink-900 tabular-nums"
              data-result={figure.key}
            >
              —
            </dd>
          </div>
        ))}
      </dl>

      <dl class="mt-3 space-y-3">
        {HEADLINE_RESULTS.map((result) => (
          <div
            class="rounded-xl border border-ink-200 bg-surface p-4"
            data-result-card={result.key}
          >
            <dt class="text-sm font-semibold text-ink-700">{result.label}</dt>
            <dd>
              <p class="mt-1 flex items-baseline gap-1.5">
                <span
                  class="font-sans text-3xl font-extrabold tracking-[-0.026em] text-ink-900 tabular-nums"
                  data-result={result.key}
                >
                  —
                </span>
                {result.unit && (
                  <span class="text-sm font-semibold text-ink-500">{result.unit}</span>
                )}
              </p>
              <p class="mt-1 text-sm text-ink-500" data-result-note={result.key}>
                {result.note}
              </p>
            </dd>
          </div>
        ))}
      </dl>

      {/*
        Manual against AI-assisted active hours, as two CSS bars. Deliberately
        not a charting library: two lengths need no 50kB of JavaScript. The
        figures are printed beside the bars, so the comparison is complete for
        anyone who cannot see them, and the bars themselves are aria-hidden.
      */}
      <div class="mt-5 border-t border-ink-200 pt-4">
        <h4 class="font-sans text-sm font-bold tracking-tight text-ink-900">
          Active email hours a month
        </h4>
        <dl class="mt-3 space-y-3">
          <div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-sm font-medium text-ink-700">Manual replies</dt>
              <dd class="font-sans text-sm font-bold text-ink-900 tabular-nums">
                <span data-result="manualHours">—</span> h
              </dd>
            </div>
            <div aria-hidden="true" class="mt-1.5 h-2.5 overflow-hidden rounded-full bg-ink-100">
              <div
                class="h-full rounded-full bg-ink-400 transition-[width] duration-180 ease-ui motion-reduce:transition-none"
                style="width: 0%"
                data-bar="manual"
              ></div>
            </div>
          </div>
          <div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-sm font-medium text-ink-700">AI-assisted, with review</dt>
              <dd class="font-sans text-sm font-bold text-ink-900 tabular-nums">
                <span data-result="aiHours">—</span> h
              </dd>
            </div>
            <div aria-hidden="true" class="mt-1.5 h-2.5 overflow-hidden rounded-full bg-ink-100">
              <div
                class="h-full rounded-full bg-accent-600 transition-[width] duration-180 ease-ui motion-reduce:transition-none"
                style="width: 0%"
                data-bar="ai"
              ></div>
            </div>
          </div>
        </dl>
        <p class="mt-2.5 text-sm text-ink-500" data-comparison-note></p>
      </div>

      <dl class="mt-5 divide-y divide-ink-200 border-t border-ink-200">
        {RESULT_ROWS.map((row) => (
          <div class="flex items-start justify-between gap-3 py-2.5">
            <div class="min-w-0">
              <dt class="text-sm font-medium text-ink-800">{row.label}</dt>
              <p class="mt-0.5 text-xs leading-snug text-ink-500" data-result-note={row.key}>
                {row.note}
              </p>
            </div>
            <dd
              class="shrink-0 pt-0.5 text-right font-sans text-sm font-bold text-ink-900 tabular-nums"
              data-result={row.key}
            >
              —
            </dd>
          </div>
        ))}
      </dl>

      <p class="mt-4 rounded-lg border border-ink-200 bg-surface px-3 py-2.5 text-xs leading-relaxed text-ink-600">
        These are estimates from the figures you entered, not a forecast. Time saved only becomes
        money if those hours are spent on work that earns or saves it.
      </p>
    </div>
  </div>

  {/* ---- Actions ----------------------------------------------------- */}
  <div class="flex flex-col gap-3 border-t border-ink-200 px-4 py-5 sm:flex-row sm:flex-wrap sm:items-center sm:px-6">
    <button type="button" class="btn btn-secondary w-full sm:w-auto" data-reset>
      Reset to defaults
    </button>
    <button type="button" class="btn btn-secondary w-full sm:w-auto" hidden data-copy-results>
      Copy results summary
    </button>
    <button type="button" class="btn btn-secondary w-full sm:w-auto" hidden data-copy-link>
      Copy link to this tool
    </button>
    <p class="text-sm text-ink-600 sm:ml-1" role="status" data-copy-status></p>
  </div>

  {/* Concise, debounced announcement of the headline figures for screen readers. */}
  <p role="status" aria-live="polite" class="sr-only" data-announce></p>

  <noscript>
    <p class="border-t border-ink-200 bg-yellow-50 px-4 py-4 text-sm text-yellow-900 sm:px-6">
      This calculator needs JavaScript to work out your figures. Every formula it uses is written
      out in full under “How the calculations work” below, with a worked example, so the same
      estimate can be produced by hand or in a spreadsheet.
    </p>
  </noscript>
</section>

<script>
  /**
   * Calculator behaviour. Reads the DOM, validates, computes with the shared
   * module, and writes the results back. It makes no network request, sends
   * nothing to analytics, and writes to no storage — see the component comment.
   */
  import {
    CURRENCIES,
    DEFAULT_CURRENCY,
    FIELDS,
    computeEmailSavings,
    fieldSpec,
    formatBreakEven,
    formatCount,
    formatHours,
    formatMinutes,
    formatRoi,
    formatSignedMoney,
    parseFieldValue,
    parseInput,
    roiTone,
    toneOf,
    type EmailSavingsResults,
    type FieldKey,
    type Tone,
  } from "./ai-email-savings-calculator";

  const root = document.querySelector<HTMLElement>("[data-email-calculator]");

  const currencyEl = root?.querySelector<HTMLSelectElement>("[data-currency]");
  const resetEl = root?.querySelector<HTMLButtonElement>("[data-reset]");
  const copyResultsEl = root?.querySelector<HTMLButtonElement>("[data-copy-results]");
  const copyLinkEl = root?.querySelector<HTMLButtonElement>("[data-copy-link]");
  const copyStatusEl = root?.querySelector<HTMLElement>("[data-copy-status]");
  const invalidNoteEl = root?.querySelector<HTMLElement>("[data-invalid-note]");
  const invalidTextEl = root?.querySelector<HTMLElement>("[data-invalid-note-text]");
  const comparisonNoteEl = root?.querySelector<HTMLElement>("[data-comparison-note]");
  const announceEl = root?.querySelector<HTMLElement>("[data-announce]");

  if (
    root &&
    currencyEl &&
    resetEl &&
    copyResultsEl &&
    copyLinkEl &&
    copyStatusEl &&
    invalidNoteEl &&
    invalidTextEl &&
    comparisonNoteEl &&
    announceEl
  ) {
    // Re-bound as non-null locals, so the helpers below can close over them.
    const panel: HTMLElement = root;
    const currencySelect: HTMLSelectElement = currencyEl;
    const resetButton: HTMLButtonElement = resetEl;
    const copyResultsButton: HTMLButtonElement = copyResultsEl;
    const copyLinkButton: HTMLButtonElement = copyLinkEl;
    const copyStatus: HTMLElement = copyStatusEl;
    const invalidNote: HTMLElement = invalidNoteEl;
    const invalidText: HTMLElement = invalidTextEl;
    const comparisonNote: HTMLElement = comparisonNoteEl;
    const announce: HTMLElement = announceEl;

    /** Milliseconds of quiet typing before the headline figures are announced. */
    const ANNOUNCE_DELAY_MS = 900;
    /** How long a copy confirmation stays on screen. */
    const COPY_STATUS_MS = 6000;

    let announceTimer: number | undefined;
    let copyTimer: number | undefined;
    /** Last rendered summary, so Copy never re-reads or recomputes the inputs. */
    let summary = "";

    const selectedCurrency = () =>
      CURRENCIES.find((currency) => currency.code === currencySelect.value) ?? DEFAULT_CURRENCY;

    const inputFor = (key: FieldKey) =>
      panel.querySelector<HTMLInputElement>(`[data-field="${key}"]`);

    /**
     * Validates one field, shows or clears its error, and returns the raw text.
     * An invalid entry counts as 0 in the figures and the note above the results
     * says so — silently ignoring it would change a total for no visible reason.
     */
    function readField(key: FieldKey): { raw: string; invalid: boolean } {
      const input = inputFor(key);
      if (!input) return { raw: "", invalid: false };

      /**
       * A number input hands over "" for anything it cannot parse, so text
       * typed into one would otherwise look like a cleared field and silently
       * count as 0. `validity.badInput` is the only way to tell the two apart,
       * and the visitor needs to be told which it was.
       */
      const badInput = input.validity.badInput;
      const parsed = badInput
        ? ({ ok: false, message: "Enter a number." } as const)
        : parseFieldValue(input.value, fieldSpec(key));
      const error = panel.querySelector<HTMLElement>(`[data-field-error="${key}"]`);
      const errorText = error?.querySelector<HTMLElement>("[data-error-text]");
      const hintId = `${input.id}-hint`;

      if (parsed.ok) {
        input.removeAttribute("aria-invalid");
        input.setAttribute("aria-describedby", hintId);
        if (error) error.hidden = true;
        return { raw: input.value, invalid: false };
      }

      input.setAttribute("aria-invalid", "true");
      input.setAttribute("aria-describedby", `${hintId} ${input.id}-error`);
      if (errorText) errorText.textContent = parsed.message;
      if (error) error.hidden = false;
      return { raw: input.value, invalid: true };
    }

    /** Writes a value into every node tagged with this result key. */
    function setResult(key: string, text: string): void {
      for (const node of panel.querySelectorAll<HTMLElement>(`[data-result="${key}"]`)) {
        node.textContent = text;
      }
    }

    function setNote(key: string, text: string): void {
      const node = panel.querySelector<HTMLElement>(`[data-result-note="${key}"]`);
      if (node) node.textContent = text;
    }

    const TONE_TEXT: Record<Tone, string> = {
      positive: "text-accent-800",
      negative: "text-red-700",
      neutral: "text-ink-900",
    };

    const TONE_CARD: Record<Tone, string> = {
      positive: "border-accent-200 bg-accent-50",
      negative: "border-red-200 bg-red-50",
      neutral: "border-ink-200 bg-surface",
    };

    /**
     * Colours a figure by its sign. A loss is never given the positive teal,
     * and colour is never the only signal: the number keeps its minus sign and
     * the note beside it says what the figure means.
     */
    function applyTone(key: string, tone: Tone): void {
      for (const node of panel.querySelectorAll<HTMLElement>(`[data-result="${key}"]`)) {
        node.classList.remove(...Object.values(TONE_TEXT));
        node.classList.add(TONE_TEXT[tone]);
      }
      const card = panel.querySelector<HTMLElement>(`[data-result-card="${key}"]`);
      if (card) {
        for (const classes of Object.values(TONE_CARD)) {
          card.classList.remove(...classes.split(" "));
        }
        card.classList.add(...TONE_CARD[tone].split(" "));
      }
    }

    /** Bar widths: the longer of the two is full width, the other in proportion. */
    function setBars(manualHours: number, aiHours: number): void {
      const longest = Math.max(manualHours, aiHours, 0);
      const width = (value: number) =>
        longest <= 0 ? "0%" : `${Math.min(100, Math.max(0, (value / longest) * 100))}%`;

      const manualBar = panel.querySelector<HTMLElement>('[data-bar="manual"]');
      const aiBar = panel.querySelector<HTMLElement>('[data-bar="ai"]');
      if (manualBar) manualBar.style.width = width(manualHours);
      if (aiBar) aiBar.style.width = width(aiHours);
    }

    /** Plain-text results, for the Copy button. Built from the same figures. */
    function buildSummary(results: EmailSavingsResults, symbol: string, code: string): string {
      const money = (value: number) => formatSignedMoney(value, symbol);
      const entry = (key: FieldKey) => inputFor(key)?.value.trim() || "0";
      const unit = (key: FieldKey) => fieldSpec(key).summaryUnit ?? "";

      const lines = [
        `AI email time savings and ROI estimate (all money in ${code})`,
        "",
        "Your assumptions",
        `- Emails needing a reply: ${entry("emailsPerDay")} ${unit("emailsPerDay")}`,
        `- Working days: ${entry("workingDaysPerMonth")} ${unit("workingDaysPerMonth")}`,
        `- Suitable for AI assistance: ${entry("eligiblePercent")}%`,
        `- Manual reply time: ${entry("manualMinutes")} min per email`,
        `- Human review of an AI draft: ${entry("reviewMinutes")} min per email`,
        `- Prompting and handling: ${entry("handlingMinutes")} min per email`,
        `- Drafts needing correction: ${entry("correctionPercent")}%, at ${entry("correctionMinutes")} min each`,
        `- Value of an hour: ${money(Number(entry("hourlyRate")) || 0)}`,
        `- AI software: ${money(Number(entry("monthlySoftwareCost")) || 0)} per month`,
        `- Usage cost: ${money(Number(entry("usageCostPerEmail")) || 0)} per eligible email`,
        `- One-time setup: ${money(Number(entry("oneTimeSetupCost")) || 0)}`,
        "",
        "Estimated results",
        `- Emails a month: ${formatCount(results.monthlyEmails)}, of which ${formatCount(results.eligibleEmails)} AI-eligible`,
        `- Active human time per AI-assisted email: ${formatMinutes(results.aiMinutesPerEmail)} min`,
        `- Manual active hours a month: ${formatHours(results.manualHours)}`,
        `- AI-assisted active hours a month: ${formatHours(results.aiHours)}`,
        `- Monthly active hours saved: ${formatHours(results.hoursSaved)}`,
        `- Estimated value of time saved: ${money(results.grossMonthlyTimeValue)} a month`,
        `- Monthly AI operating cost: ${money(results.monthlyOperatingCost)}`,
        `- Monthly net estimated benefit: ${money(results.monthlyNetBenefit)}`,
        `- First-month net benefit: ${money(results.firstMonthNetBenefit)}`,
        `- First-year net benefit: ${money(results.firstYearNetBenefit)}`,
        `- Estimated recurring ROI: ${formatRoi(results.recurringRoi)}`,
        `- Break-even eligible emails a month: ${formatBreakEven(results.breakEven)}`,
        "",
        "These are estimates based on the assumptions above, not guaranteed outcomes. The value of",
        "time saved is only realised if those hours go to work that earns or saves money.",
        "",
        `Calculated with ${location.origin}${location.pathname}`,
      ];

      return lines.join("\n");
    }

    function render(): void {
      // readField does the per-field validation UI; parseInput does the same
      // parsing again to build the figures, so the engine is fed by the shared
      // module rather than by a second copy of the rules written here.
      const readings = FIELDS.map((field) => [field.key, readField(field.key)] as const);
      /**
       * A rejected field is handed to parseInput as text it will also reject,
       * so every invalid entry counts as 0 — which is what the note above the
       * results promises. The sentinel matters for the two cases the raw value
       * alone cannot express: a number input hands over "" for unparseable
       * text, and "" otherwise means "cleared", which the day count reads as
       * its default rather than as an error.
       */
      const raw = Object.fromEntries(
        readings.map(([key, reading]) => [key, reading.invalid ? "invalid" : reading.raw]),
      ) as Record<FieldKey, string>;

      const { input } = parseInput(raw);
      const results = computeEmailSavings(input);
      const { symbol, code } = selectedCurrency();
      const money = (value: number) => formatSignedMoney(value, symbol);

      setResult("totalEmails", formatCount(results.monthlyEmails));
      setResult("eligibleEmails", formatCount(results.eligibleEmails));
      setResult("aiMinutesPerEmail", formatMinutes(results.aiMinutesPerEmail));

      setResult("hoursSaved", formatHours(results.hoursSaved));
      setResult("monthlyNet", money(results.monthlyNetBenefit));
      setResult("grossValue", money(results.grossMonthlyTimeValue));
      setResult("operatingCost", money(results.monthlyOperatingCost));
      setResult("firstMonthNet", money(results.firstMonthNetBenefit));
      setResult("firstYearNet", money(results.firstYearNetBenefit));
      setResult("recurringRoi", formatRoi(results.recurringRoi));
      setResult("breakEven", formatBreakEven(results.breakEven));
      setResult("manualHours", formatHours(results.manualHours));
      setResult("aiHours", formatHours(results.aiHours));

      applyTone("hoursSaved", toneOf(results.hoursSaved));
      applyTone("monthlyNet", toneOf(results.monthlyNetBenefit));
      applyTone("grossValue", toneOf(results.grossMonthlyTimeValue));
      applyTone("firstMonthNet", toneOf(results.firstMonthNetBenefit));
      applyTone("firstYearNet", toneOf(results.firstYearNetBenefit));
      applyTone("recurringRoi", roiTone(results.recurringRoi));

      // A saving and a loss need different words, not just a different colour.
      setNote(
        "hoursSaved",
        results.hoursSaved > 0
          ? "Manual reply time minus AI-assisted human time"
          : results.hoursSaved < 0
            ? "The AI workflow needs more human time than replying by hand"
            : "The two workflows take the same active time",
      );
      setNote(
        "monthlyNet",
        results.monthlyNetBenefit >= 0
          ? "Ongoing. Excludes the one-time setup cost"
          : "An ongoing monthly shortfall at these assumptions",
      );
      setNote(
        "breakEven",
        results.breakEven.kind === "unreachable"
          ? "No volume covers the cost at these assumptions"
          : results.breakEven.emails === 0
            ? "No recurring cost to cover"
            : `Per month, against ${formatCount(results.eligibleEmails)} eligible now`,
      );
      setNote(
        "recurringRoi",
        results.recurringRoi.kind === "no-cost"
          ? "No modelled cost, so there is no ROI to report"
          : "On the monthly operating cost only",
      );

      setBars(results.manualHours, results.aiHours);
      comparisonNote.textContent =
        results.minutesSaved > 0
          ? `${formatHours(results.hoursSaved)} fewer active hours a month on ${formatCount(results.eligibleEmails)} AI-eligible emails.`
          : results.minutesSaved < 0
            ? `${formatHours(Math.abs(results.hoursSaved))} more active hours a month. Review and correction time outweigh the drafting saved.`
            : "Both workflows take the same active time at these assumptions.";

      const errors = readings.filter(([, reading]) => reading.invalid).length;
      invalidNote.hidden = errors === 0;
      invalidText.textContent =
        errors === 1
          ? "One field needs attention. It is counted as 0 until you fix it."
          : `${errors} fields need attention. They are counted as 0 until you fix them.`;

      summary = buildSummary(results, symbol, code);

      window.clearTimeout(announceTimer);
      announceTimer = window.setTimeout(() => {
        announce.textContent =
          `${formatHours(results.hoursSaved)} active hours saved a month. ` +
          `Estimated value ${money(results.grossMonthlyTimeValue)}. ` +
          `Monthly net benefit ${money(results.monthlyNetBenefit)}. ` +
          `First-year net benefit ${money(results.firstYearNetBenefit)}.`;
      }, ANNOUNCE_DELAY_MS);
    }

    function setCurrencySymbols(): void {
      const { symbol } = selectedCurrency();
      for (const node of panel.querySelectorAll<HTMLElement>("[data-currency-symbol]")) {
        node.textContent = symbol;
      }
    }

    /** Back to the server-rendered illustrative defaults. Nothing is stored. */
    function reset(): void {
      for (const input of panel.querySelectorAll<HTMLInputElement>("input[data-field]")) {
        input.value = input.defaultValue;
      }
      currencySelect.value = DEFAULT_CURRENCY.code;

      setCurrencySymbols();
      render();

      copyStatus.textContent = "";
      inputFor("emailsPerDay")?.focus();
      announce.textContent = "Calculator reset to the illustrative defaults.";
    }

    function showCopyStatus(message: string): void {
      copyStatus.textContent = message;
      window.clearTimeout(copyTimer);
      copyTimer = window.setTimeout(() => {
        copyStatus.textContent = "";
      }, COPY_STATUS_MS);
    }

    resetButton.addEventListener("click", reset);

    // Live figures: one delegated listener covers every input in the panel.
    panel.addEventListener("input", render);
    currencySelect.addEventListener("change", () => {
      setCurrencySymbols();
      render();
    });

    /**
     * Both copy actions are local clipboard writes. The results summary is
     * figures the visitor can already see; the share action copies the public
     * page URL only, and never the figures entered. Each button stays hidden
     * where the API is unavailable rather than offering an action that fails.
     */
    if (navigator.clipboard) {
      copyResultsButton.hidden = false;
      copyResultsButton.addEventListener("click", () => {
        navigator.clipboard.writeText(summary).then(
          () => showCopyStatus("Results and assumptions copied."),
          () =>
            showCopyStatus("Copy was blocked by your browser. Select the figures to copy them."),
        );
      });

      copyLinkButton.hidden = false;
      copyLinkButton.addEventListener("click", () => {
        const url = `${location.origin}${location.pathname}`;
        navigator.clipboard.writeText(url).then(
          () => showCopyStatus("Link copied. It carries none of your figures."),
          () => showCopyStatus("Copy was blocked by your browser. Copy the address bar instead."),
        );
      });
    }

    setCurrencySymbols();
    render();
  }
</script>
