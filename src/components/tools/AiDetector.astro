---
/**
 * AI Detector — the interactive part of /free-ai-tools/ai-detector/.
 *
 * A textarea, five client-side heuristic signals, and an honest verdict that
 * explains what was found rather than claiming authorship. Privacy: nothing
 * leaves the browser. No fetch, no form submit, no localStorage of the text.
 */
---

<div id="aid-root" class="not-prose mt-8 mb-4">
  {/* ---- Input ---- */}
  <div class="rounded-2xl border border-[#2f2504]/15 bg-white p-4 shadow-sm sm:p-6">
    <label for="aid-input" class="mb-2 block text-sm font-semibold text-[#2f2504]">
      Paste the text you want to check
    </label>
    <textarea
      id="aid-input"
      rows="10"
      placeholder="Paste at least a few sentences. Short samples (under 80 words) give unreliable scores."
      class="w-full rounded-xl border border-[#2f2504]/15 bg-white px-3.5 py-3 font-sans text-sm leading-relaxed text-[#2f2504] placeholder:text-[#2f2504]/40 focus:border-[#ff7733] focus:outline-none focus:ring-2 focus:ring-[#ff7733]/25"
    ></textarea>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-2 text-xs">
        <button
          type="button"
          data-aid-sample="human"
          class="aid-pill"
        >Try a human sample</button>
        <button
          type="button"
          data-aid-sample="ai"
          class="aid-pill"
        >Try an AI sample</button>
        <button
          type="button"
          id="aid-clear"
          class="aid-pill"
        >Clear</button>
      </div>
      <div class="flex items-center gap-3">
        <span id="aid-count" class="font-mono text-xs text-[#2f2504]/60">0 words</span>
        <button
          type="button"
          id="aid-run"
          class="inline-flex items-center gap-2 rounded-xl bg-[#ff7733] px-5 py-2.5 text-sm font-bold text-white shadow-[0_6px_14px_-4px_rgb(255_119_51/0.45)] transition-all duration-180 hover:bg-[#c44e13] hover:shadow-[0_8px_18px_-4px_rgb(255_119_51/0.55)] disabled:cursor-not-allowed disabled:opacity-50"
          disabled
        >
          Check for AI patterns
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* ---- Results (hidden until analyze) ---- */}
  <div
    id="aid-results"
    class="mt-6 grid overflow-hidden opacity-0 transition-[opacity,grid-template-rows] duration-300 ease-out [grid-template-rows:0fr]"
    aria-live="polite"
  >
    <div class="min-h-0">
      <div class="rounded-2xl border border-[#2f2504]/15 bg-white p-5 shadow-sm sm:p-7">
        {/* Verdict header */}
        <div id="aid-verdict" class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
          <div class="flex items-center gap-4">
            <div
              id="aid-score-ring"
              class="relative flex size-20 shrink-0 items-center justify-center rounded-full border-4 border-[#ff7733]/20"
            >
              <span id="aid-score" class="font-display text-2xl font-bold tabular-nums text-[#2f2504]">0</span>
              <span class="absolute -bottom-5 font-mono text-[0.625rem] tracking-[0.1em] text-[#2f2504]/60 uppercase">/ 100</span>
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-display text-xl font-bold tracking-tight text-[#2f2504]" id="aid-verdict-headline">—</p>
              <p class="mt-1 text-sm leading-relaxed text-[#2f2504]/75" id="aid-verdict-body">—</p>
            </div>
          </div>
        </div>

        {/* Caveat banner */}
        <div class="mb-6 rounded-xl border border-[#ff7733]/30 bg-[#fff2ea] px-4 py-3 text-xs leading-relaxed text-[#2f2504]/85">
          <strong class="text-[#2f2504]">This is a pattern-match heuristic, not a verdict.</strong>
          It flags surface patterns that often appear in default LLM output. Careful human writers can match these patterns, and good prompts can avoid them. Never accuse anyone on a score alone.
        </div>

        {/* Signal breakdown */}
        <div>
          <p class="mb-3 font-mono text-[0.6875rem] font-semibold tracking-[0.1em] text-[#ff7733] uppercase">Signal breakdown</p>
          <ul id="aid-signals" class="space-y-3"></ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { analyze, SAMPLES, VERDICT_COPY, type Signal } from "./ai-detector";

  const root = document.getElementById("aid-root");
  if (root) {
    const input = root.querySelector<HTMLTextAreaElement>("#aid-input")!;
    const run = root.querySelector<HTMLButtonElement>("#aid-run")!;
    const clear = root.querySelector<HTMLButtonElement>("#aid-clear")!;
    const count = root.querySelector<HTMLElement>("#aid-count")!;
    const results = root.querySelector<HTMLElement>("#aid-results")!;
    const scoreEl = root.querySelector<HTMLElement>("#aid-score")!;
    const ring = root.querySelector<HTMLElement>("#aid-score-ring")!;
    const headlineEl = root.querySelector<HTMLElement>("#aid-verdict-headline")!;
    const bodyEl = root.querySelector<HTMLElement>("#aid-verdict-body")!;
    const signalsEl = root.querySelector<HTMLElement>("#aid-signals")!;

    const sync = () => {
      const words = input.value.trim().split(/\s+/).filter(Boolean).length;
      count.textContent = `${words} word${words === 1 ? "" : "s"}`;
      run.disabled = words < 40;
    };

    const render = () => {
      const report = analyze(input.value);
      scoreEl.textContent = String(report.score);

      const copy = VERDICT_COPY[report.verdict];
      headlineEl.textContent = copy.headline;
      bodyEl.textContent = copy.body;

      // Ring colour by tone.
      ring.classList.remove(
        "border-[#ff7733]/20",
        "border-[#2f2504]/30",
        "border-[#ff7733]",
        "border-[#c44e13]",
      );
      if (copy.tone === "ok") ring.classList.add("border-[#2f2504]/30");
      else if (copy.tone === "warn") ring.classList.add("border-[#ff7733]");
      else ring.classList.add("border-[#c44e13]");

      // Signal list.
      signalsEl.innerHTML = report.signals
        .map((s: Signal) => {
          const pct = s.max > 0 ? Math.round((s.points / s.max) * 100) : 0;
          const matchesHtml = s.matches && s.matches.length > 0
            ? `<div class="mt-2 flex flex-wrap gap-1.5">${s.matches
                .slice(0, 12)
                .map(
                  (m) =>
                    `<span class="inline-block rounded-full border border-[#ff7733]/35 bg-[#fff2ea] px-2 py-0.5 font-mono text-[0.6875rem] text-[#c44e13]">${escapeHtml(m)}</span>`,
                )
                .join("")}${s.matches.length > 12 ? `<span class="font-mono text-[0.6875rem] text-[#2f2504]/55">+${s.matches.length - 12} more</span>` : ""}</div>`
            : "";
          return `
            <li class="rounded-xl border border-[#2f2504]/10 bg-white p-4">
              <div class="flex items-baseline justify-between gap-3">
                <span class="font-display text-sm font-bold text-[#2f2504]">${s.label}</span>
                <span class="font-mono text-xs font-semibold tabular-nums text-[#ff7733]">${s.points} / ${s.max}</span>
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#2f2504]/10">
                <div class="h-full rounded-full bg-[#ff7733] transition-[width] duration-300" style="width:${pct}%"></div>
              </div>
              <p class="mt-2 text-xs leading-relaxed text-[#2f2504]/75">${escapeHtml(s.detail)}</p>
              ${matchesHtml}
            </li>`;
        })
        .join("");

      results.style.gridTemplateRows = "1fr";
      results.style.opacity = "1";
    };

    const escapeHtml = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

    input.addEventListener("input", sync);
    run.addEventListener("click", render);
    clear.addEventListener("click", () => {
      input.value = "";
      results.style.gridTemplateRows = "0fr";
      results.style.opacity = "0";
      sync();
      input.focus();
    });

    for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-aid-sample]")) {
      btn.addEventListener("click", () => {
        const kind = btn.dataset.aidSample as "human" | "ai";
        input.value = SAMPLES[kind];
        sync();
        input.focus();
      });
    }

    sync();
  }
</script>

<style>
  .aid-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid rgb(47 37 4 / 0.15);
    background: #ffffff;
    color: #2f2504;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .aid-pill:hover {
    border-color: #ff7733;
    background: #fff2ea;
  }

  @media (prefers-reduced-motion: reduce) {
    #aid-results {
      transition: none !important;
    }
    .aid-pill {
      transition: none;
    }
  }
</style>
