---
/**
 * ChatGPT Plus vs API break-even calculator — the interactive part of
 * /ai-business-tools/chatgpt-plus-vs-api-calculator/.
 *
 * Imported by that page's MDX body. All pricing, token estimates and maths
 * live in ./plus-vs-api-calculator.ts and are shared between this markup and
 * the inline script so attributes and arithmetic cannot drift apart.
 *
 * Privacy: no <form> element, no fetch, no localStorage, no cookie write. The
 * inputs stay in the tab's own DOM, the arithmetic runs there, and nothing is
 * ever submitted. The one outbound call is navigator.clipboard.writeText when
 * the Copy button is pressed, which hands the already-computed result text to
 * the platform's clipboard API. The copy event records only that Copy was
 * pressed, per src/lib/analytics.ts.
 */
import {
  SUBSCRIPTIONS,
  API_MODELS,
  PROMPT_LENGTHS,
  REPLY_LENGTHS,
  MODEL_CHOICES,
  DEFAULTS,
  LIMITS,
  PRICES_UPDATED,
  PRESETS,
  SWITCHING_COST_USD,
} from "./plus-vs-api-calculator";

const headingId = "plus-vs-api-calculator";
---

<section
  aria-labelledby={headingId}
  class="not-prose my-10 overflow-hidden rounded-panel border border-ink-200 bg-surface shadow-panel"
  data-plus-vs-api
>
  <div class="border-b border-ink-200 bg-ink-50 px-4 py-5 sm:px-6 sm:py-6">
    <p class="eyebrow eyebrow-accent">Free calculator</p>
    <h2 id={headingId} class="type-section mt-2">
      Which plan is actually cheapest for your usage?
    </h2>
    <p class="mt-2.5 leading-relaxed text-ink-600">
      Tell the calculator four things about how you use ChatGPT. It ranks every realistic option -
      Plus, Team, Pro, Claude Pro, Claude Max, Gemini Advanced, and four OpenAI API tiers - by what
      you would actually pay per month.
    </p>
    <p class="mt-3 flex items-start gap-2 text-sm font-medium text-ink-700">
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="mt-0.5 size-4 shrink-0 text-accent-700"
      >
        <path
          fill-rule="evenodd"
          d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z"
          clip-rule="evenodd"></path>
      </svg>
      <span>Your inputs stay in your browser. Nothing on this page is sent anywhere.</span>
    </p>
  </div>

  <div class="px-4 py-6 sm:px-6">
    <fieldset>
      <legend class="font-sans text-base font-bold tracking-tight text-ink-900">
        How you use it
      </legend>
      <p class="mt-1 text-sm text-ink-500">
        Four questions. The result updates as you change them.
      </p>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="plusapi-prompts" class="block text-sm font-semibold text-ink-900">
            Prompts per day
          </label>
          <input
            id="plusapi-prompts"
            type="number"
            min="1"
            max={LIMITS.maxPromptsPerDay}
            step="1"
            inputmode="numeric"
            autocomplete="off"
            value={DEFAULTS.promptsPerDay}
            aria-describedby="plusapi-prompts-hint"
            class="mt-1.5 block min-h-11 w-full rounded-lg border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-brand-500 focus:outline-none"
            data-prompts
          />
          <p id="plusapi-prompts-hint" class="mt-1.5 text-sm text-ink-500">
            One "prompt" is one message you send. A back-and-forth exchange is several prompts.
          </p>
        </div>

        <div>
          <label for="plusapi-model" class="block text-sm font-semibold text-ink-900">
            Which ChatGPT model do you pick?
          </label>
          <select
            id="plusapi-model"
            aria-describedby="plusapi-model-hint"
            class="mt-1.5 block min-h-11 w-full rounded-lg border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-brand-500 focus:outline-none"
            data-model
          >
            {
              MODEL_CHOICES.map((choice) => (
                <option value={choice.value} selected={choice.value === DEFAULTS.model}>
                  {choice.label}
                </option>
              ))
            }
          </select>
          <p id="plusapi-model-hint" class="mt-1.5 text-sm text-ink-500">
            Used to score Plus against the API on the same model's prices.
          </p>
        </div>

        <div>
          <label for="plusapi-prompt-length" class="block text-sm font-semibold text-ink-900">
            Average prompt length
          </label>
          <select
            id="plusapi-prompt-length"
            class="mt-1.5 block min-h-11 w-full rounded-lg border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-brand-500 focus:outline-none"
            data-prompt-length
          >
            {
              PROMPT_LENGTHS.map((opt) => (
                <option value={opt.value} selected={opt.value === DEFAULTS.promptLength}>
                  {opt.label}
                </option>
              ))
            }
          </select>
        </div>

        <div>
          <label for="plusapi-reply-length" class="block text-sm font-semibold text-ink-900">
            Average reply length
          </label>
          <select
            id="plusapi-reply-length"
            class="mt-1.5 block min-h-11 w-full rounded-lg border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-brand-500 focus:outline-none"
            data-reply-length
          >
            {
              REPLY_LENGTHS.map((opt) => (
                <option value={opt.value} selected={opt.value === DEFAULTS.replyLength}>
                  {opt.label}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <details class="mt-5 rounded-xl border border-ink-200 bg-ink-50 p-4">
        <summary class="cursor-pointer text-sm font-semibold text-ink-900">
          Advanced: days per month you actually use it
        </summary>
        <div class="mt-3">
          <label for="plusapi-days" class="block text-sm font-semibold text-ink-900">
            Days per month
          </label>
          <input
            id="plusapi-days"
            type="number"
            min={LIMITS.minDaysPerMonth}
            max={LIMITS.maxDaysPerMonth}
            step="1"
            inputmode="numeric"
            autocomplete="off"
            value={DEFAULTS.daysPerMonth}
            class="mt-1.5 block min-h-11 w-full max-w-xs rounded-lg border border-ink-300 bg-surface px-3 py-2.5 text-ink-900 focus:border-brand-500 focus:outline-none"
            data-days
          />
          <p class="mt-1.5 text-sm text-ink-500">
            22 for weekday-only work; 30 for a workflow that runs every day, like an on-site
            chatbot.
          </p>
        </div>
      </details>
    </fieldset>

    <fieldset class="mt-6">
      <legend class="sr-only">Try a preset usage pattern</legend>
      <p class="text-sm font-semibold text-ink-900">Or try a preset:</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {
          PRESETS.map((preset) => (
            <button
              type="button"
              class="rounded-full border border-ink-300 bg-surface px-3 py-1.5 text-xs font-semibold text-ink-800 transition-colors duration-180 ease-ui hover:border-brand-500 hover:text-brand-700 motion-reduce:transition-none"
              data-preset={preset.id}
              data-preset-prompts={preset.promptsPerDay}
              data-preset-prompt-length={preset.promptLength}
              data-preset-reply-length={preset.replyLength}
              data-preset-model={preset.model}
              data-preset-days={preset.daysPerMonth}
            >
              {preset.label}
            </button>
          ))
        }
      </div>
    </fieldset>

    <div
      class="mt-8 rounded-xl border-l-4 border-emerald-500 bg-emerald-50 px-4 py-4 text-sm text-ink-800"
      data-winner
      aria-live="polite"
      aria-atomic="true"
    >
      <p class="text-xs font-bold tracking-wide text-emerald-700 uppercase">
        Cheapest for your usage
      </p>
      <p class="mt-1 text-lg font-bold text-ink-900" data-winner-label>—</p>
      <p class="mt-1 text-ink-700" data-winner-detail>Adjust the inputs above to see the ranking.</p>
    </div>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[640px] border-collapse text-left text-sm">
        <caption class="sr-only">
          Every ChatGPT and competitor option ranked by monthly cost at the selected usage.
        </caption>
        <thead>
          <tr class="border-b border-ink-300 bg-ink-50">
            <th scope="col" class="px-3 py-3 font-sans text-xs font-bold tracking-wide text-ink-700 uppercase">
              Option
            </th>
            <th scope="col" class="px-3 py-3 font-sans text-xs font-bold tracking-wide text-ink-700 uppercase">
              Monthly cost
            </th>
            <th scope="col" class="px-3 py-3 font-sans text-xs font-bold tracking-wide text-ink-700 uppercase">
              Honest note
            </th>
          </tr>
        </thead>
        <tbody data-results>
          <tr><td colspan="3" class="px-3 py-6 text-center text-sm text-ink-500">Calculating…</td></tr>
        </tbody>
      </table>
    </div>

    <div
      class="mt-6 rounded-xl border border-ink-200 bg-ink-50 p-4 text-sm leading-relaxed text-ink-700"
      data-insights
    >
      <h3 class="font-sans text-base font-bold text-ink-900">Break-even insights</h3>
      <ul class="mt-2 space-y-2" data-insights-list>
        <li>Your break-even point will appear here as you adjust the inputs.</li>
      </ul>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <button type="button" class="btn btn-secondary" data-copy-button>
        Copy result as plain text
      </button>
      <span class="text-xs text-ink-500">
        Copies the winner, every option's monthly cost, and your inputs - nothing else.
      </span>
    </div>

    <p class="mt-6 text-xs text-ink-500">
      Prices verified against each vendor's own pricing page on
      <time datetime={PRICES_UPDATED}>{PRICES_UPDATED}</time>. API costs include a flat
      <strong class="font-semibold text-ink-700">${SWITCHING_COST_USD}/month switching cost</strong>
      - an editorial estimate of the time you spend recreating features (voice, images, memory, the
      app) that a subscription includes. Omit it and the API is a few dollars cheaper; keep it and
      the verdict holds up after feature parity.
    </p>
  </div>
</section>

<script>
  import {
    SUBSCRIPTIONS,
    API_MODELS,
    DEFAULTS,
    LIMITS,
    SWITCHING_COST_USD,
    monthlyTokens,
    monthlyApiCost,
    formatUSD,
    clamp,
    type Subscription,
    type ApiModel,
  } from "./plus-vs-api-calculator";
  import { trackEvent } from "@/lib/analytics";

  interface Row {
    id: string;
    label: string;
    monthlyUsd: number;
    note: string;
    isWinner: boolean;
    isExpensive: boolean;
  }

  const root = document.querySelector<HTMLElement>("[data-plus-vs-api]");
  if (root) {
    const promptsInput = root.querySelector<HTMLInputElement>("[data-prompts]");
    const promptLengthSelect = root.querySelector<HTMLSelectElement>("[data-prompt-length]");
    const replyLengthSelect = root.querySelector<HTMLSelectElement>("[data-reply-length]");
    const modelSelect = root.querySelector<HTMLSelectElement>("[data-model]");
    const daysInput = root.querySelector<HTMLInputElement>("[data-days]");
    const winnerLabel = root.querySelector<HTMLElement>("[data-winner-label]");
    const winnerDetail = root.querySelector<HTMLElement>("[data-winner-detail]");
    const tbody = root.querySelector<HTMLTableSectionElement>("[data-results]");
    const insightsList = root.querySelector<HTMLUListElement>("[data-insights-list]");
    const copyButton = root.querySelector<HTMLButtonElement>("[data-copy-button]");

    function readInputs() {
      return {
        promptsPerDay: clamp(
          Number(promptsInput?.value ?? DEFAULTS.promptsPerDay),
          1,
          LIMITS.maxPromptsPerDay,
        ),
        promptLength: Number(promptLengthSelect?.value ?? DEFAULTS.promptLength),
        replyLength: Number(replyLengthSelect?.value ?? DEFAULTS.replyLength),
        model: String(modelSelect?.value ?? DEFAULTS.model),
        daysPerMonth: clamp(
          Number(daysInput?.value ?? DEFAULTS.daysPerMonth),
          LIMITS.minDaysPerMonth,
          LIMITS.maxDaysPerMonth,
        ),
      };
    }

    function rowsFor(inputs: ReturnType<typeof readInputs>): Row[] {
      const tokens = monthlyTokens(inputs);
      const subRows: Row[] = SUBSCRIPTIONS.map((s: Subscription) => {
        const extraLabel = s.minUsers ? ` (${s.minUsers} users = ${formatUSD(s.monthlyUsd * s.minUsers)}/mo)` : "";
        const monthly = s.minUsers ? s.monthlyUsd * s.minUsers : s.monthlyUsd;
        return {
          id: s.id,
          label: s.label + extraLabel,
          monthlyUsd: monthly,
          note: s.honestNote,
          isWinner: false,
          isExpensive: false,
        };
      });

      const apiRows: Row[] = API_MODELS.map((m: ApiModel) => {
        const baseCost = monthlyApiCost(m, tokens);
        const withSwitching = baseCost + SWITCHING_COST_USD;
        return {
          id: m.id,
          label: m.label,
          monthlyUsd: withSwitching,
          note: m.honestNote,
          isWinner: false,
          isExpensive: false,
        };
      });

      const all = [...subRows, ...apiRows].sort((a, b) => a.monthlyUsd - b.monthlyUsd);
      if (all.length > 0 && all[0]) all[0].isWinner = true;
      if (all.length > 1 && all[all.length - 1]) all[all.length - 1]!.isExpensive = true;
      return all;
    }

    function render(): void {
      const inputs = readInputs();
      const rows = rowsFor(inputs);

      if (tbody) {
        tbody.innerHTML = rows
          .map((row) => {
            const classes = [
              "border-b border-ink-200 align-top transition-colors duration-180 ease-ui motion-reduce:transition-none",
            ];
            if (row.isWinner) classes.push("bg-emerald-50", "border-l-4", "border-l-emerald-500");
            if (row.isExpensive) classes.push("border-l-4", "border-l-red-400");

            const badge = row.isWinner
              ? '<div class="mt-0.5 text-xs font-bold text-emerald-700">Cheapest for your usage</div>'
              : "";

            return `<tr class="${classes.join(" ")}">
              <th scope="row" class="px-3 py-4 align-top">
                <div class="font-sans font-bold text-ink-900">${escapeHtml(row.label)}</div>
                ${badge}
              </th>
              <td class="px-3 py-4 font-mono text-sm font-semibold text-ink-900">${formatUSD(row.monthlyUsd)}</td>
              <td class="px-3 py-4 text-xs leading-relaxed text-ink-700">${escapeHtml(row.note)}</td>
            </tr>`;
          })
          .join("");
      }

      const winner = rows[0];
      const expensive = rows[rows.length - 1];
      if (winner && expensive && winnerLabel && winnerDetail) {
        winnerLabel.textContent = `${winner.label} — ${formatUSD(winner.monthlyUsd)} / month`;
        const savings = expensive.monthlyUsd - winner.monthlyUsd;
        const multiple = winner.monthlyUsd > 0 ? (expensive.monthlyUsd / winner.monthlyUsd).toFixed(1) : "—";
        winnerDetail.textContent =
          savings > 0.01
            ? `${formatUSD(savings)}/mo cheaper than the most expensive option (${expensive.label}), which costs ${multiple}x as much.`
            : "At this usage the top options are essentially tied on price.";
      }

      if (insightsList) {
        const tokens = monthlyTokens(inputs);
        const monthlyLine = `At ${inputs.promptsPerDay} prompts/day across ${inputs.daysPerMonth} days, you use about ${tokens.inputTokens.toLocaleString("en-US")} input tokens and ${tokens.outputTokens.toLocaleString("en-US")} output tokens per month.`;
        const apiRow = rows.find((row) => row.id === inputs.model);
        const plusRow = rows.find((row) => row.id === "chatgpt-plus");
        let verdictLine = "";
        if (apiRow && plusRow) {
          const diff = apiRow.monthlyUsd - plusRow.monthlyUsd;
          if (diff > 0.5) {
            verdictLine = `On ${inputs.model.toUpperCase()}, the API runs ${formatUSD(diff)}/mo more than Plus — stay on Plus.`;
          } else if (diff < -0.5) {
            verdictLine = `On ${inputs.model.toUpperCase()}, the API runs ${formatUSD(Math.abs(diff))}/mo less than Plus — consider the API if you can live without voice, images and the app.`;
          } else {
            verdictLine = `At this usage, Plus and the API on ${inputs.model.toUpperCase()} are within a dollar of each other. Pick on features, not price.`;
          }
        }
        const honestTake =
          "For 90% of small-business users, a $20 subscription (Plus, Claude Pro, or Gemini Advanced) is the right answer. The API only wins if you automate — running the same prompt thousands of times programmatically.";

        insightsList.innerHTML = [monthlyLine, verdictLine, honestTake]
          .filter(Boolean)
          .map((line) => `<li>${escapeHtml(line)}</li>`)
          .join("");
      }
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function applyPreset(button: HTMLElement): void {
      if (promptsInput) promptsInput.value = button.dataset.presetPrompts ?? String(DEFAULTS.promptsPerDay);
      if (promptLengthSelect) promptLengthSelect.value = button.dataset.presetPromptLength ?? DEFAULTS.promptLength;
      if (replyLengthSelect) replyLengthSelect.value = button.dataset.presetReplyLength ?? DEFAULTS.replyLength;
      if (modelSelect) modelSelect.value = button.dataset.presetModel ?? DEFAULTS.model;
      if (daysInput) daysInput.value = button.dataset.presetDays ?? String(DEFAULTS.daysPerMonth);
      render();
    }

    function buildClipboardText(): string {
      const inputs = readInputs();
      const rows = rowsFor(inputs);
      const lines: string[] = [];
      lines.push("ChatGPT Plus vs API — Your result");
      lines.push("");
      lines.push(`Inputs: ${inputs.promptsPerDay} prompts/day, model ${inputs.model.toUpperCase()}, ${inputs.daysPerMonth} days/month.`);
      lines.push("");
      lines.push("Ranking by monthly cost:");
      rows.forEach((row) => {
        const marker = row.isWinner ? "★" : " ";
        lines.push(`${marker} ${row.label}: ${formatUSD(row.monthlyUsd)}`);
      });
      lines.push("");
      lines.push("Source: saayeshaiflow.com/ai-business-tools/chatgpt-plus-vs-api-calculator/");
      return lines.join("\n");
    }

    render();

    promptsInput?.addEventListener("input", render);
    promptLengthSelect?.addEventListener("change", render);
    replyLengthSelect?.addEventListener("change", render);
    modelSelect?.addEventListener("change", render);
    daysInput?.addEventListener("input", render);

    root.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((button) => {
      button.addEventListener("click", () => applyPreset(button));
    });

    if (copyButton && navigator.clipboard?.writeText) {
      copyButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(buildClipboardText());
          const original = copyButton.textContent;
          copyButton.textContent = "Copied to clipboard";
          trackEvent("share_click", { method: "plus_vs_api_copy" });
          window.setTimeout(() => {
            if (original) copyButton.textContent = original;
          }, 2000);
        } catch {
          copyButton.textContent = "Press Ctrl+C to copy";
        }
      });
    } else if (copyButton) {
      copyButton.hidden = true;
    }
  }
</script>
