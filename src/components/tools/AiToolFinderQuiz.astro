---
/**
 * AI Tool Finder Quiz — the interactive part of
 * /free-ai-tools/ai-tool-finder-quiz/.
 *
 * Four questions, each with four options. The visitor picks one option per
 * question, then the script scores every tool in the catalogue and shows the
 * top 3 matches with an honest caveat and a link to the site's own guide.
 *
 * Privacy: no form element, no fetch, no localStorage, no cookie. Every
 * answer stays in the page's own DOM. The quiz can be retaken by pressing
 * "Start over", which clears the answers and shows question 1 again.
 */
import { QUESTIONS } from "./tool-finder-quiz";
---

<div id="quiz-root" class="mt-8 mb-4">
  {/* ---- Progress bar ---- */}
  <div class="mb-6 flex items-center gap-3">
    <span id="quiz-step" class="font-mono text-sm font-semibold text-brand-600">1 / {QUESTIONS.length}</span>
    <div class="h-2 flex-1 overflow-hidden rounded-full bg-surface-sunken">
      <div
        id="quiz-bar"
        class="h-full rounded-full bg-[image:var(--gradient-brand)] transition-all duration-300 ease-ui"
        style={`width: ${100 / QUESTIONS.length}%`}
      ></div>
    </div>
  </div>

  {/* ---- Questions ---- */}
  {QUESTIONS.map((q, qi) => (
    <fieldset
      id={`q-${q.id}`}
      class="quiz-question"
      data-step={qi}
      style={qi > 0 ? "display:none" : undefined}
    >
      <legend class="mb-5 font-display text-xl font-bold tracking-tight text-ink-900 sm:text-2xl">
        {q.question}
      </legend>
      <div class="grid gap-3 sm:grid-cols-2">
        {q.options.map((opt) => (
          <label
            class="quiz-option group relative flex cursor-pointer items-start gap-3 rounded-xl border-2 border-ink-200 bg-surface p-4 transition-all duration-180 ease-ui hover:border-brand-400 hover:shadow-md has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 has-[:checked]:shadow-lg"
          >
            <input
              type="radio"
              name={q.id}
              value={opt.value}
              class="sr-only"
            />
            <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full border-2 border-ink-300 transition-colors duration-180 group-has-[:checked]:border-brand-500 group-has-[:checked]:bg-brand-500">
              <svg class="size-3 text-white opacity-0 transition-opacity group-has-[:checked]:opacity-100" viewBox="0 0 12 12" fill="currentColor">
                <path d="M10.28 2.28a.75.75 0 0 1 0 1.06l-5.5 5.5a.75.75 0 0 1-1.06 0l-2.5-2.5a.75.75 0 1 1 1.06-1.06L4.25 7.22l4.97-4.94a.75.75 0 0 1 1.06 0Z" />
              </svg>
            </span>
            <span class="text-sm font-medium leading-snug text-ink-700 sm:text-base">{opt.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  ))}

  {/* ---- Navigation buttons ---- */}
  <div class="mt-6 flex items-center gap-3">
    <button
      id="quiz-back"
      type="button"
      class="btn rounded-xl border border-ink-200 bg-surface px-5 py-2.5 text-sm font-semibold text-ink-600 transition-all hover:bg-surface-sunken"
      style="display:none"
    >
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
        <path
          fill-rule="evenodd"
          d="M17 10a.75.75 0 0 0-.75-.75H5.612l4.158-3.96a.75.75 0 1 0-1.04-1.08l-5.5 5.25a.75.75 0 0 0 0 1.08l5.5 5.25a.75.75 0 1 0 1.04-1.08L5.612 10.75H16.25A.75.75 0 0 0 17 10Z"
          clip-rule="evenodd"
        />
      </svg>
      Back
    </button>
    <button
      id="quiz-next"
      type="button"
      class="btn btn-primary ml-auto rounded-xl px-6 py-2.5 text-sm font-semibold opacity-50 transition-all"
      disabled
    >
      Next
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
        <path
          fill-rule="evenodd"
          d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
          clip-rule="evenodd"
        />
      </svg>
    </button>
  </div>

  {/* ---- Results (hidden until quiz completes) ---- */}
  <div id="quiz-results" style="display:none" class="mt-2">
    <div class="mb-6 rounded-2xl border border-brand-200 bg-brand-50/50 p-5 sm:p-6">
      <p class="mb-1 text-sm font-semibold uppercase tracking-wider text-brand-600">Your top recommendation</p>
      <h3 id="res-name-0" class="font-display text-2xl font-bold text-ink-900"></h3>
      <p id="res-tagline-0" class="mt-1 text-ink-600"></p>
      <p id="res-fit-0" class="mt-3 text-sm leading-relaxed text-ink-700"></p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span id="res-plan-0" class="badge badge-solid text-xs"></span>
        <span id="res-price-0" class="font-mono text-lg font-bold text-brand-600"></span>
      </div>
      <p id="res-caveat-0" class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-800">
        <strong>Heads up:</strong> <span id="res-caveat-text-0"></span>
      </p>
      <a id="res-link-0" href="#" class="btn btn-primary mt-4 inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold">
        Read our guide
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>

    <h3 class="mb-4 font-display text-lg font-bold text-ink-900">Also worth considering</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      {[1, 2].map((i) => (
        <div class="rounded-xl border border-ink-200 bg-surface p-4 shadow-sm">
          <h4 id={`res-name-${i}`} class="font-display text-lg font-bold text-ink-900"></h4>
          <p id={`res-tagline-${i}`} class="mt-1 text-sm text-ink-600"></p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span id={`res-plan-${i}`} class="badge text-xs"></span>
            <span id={`res-price-${i}`} class="font-mono text-sm font-semibold text-brand-600"></span>
          </div>
          <p id={`res-caveat-${i}`} class="mt-2 text-xs text-ink-500">
            <strong>Note:</strong> <span id={`res-caveat-text-${i}`}></span>
          </p>
          <a id={`res-link-${i}`} href="#" class="link-arrow mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-600">
            Read our guide
          </a>
        </div>
      ))}
    </div>

    <button
      id="quiz-restart"
      type="button"
      class="btn mt-6 rounded-xl border border-ink-200 bg-surface px-5 py-2.5 text-sm font-semibold text-ink-600 transition-all hover:bg-surface-sunken"
    >
      Start over
    </button>
  </div>
</div>

<script>
  import { QUESTIONS, getRecommendations } from "./tool-finder-quiz";

  const root = document.getElementById("quiz-root")!;
  const stepLabel = document.getElementById("quiz-step")!;
  const bar = document.getElementById("quiz-bar")!;
  const backBtn = document.getElementById("quiz-back")! as HTMLButtonElement;
  const nextBtn = document.getElementById("quiz-next")! as HTMLButtonElement;
  const resultsEl = document.getElementById("quiz-results")!;
  const restartBtn = document.getElementById("quiz-restart")!;

  const totalSteps = QUESTIONS.length;
  let currentStep = 0;
  const answers: Record<string, string> = {};

  function showStep(step: number) {
    currentStep = step;
    root.querySelectorAll<HTMLFieldSetElement>(".quiz-question").forEach((el) => {
      el.style.display = el.dataset.step === String(step) ? "" : "none";
    });
    stepLabel.textContent = `${step + 1} / ${totalSteps}`;
    bar.style.width = `${((step + 1) / totalSteps) * 100}%`;
    backBtn.style.display = step === 0 ? "none" : "";

    const qId = QUESTIONS[step].id;
    const hasAnswer = qId in answers;
    nextBtn.disabled = !hasAnswer;
    nextBtn.classList.toggle("opacity-50", !hasAnswer);
    nextBtn.textContent = step === totalSteps - 1 ? "See my results" : "Next";

    resultsEl.style.display = "none";
    nextBtn.parentElement!.style.display = "";
  }

  root.addEventListener("change", (e) => {
    const input = e.target as HTMLInputElement;
    if (input.type !== "radio") return;
    answers[input.name] = input.value;
    nextBtn.disabled = false;
    nextBtn.classList.remove("opacity-50");
  });

  nextBtn.addEventListener("click", () => {
    if (currentStep < totalSteps - 1) {
      showStep(currentStep + 1);
    } else {
      showResults();
    }
  });

  backBtn.addEventListener("click", () => {
    if (currentStep > 0) showStep(currentStep - 1);
  });

  restartBtn.addEventListener("click", () => {
    for (const key of Object.keys(answers)) delete answers[key];
    root.querySelectorAll<HTMLInputElement>("input[type=radio]").forEach((el) => {
      el.checked = false;
    });
    showStep(0);
  });

  function showResults() {
    const [top, alt1, alt2] = getRecommendations(answers);

    nextBtn.parentElement!.style.display = "none";
    root.querySelectorAll<HTMLFieldSetElement>(".quiz-question").forEach((el) => {
      el.style.display = "none";
    });

    stepLabel.textContent = "Done!";
    bar.style.width = "100%";

    [top, alt1, alt2].forEach((tool, i) => {
      const name = document.getElementById(`res-name-${i}`)!;
      const tagline = document.getElementById(`res-tagline-${i}`)!;
      const plan = document.getElementById(`res-plan-${i}`)!;
      const price = document.getElementById(`res-price-${i}`)!;
      const caveatText = document.getElementById(`res-caveat-text-${i}`)!;
      const link = document.getElementById(`res-link-${i}`)! as HTMLAnchorElement;

      name.textContent = tool.name;
      tagline.textContent = tool.tagline;
      plan.textContent = tool.plan;
      price.textContent = tool.price;
      caveatText.textContent = tool.caveat;
      link.href = tool.guidePath;
      link.textContent = tool.guideLabel;

      if (i === 0) {
        const fitEl = document.getElementById(`res-fit-${i}`)!;
        fitEl.textContent = tool.fit;
      }
    });

    resultsEl.style.display = "";
  }
</script>
