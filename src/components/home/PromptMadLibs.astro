---
/**
 * "Prompt Mad-Libs" — an interactive prompt builder widget.
 *
 * User picks a category (email, blog, social, strategy), fills in 3 blanks,
 * and gets a ready-to-copy prompt. All templates are baked at build time.
 */
import { PROMPT_TEMPLATES } from "./prompt-madlibs-data";
---

<div class="prompt-madlibs" data-prompt-madlibs>
  <p class="mb-2 text-center font-mono text-[0.6875rem] font-semibold tracking-[0.1em] text-violet-400 uppercase">
    Prompt Mad-Libs
  </p>
  <p class="mb-5 text-center text-sm text-ink-600">
    Pick a category, fill in your details, copy the prompt.
  </p>

  {/* Category tabs */}
  <div class="flex flex-wrap justify-center gap-2" data-pm-tabs>
    {PROMPT_TEMPLATES.map((tpl, i) => (
      <button
        type="button"
        class:list={["pm-tab", i === 0 && "pm-tab--active"]}
        data-pm-tab={tpl.id}
        aria-pressed={i === 0 ? "true" : "false"}
      >
        <span aria-hidden="true" class="mr-1 opacity-60">{tpl.emoji}</span>
        {tpl.label}
      </button>
    ))}
  </div>

  {/* Template panels — one per category, only the first visible */}
  {PROMPT_TEMPLATES.map((tpl, i) => (
    <div
      class:list={["pm-panel mt-5", i > 0 && "hidden"]}
      data-pm-panel={tpl.id}
    >
      <div class="space-y-3">
        {tpl.blanks.map((blank) => (
          <div>
            <label
              for={`pm-${tpl.id}-${blank.id}`}
              class="mb-1 block text-[0.8125rem] font-semibold text-ink-700"
            >
              {blank.label}
            </label>
            <input
              type="text"
              id={`pm-${tpl.id}-${blank.id}`}
              class="pm-input"
              placeholder={blank.placeholder}
              data-pm-blank={blank.id}
              autocomplete="off"
            />
          </div>
        ))}
      </div>

      {/* Live preview */}
      <div class="mt-4 rounded-xl border border-white/10 bg-white/[0.04] p-4">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[0.625rem] tracking-[0.1em] text-ink-500 uppercase">
            Your prompt
          </span>
          <button
            type="button"
            class="pm-copy inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/[0.06] px-3 py-1 text-[0.6875rem] font-semibold text-ink-700 transition-colors hover:border-violet-400/40 hover:bg-violet-500/10 hover:text-violet-300"
            data-pm-copy
          >
            <svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor" class="size-3">
              <path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path>
              <path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path>
            </svg>
            Copy
          </button>
        </div>
        <p
          class="mt-2 text-sm leading-relaxed text-ink-800 [overflow-wrap:anywhere]"
          data-pm-preview
        >
          {tpl.template}
        </p>
      </div>

      <p class="mt-3 text-center text-xs text-ink-500">
        More prompts in our
        <a href={tpl.guide} class="text-violet-400 underline decoration-violet-400/30 underline-offset-2 hover:text-violet-300">
          {tpl.guideLabel}
        </a>
      </p>
    </div>
  ))}
</div>

<script>
  import { PROMPT_TEMPLATES, fillTemplate } from "./prompt-madlibs-data";

  function initPromptMadLibs(root: HTMLElement) {
    const tabsWrap = root.querySelector<HTMLElement>("[data-pm-tabs]")!;
    const panels = root.querySelectorAll<HTMLElement>("[data-pm-panel]");
    let activeId = PROMPT_TEMPLATES[0].id;

    function switchTab(id: string) {
      activeId = id;
      for (const btn of tabsWrap.querySelectorAll<HTMLButtonElement>("button")) {
        const isActive = btn.getAttribute("data-pm-tab") === id;
        btn.classList.toggle("pm-tab--active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      }
      for (const panel of panels) {
        panel.classList.toggle("hidden", panel.getAttribute("data-pm-panel") !== id);
      }
    }

    function getValues(panel: HTMLElement): Record<string, string> {
      const values: Record<string, string> = {};
      for (const input of panel.querySelectorAll<HTMLInputElement>("[data-pm-blank]")) {
        values[input.getAttribute("data-pm-blank")!] = input.value;
      }
      return values;
    }

    function updatePreview(panel: HTMLElement) {
      const tpl = PROMPT_TEMPLATES.find((t) => t.id === panel.getAttribute("data-pm-panel"));
      if (!tpl) return;
      const preview = panel.querySelector<HTMLElement>("[data-pm-preview]");
      if (preview) {
        preview.textContent = fillTemplate(tpl, getValues(panel));
      }
    }

    tabsWrap.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-pm-tab]");
      if (!btn) return;
      switchTab(btn.getAttribute("data-pm-tab")!);
    });

    for (const panel of panels) {
      for (const input of panel.querySelectorAll<HTMLInputElement>("[data-pm-blank]")) {
        input.addEventListener("input", () => updatePreview(panel));
      }

      const copyBtn = panel.querySelector<HTMLButtonElement>("[data-pm-copy]");
      if (copyBtn) {
        copyBtn.addEventListener("click", () => {
          const tpl = PROMPT_TEMPLATES.find((t) => t.id === panel.getAttribute("data-pm-panel"));
          if (!tpl) return;
          const text = fillTemplate(tpl, getValues(panel));
          navigator.clipboard.writeText(text).then(() => {
            const original = copyBtn.textContent;
            copyBtn.textContent = "Copied!";
            setTimeout(() => { copyBtn.textContent = original; }, 1500);
          });
        });
      }
    }
  }

  document.querySelectorAll<HTMLElement>("[data-prompt-madlibs]").forEach(initPromptMadLibs);
</script>

<style>
  .pm-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4375rem 0.875rem;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.05);
    color: var(--color-ink-700);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .pm-tab:hover {
    border-color: rgb(255 255 255 / 0.3);
    background: rgb(255 255 255 / 0.1);
  }
  .pm-tab--active {
    border-color: rgb(167 139 250 / 0.5) !important;
    background: rgb(167 139 250 / 0.12) !important;
    color: rgb(221 214 254) !important;
    box-shadow: 0 0 12px -2px rgb(167 139 250 / 0.3);
  }

  .pm-input {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.05);
    color: var(--color-ink-900);
    font-size: 0.875rem;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }
  .pm-input::placeholder {
    color: var(--color-ink-500);
  }
  .pm-input:focus {
    outline: none;
    border-color: rgb(167 139 250 / 0.5);
    box-shadow: 0 0 0 3px rgb(167 139 250 / 0.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .pm-tab {
      transition: none;
    }
    .pm-input {
      transition: none;
    }
  }
</style>
