---
/**
 * The hero illustration: a brief going into an AI step and coming back as the
 * three things these guides are actually about — a draft, a reply, a summary.
 *
 * Original artwork, drawn from the design tokens rather than an icon set, and
 * entirely decorative: it names no product, claims no capability, and is hidden
 * from assistive technology because the copy beside it already says everything
 * it shows.
 *
 * Colour and type come from the scoped stylesheet below, not from presentation
 * attributes: `fill="var(--token)"` is not substituted in an attribute, so the
 * tokens have to be applied as CSS.
 *
 * Inline SVG, no external request, and no animation beyond one slow dash drift
 * on the input connector, switched off under reduced motion.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

/** The three outputs, as labels on the right-hand nodes. */
const OUTPUTS = ["Draft", "Reply", "Summary"];
---

<svg aria-hidden="true" viewBox="0 0 420 300" fill="none" class:list={["h-auto w-full", className]}>
  <defs>
    <linearGradient id="flow-core-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" class="core-from" />
      <stop offset="100%" class="core-to" />
    </linearGradient>
  </defs>

  {/* Panel */}
  <rect x="1" y="1" width="418" height="298" rx="20" class="panel" />

  {/* Input node */}
  <rect x="24" y="124" width="104" height="52" rx="12" class="node" />
  <text x="44" y="147" class="label">
    INPUT
  </text>
  <text x="44" y="164" class="title">
    Your brief
  </text>

  {/* Connector: input to core */}
  <path d="M128 150 H168" class="wire-live" />

  {/* Core */}
  <rect x="168" y="118" width="84" height="64" rx="16" fill="url(#flow-core-gradient)" />
  <text x="210" y="146" text-anchor="middle" class="label label-on-core">
    AI STEP
  </text>
  <text x="210" y="164" text-anchor="middle" class="title title-on-core">
    Model
  </text>

  {/* Connectors: core to each output */}
  <path d="M252 150 C274 150 274 62 296 62" class="wire" />
  <path d="M252 150 H296" class="wire" />
  <path d="M252 150 C274 150 274 238 296 238" class="wire" />

  {/* Outputs */}
  {OUTPUTS.map((label, index) => {
    const y = 38 + index * 88;
    return (
      <>
        <rect x="296" y={y} width="100" height="48" rx="12" class="node node-output" />
        <circle cx="316" cy={y + 24} r="5" class="dot" />
        <text x="330" y={y + 28} class="title title-output">
          {label}
        </text>
      </>
    );
  })}
</svg>

<style>
  .panel {
    fill: var(--color-surface);
    stroke: var(--color-ink-200);
  }

  .node {
    fill: var(--color-surface);
    stroke: var(--color-ink-200);
  }

  .node-output {
    stroke: var(--color-accent-200);
  }

  .dot {
    fill: var(--color-accent-600);
  }

  .core-from {
    stop-color: var(--color-brand-600);
  }

  .core-to {
    stop-color: var(--color-brand-800);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 1.2px;
    fill: var(--color-ink-500);
  }

  .label-on-core {
    fill: var(--color-brand-200);
  }

  .title {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    fill: var(--color-ink-900);
  }

  .title-on-core {
    fill: #fff;
  }

  .title-output {
    font-size: 13px;
    fill: var(--color-ink-800);
  }

  .wire,
  .wire-live {
    stroke-width: 2;
    stroke-linecap: round;
  }

  .wire {
    stroke: var(--color-ink-300);
  }

  .wire-live {
    stroke: var(--color-brand-400);
    stroke-dasharray: 5 5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wire-live {
      animation: flow-drift 2.4s linear infinite;
    }
  }

  @keyframes flow-drift {
    to {
      stroke-dashoffset: -20;
    }
  }
</style>
