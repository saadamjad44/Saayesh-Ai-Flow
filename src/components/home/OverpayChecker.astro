---
/**
 * "Roast My AI Stack" — the overpay checker widget.
 *
 * A grid of popular AI tools: tap the ones you pay for and instantly see your
 * monthly total, annual-billing savings, and how many have free alternatives.
 * Every figure comes from the site's own pricing dataset.
 */
import { CHECKER_TOOLS } from "./overpay-checker-data";
---

<div class="overpay-checker" data-overpay-checker>
  <p class="mb-2 text-center font-mono text-[0.6875rem] font-semibold tracking-[0.1em] text-[#ff7733] uppercase">
    Roast my AI stack
  </p>
  <p class="mb-6 text-center text-sm text-[#2f2504]/75">
    Tap every AI tool you're paying for right now.
  </p>

  <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" data-oc-grid>
    {CHECKER_TOOLS.map((tool) => (
      <button
        type="button"
        class="oc-tool"
        data-oc-id={tool.id}
        data-oc-price={tool.monthlyPrice}
      >
        <span class="text-[0.9375rem] font-bold text-[#2f2504]">{tool.name}</span>
        <span class="font-mono text-xs text-[#2f2504]/55">${tool.monthlyPrice}/mo</span>
      </button>
    ))}
  </div>

  {/* Results panel — hidden until a tool is selected */}
  <div
    class="oc-results mt-5 grid overflow-hidden opacity-0 transition-[opacity,grid-template-rows] duration-300 ease-out [grid-template-rows:0fr]"
    data-oc-results
  >
    <div class="min-h-0">
      <div class="rounded-xl border border-[#2f2504]/15 bg-white p-5 shadow-sm">
        <div class="flex items-baseline justify-between">
          <span class="text-sm font-semibold text-[#2f2504]/75">Your monthly total</span>
          <span class="font-mono text-3xl font-bold tracking-tight text-[#ff7733]" data-oc-total>$0</span>
        </div>

        <p class="mt-3 text-sm leading-relaxed text-[#2f2504]/80" data-oc-roast></p>

        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-lg border border-[#2f2504]/15 bg-white px-3.5 py-2.5">
            <span class="block font-mono text-lg font-bold text-[#2f2504]" data-oc-annual>$0</span>
            <span class="text-[0.6875rem] text-[#2f2504]/60">saved with annual billing</span>
          </div>
          <div class="rounded-lg border border-[#ff7733]/40 bg-[#fff2ea] px-3.5 py-2.5">
            <span class="block font-mono text-lg font-bold text-[#ff7733]" data-oc-free>0</span>
            <span class="text-[0.6875rem] text-[#ff7733]/85">tools with a free tier</span>
          </div>
        </div>

        <p class="mt-4 text-center text-xs text-[#2f2504]/60">
          Prices from our
          <a href="/free-ai-tools/ai-tool-pricing-tracker/" class="text-[#ff7733] underline decoration-[#ff7733]/40 underline-offset-2 hover:text-[#c44e13]">
            pricing tracker
          </a>
          — tap a tool for its full guide.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { analyseStack } from "./overpay-checker-data";

  function initOverpayChecker(root: HTMLElement) {
    const grid = root.querySelector<HTMLElement>("[data-oc-grid]")!;
    const results = root.querySelector<HTMLElement>("[data-oc-results]")!;
    const totalEl = root.querySelector<HTMLElement>("[data-oc-total]")!;
    const roastEl = root.querySelector<HTMLElement>("[data-oc-roast]")!;
    const annualEl = root.querySelector<HTMLElement>("[data-oc-annual]")!;
    const freeEl = root.querySelector<HTMLElement>("[data-oc-free]")!;

    const selected = new Set<string>();

    function render() {
      const result = analyseStack([...selected]);

      totalEl.textContent = `$${result.monthlyTotal}`;
      roastEl.textContent = result.roastMessage;
      annualEl.textContent = `$${result.annualSavings}`;
      freeEl.textContent = String(result.freeAlternatives);

      if (selected.size > 0) {
        results.style.gridTemplateRows = "1fr";
        results.style.opacity = "1";
      } else {
        results.style.gridTemplateRows = "0fr";
        results.style.opacity = "0";
      }
    }

    grid.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-oc-id]");
      if (!btn) return;
      const id = btn.getAttribute("data-oc-id")!;

      if (selected.has(id)) {
        selected.delete(id);
        btn.classList.remove("oc-tool--active");
        btn.setAttribute("aria-pressed", "false");
      } else {
        selected.add(id);
        btn.classList.add("oc-tool--active");
        btn.setAttribute("aria-pressed", "true");
      }

      render();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-overpay-checker]").forEach(initOverpayChecker);
</script>

<style>
  .oc-tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 0.5rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(47 37 4 / 0.15);
    background: #ffffff;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease,
      box-shadow 180ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .oc-tool:hover {
    border-color: #ff7733;
    background: #fff2ea;
    transform: translateY(-1px);
  }
  .oc-tool--active {
    border-color: #ff7733 !important;
    background: #ff7733 !important;
    box-shadow: 0 8px 16px -6px rgb(255 119 51 / 0.5);
  }
  .oc-tool--active span {
    color: #ffffff !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .oc-tool {
      transition: none;
    }
    .oc-tool:hover {
      transform: none;
    }
    .oc-results {
      transition: none !important;
    }
  }
</style>
