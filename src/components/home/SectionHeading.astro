---
/**
 * The head of a homepage section: a gradient-ruled eyebrow, the section's
 * <h2>, an optional standfirst, and an optional "see all" link at the far end.
 *
 * Every section on the homepage opens the same way, and before this component
 * each one carried its own copy of these fifteen lines. The caller still owns
 * the <section> and its `aria-labelledby`, which is why `id` is required.
 *
 * The default slot sits at the end of the row, for a control that belongs to
 * the section rather than to a page — the rail's arrow buttons, say.
 */
interface Props {
  eyebrow: string;
  heading: string;
  /** Must match the caller's `aria-labelledby`. */
  id: string;
  intro?: string;
  link?: { href: string; label: string };
  /** Orange eyebrow, for the free interactive tools. */
  accent?: boolean;
}

const { eyebrow, heading, id, intro, link, accent = false } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4" data-reveal>
  <div class="max-w-2xl">
    <p class:list={["eyebrow eyebrow-rule", accent && "eyebrow-accent"]}>{eyebrow}</p>
    <h2 id={id} class="type-section mt-3">
      {heading}
    </h2>
    {intro && <p class="type-body mt-3">{intro}</p>}
  </div>

  {link && (
    <a href={link.href} class="link-arrow -my-1.5 py-1.5">
      {link.label}
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor">
        <path
          fill-rule="evenodd"
          d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
          clip-rule="evenodd"
        />
      </svg>
    </a>
  )}

  <slot />
</div>
