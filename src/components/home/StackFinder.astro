---
/**
 * "30-Second AI Stack Finder" — the interactive hero widget.
 *
 * Two rows of pill buttons (role, budget) → instant 3-tool recommendation
 * with real prices and guide links. All data is baked into the page at build
 * time; nothing loads on click.
 */
import { ROLES, BUDGETS } from "./stack-finder-data";
---

<div class="stack-finder mx-auto w-full max-w-2xl" data-stack-finder>
  {/* ---- Heading ---- */}
  <p class="mb-5 text-center font-mono text-[0.6875rem] font-semibold tracking-[0.1em] text-[#ff7733] uppercase">
    30-second AI stack finder
  </p>

  {/* ---- Role selector ---- */}
  <fieldset class="mb-3">
    <legend class="mb-2 text-[0.8125rem] font-semibold text-[#2f2504]">What do you do?</legend>
    <div class="flex flex-wrap gap-2" data-sf-roles>
      {ROLES.map((role) => (
        <button
          type="button"
          class="sf-pill"
          data-sf-role={role.id}
        >
          <span aria-hidden="true" class="mr-1 opacity-60">{role.emoji}</span>
          {role.label}
        </button>
      ))}
    </div>
  </fieldset>

  {/* ---- Budget selector ---- */}
  <fieldset class="mb-1">
    <legend class="mb-2 text-[0.8125rem] font-semibold text-[#2f2504]">Monthly budget?</legend>
    <div class="flex flex-wrap gap-2" data-sf-budgets>
      {BUDGETS.map((budget) => (
        <button
          type="button"
          class="sf-pill"
          data-sf-budget={budget.id}
        >
          {budget.label}
        </button>
      ))}
    </div>
  </fieldset>

  {/* ---- Results (hidden until both selected) ---- */}
  <div
    class="sf-results mt-5 grid gap-2.5 overflow-hidden opacity-0 transition-[opacity,grid-template-rows] duration-300 ease-out [grid-template-rows:0fr]"
    data-sf-results
  >
    <div class="min-h-0">
      <div class="grid gap-2 sm:grid-cols-3" data-sf-cards></div>
      <p class="mt-3 text-center text-xs text-[#2f2504]/60" data-sf-total></p>
    </div>
  </div>
</div>

<script>
  import { getStack, getMonthlyTotal } from "./stack-finder-data";

  function initStackFinder(root: HTMLElement) {
    const rolesWrap = root.querySelector<HTMLElement>("[data-sf-roles]")!;
    const budgetsWrap = root.querySelector<HTMLElement>("[data-sf-budgets]")!;
    const resultsWrap = root.querySelector<HTMLElement>("[data-sf-results]")!;
    const cardsWrap = root.querySelector<HTMLElement>("[data-sf-cards]")!;
    const totalEl = root.querySelector<HTMLElement>("[data-sf-total]")!;

    let selectedRole = "";
    let selectedBudget = "";

    function setActive(wrap: HTMLElement, attr: string, value: string) {
      for (const btn of wrap.querySelectorAll<HTMLButtonElement>("button")) {
        const isActive = btn.getAttribute(attr) === value;
        btn.classList.toggle("sf-pill--active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      }
    }

    function render() {
      if (!selectedRole || !selectedBudget) {
        resultsWrap.style.gridTemplateRows = "0fr";
        resultsWrap.style.opacity = "0";
        return;
      }

      const stack = getStack(selectedRole, selectedBudget);
      const total = getMonthlyTotal(stack);

      cardsWrap.innerHTML = stack
        .map(
          (tool) => `
        <a href="${tool.guide}"
           class="sf-card group relative flex flex-col rounded-xl border border-[#2f2504]/15 bg-white p-3.5 shadow-sm transition-[border-color,transform,box-shadow] duration-180 ease-out hover:-translate-y-0.5 hover:border-[#ff7733] hover:shadow-md">
          <span class="text-[0.9375rem] font-bold leading-tight text-[#2f2504]">${tool.name}</span>
          <span class="mt-0.5 text-[0.75rem] text-[#2f2504]/55">${tool.plan}</span>
          <span class="mt-auto pt-2 font-mono text-lg font-bold tracking-tight text-[#ff7733]">${tool.price}</span>
          <span class="mt-1 line-clamp-2 text-[0.75rem] leading-snug text-[#2f2504]/75">${tool.use}</span>
          <span class="mt-2 inline-flex items-center gap-1 text-[0.6875rem] font-semibold text-[#ff7733] opacity-0 transition-opacity duration-180 group-hover:opacity-100">
            Read guide <span aria-hidden="true">&rarr;</span>
          </span>
        </a>`,
        )
        .join("");

      totalEl.textContent =
        total === "$0"
          ? "Total: $0/mo — completely free"
          : `Total: ${total}/mo for this stack`;

      resultsWrap.style.gridTemplateRows = "1fr";
      resultsWrap.style.opacity = "1";
    }

    rolesWrap.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-sf-role]");
      if (!btn) return;
      selectedRole = btn.getAttribute("data-sf-role")!;
      setActive(rolesWrap, "data-sf-role", selectedRole);
      render();
    });

    budgetsWrap.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-sf-budget]");
      if (!btn) return;
      selectedBudget = btn.getAttribute("data-sf-budget")!;
      setActive(budgetsWrap, "data-sf-budget", selectedBudget);
      render();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-stack-finder]").forEach(initStackFinder);
</script>

<style>
  .sf-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4375rem 0.875rem;
    border-radius: 9999px;
    border: 1px solid rgb(47 37 4 / 0.18);
    background: #ffffff;
    color: #2f2504;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease,
      transform 180ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .sf-pill:hover {
    border-color: #ff7733;
    background: #fff2ea;
    transform: translateY(-1px);
  }
  .sf-pill--active {
    border-color: #ff7733 !important;
    background: #ff7733 !important;
    color: #ffffff !important;
    box-shadow: 0 6px 14px -4px rgb(255 119 51 / 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .sf-pill {
      transition: none;
    }
    .sf-pill:hover {
      transform: none;
    }
    .sf-results {
      transition: none !important;
    }
  }
</style>
