---
/**
 * Contact form handled by Netlify Forms (detected in the built HTML at deploy).
 * No JavaScript; spam is filtered with a honeypot field. Without an `action`,
 * Netlify shows its default success page, so no extra URL is added.
 */
import { getPage } from "@/config/pages";

const FORM_NAME = "contact";

/** Subject options from website-blueprint.jsx (Contact page). */
const SUBJECTS = ["General", "Tool Submission", "Correction", "Business Inquiry"] as const;

const privacyPath = getPage("privacy-policy").path;

const fieldClass =
  "mt-1.5 block min-h-11 w-full rounded-lg border border-ink-300 bg-surface px-3.5 py-2.5 text-base text-ink-900 shadow-card placeholder:text-ink-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-600/25 focus:outline-none";

const labelClass = "block text-sm font-semibold text-ink-900";
---

<form
  name={FORM_NAME}
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="not-prose card space-y-5 p-5 sm:p-7"
>
  <input type="hidden" name="form-name" value={FORM_NAME} />

  <p class="hidden" aria-hidden="true">
    <label>
      Leave this field empty
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-name" class={labelClass}>
        Name
      </label>
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        class={fieldClass}
      />
    </div>
    <div>
      <label for="contact-email" class={labelClass}>
        Email
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class={fieldClass}
      />
    </div>
  </div>

  <div>
    <label for="contact-subject" class={labelClass}>
      Subject
    </label>
    <select id="contact-subject" name="subject" required class={fieldClass}>
      {SUBJECTS.map((subject) => (
        <option value={subject}>{subject}</option>
      ))}
    </select>
  </div>

  <div>
    <label for="contact-message" class={labelClass}>
      Message
    </label>
    <textarea id="contact-message" name="message" rows="6" required class={fieldClass}></textarea>
  </div>

  <p class="text-sm text-ink-500">
    All fields are required. See our{" "}
    <a href={privacyPath} class="font-medium text-brand-700 underline hover:text-brand-800">
      privacy policy
    </a>{" "}
    for how form submissions are handled.
  </p>

  <button type="submit" class="btn btn-primary w-full sm:w-auto">
    Send message
  </button>
</form>
