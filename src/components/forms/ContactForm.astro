---
/**
 * Contact form handled by Netlify Forms (detected in the built HTML at deploy).
 * No JavaScript; spam is filtered with a honeypot field. Without an `action`,
 * Netlify shows its default success page, so no extra URL is added.
 */
import { getPage } from "@/config/pages";

const FORM_NAME = "contact";

/** Subject options from website-blueprint.jsx (Contact page). */
const SUBJECTS = ["General", "Tool Submission", "Correction", "Business Inquiry"] as const;

const privacyPath = getPage("privacy-policy").path;

const fieldClass =
  "mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-base text-slate-900 shadow-sm focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/30 focus:outline-none";
---

<form
  name={FORM_NAME}
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="not-prose space-y-5"
>
  <input type="hidden" name="form-name" value={FORM_NAME} />

  <p class="hidden" aria-hidden="true">
    <label>
      Leave this field empty
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-name" class="block text-sm font-medium text-slate-900">
        Name
      </label>
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        class={fieldClass}
      />
    </div>
    <div>
      <label for="contact-email" class="block text-sm font-medium text-slate-900">
        Email
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class={fieldClass}
      />
    </div>
  </div>

  <div>
    <label for="contact-subject" class="block text-sm font-medium text-slate-900">
      Subject
    </label>
    <select id="contact-subject" name="subject" required class={fieldClass}>
      {SUBJECTS.map((subject) => (
        <option value={subject}>{subject}</option>
      ))}
    </select>
  </div>

  <div>
    <label for="contact-message" class="block text-sm font-medium text-slate-900">
      Message
    </label>
    <textarea id="contact-message" name="message" rows="6" required class={fieldClass}></textarea>
  </div>

  <p class="text-sm text-slate-600">
    All fields are required. See our{" "}
    <a href={privacyPath} class="text-indigo-700 underline hover:text-indigo-900">
      privacy policy
    </a>{" "}
    for how form submissions are handled.
  </p>

  <button
    type="submit"
    class="inline-flex items-center rounded-md bg-indigo-700 px-5 py-2.5 font-semibold text-white hover:bg-indigo-800"
  >
    Send message
  </button>
</form>
