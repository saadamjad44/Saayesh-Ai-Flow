---
/**
 * All SEO-critical <head> tags: title, description, canonical, robots,
 * Open Graph, Twitter card, JSON-LD, and Search Console verification.
 */
import { INTEGRATIONS, SITE } from "@/config/site";
import {
  absoluteUrl,
  formatTitle,
  serializeJsonLd,
  type JsonLd,
  type SocialImage,
} from "@/lib/seo";

interface Props {
  title: string;
  description: string;
  /** Trailing-slash path of the canonical URL. Omit for pages without one (e.g. 404). */
  canonicalPath?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Social preview image, resolved centrally by getSocialImage(). */
  image?: SocialImage;
  jsonLd?: readonly JsonLd[];
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  ogType = "website",
  image,
  jsonLd = [],
} = Astro.props;

const fullTitle = formatTitle(title);
const canonicalUrl = canonicalPath ? absoluteUrl(canonicalPath) : undefined;

/**
 * GA4 (gtag.js), configured by INTEGRATIONS.ga4MeasurementId and nothing else.
 * An empty id renders no script at all, so the site works with analytics off.
 * SeoHead is rendered once per page by BaseLayout, so gtag is initialized once.
 */
const ga4Id = INTEGRATIONS.ga4MeasurementId;
const ga4Src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4Id)}`;
const ga4Init = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(ga4Id).replace(/</g, "\\u003c")});`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<meta
  name="robots"
  content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
/>

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
{image && (
  <>
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
  </>
)}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{image && (
  <>
    <meta name="twitter:image" content={image.url} />
    <meta name="twitter:image:alt" content={image.alt} />
  </>
)}

{INTEGRATIONS.searchConsoleVerification && (
  <meta name="google-site-verification" content={INTEGRATIONS.searchConsoleVerification} />
)}

{ga4Id && (
  <>
    <script is:inline async src={ga4Src}></script>
    <script is:inline set:html={ga4Init}></script>
  </>
)}

{jsonLd.map((data) => (
  <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)}></script>
))}
