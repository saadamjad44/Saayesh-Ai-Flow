---
/**
 * Share controls for one page: the device's own share sheet, a copy-link
 * button, and plain links to X and LinkedIn.
 *
 * NO THIRD-PARTY SCRIPT, and this is the whole design constraint. Every
 * share-button widget on the market ships a tracker: embedding one would put a
 * third party's script on 58 pages, load it for every visitor whether or not
 * they share anything, and contradict what the free tools promise in writing
 * about data leaving the browser. So:
 *
 *   - The native button is the Web Share API, which is the browser's own. It is
 *     hidden unless `navigator.share` exists, rather than rendered as a control
 *     that does nothing on a desktop.
 *   - Copy link is `navigator.clipboard`, hidden the same way for the same
 *     reason.
 *   - X and LinkedIn are ordinary <a> links to each site's public share URL.
 *     They load nothing until clicked, set no cookie, and work with scripting
 *     off. No Facebook: its sharer ignores any text passed to it and the
 *     audience for these guides is not there.
 *
 * The URL is built from the canonical absolute URL, not from
 * `window.location`, so a share from a page reached with tracking parameters on
 * the end does not propagate them.
 *
 * `share_click` records which control was used — `params.method` — and nothing
 * else. Never the URL, never the title, never anything a visitor typed.
 *
 * Each network link's accessible name is the full "Share on X" from
 * `aria-label`, while the visible text is just the network, so the control
 * stays short without the announcement becoming "X" on its own.
 */
import { absoluteUrl } from "@/lib/seo";

interface Props {
  /** Canonical path of the page being shared, e.g. "/ai-automation/foo/". */
  path: string;
  /** The page title, used as the suggested share text. */
  title: string;
  /** Heading text. Omit for the default. */
  label?: string;
  class?: string;
}

const { path, title, label = "Share this guide", class: className } = Astro.props;

const url = absoluteUrl(path);

/**
 * Each network's public share endpoint. Both take the URL and the text as query
 * parameters and need nothing else — no app id, no key, no SDK.
 *
 * LinkedIn's current endpoint takes only the URL; it reads the title and
 * description from the page's own Open Graph tags, which this site already
 * emits on every page.
 */
const TARGETS = [
  {
    method: "x",
    network: "X",
    label: "Share on X",
    href: `https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
    /** X's logo, drawn rather than loaded. */
    icon: "M13.683 10.622 20.244 3h-1.555l-5.697 6.62L8.443 3H3l6.881 10.014L3 21h1.555l6.016-6.993L15.557 21H21l-7.317-10.378Zm-2.26 2.626-1.394-1.995-5.55-7.94h2.388l4.479 6.408 1.394 1.994 5.822 8.33h-2.388l-4.75-6.797Z",
  },
  {
    method: "linkedin",
    network: "LinkedIn",
    label: "Share on LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
    icon: "M6.94 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM3.22 8.48h3.44V21H3.22V8.48Zm5.8 0h3.3v1.71h.05a3.62 3.62 0 0 1 3.26-1.79c3.48 0 4.12 2.29 4.12 5.27V21h-3.44v-6.42c0-1.53-.03-3.5-2.13-3.5-2.13 0-2.46 1.67-2.46 3.39V21H9.02V8.48Z",
  },
] as const;

const buttonClass =
  "inline-flex min-h-11 items-center gap-2 rounded-lg border border-ink-200 bg-surface px-3.5 py-2 font-sans text-sm font-bold text-ink-700 shadow-card transition-colors duration-180 ease-ui hover:border-brand-200 hover:bg-brand-50 hover:text-brand-800 motion-reduce:transition-none";

const COPY_PATH =
  "M7.5 3.5A1.5 1.5 0 0 1 9 2h5.5a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 14.5 14H9a1.5 1.5 0 0 1-1.5-1.5v-9Zm-2 2A1.5 1.5 0 0 0 4 7v9a1.5 1.5 0 0 0 1.5 1.5H11A1.5 1.5 0 0 0 12.5 16v-.5H9A3 3 0 0 1 6 12.5V5.5h-.5Z";

const SHARE_PATH =
  "M13 4.5a2.5 2.5 0 1 1 .72 1.75l-5.3 2.65a2.5 2.5 0 0 1 0 2.2l5.3 2.65a2.5 2.5 0 1 1-.67 1.34l-5.3-2.65a2.5 2.5 0 1 1 0-4.88l5.3-2.65A2.5 2.5 0 0 1 13 4.5Z";
---

{/*
  The label is a <p>, not a heading, for the same reason the footer's group
  labels are: this is page furniture, and putting "Share this guide" into the
  heading outline of every entry page as a sibling of the article's real
  sections misdescribes the page. The section is named for assistive technology
  by `aria-label` instead, which is what makes it reachable as a region.
*/}
<section
  aria-label={label}
  class:list={["not-prose my-12", className]}
  data-share-row
  data-share-url={url}
  data-share-title={title}
>
  <p class="eyebrow">{label}</p>

  <div class="mt-3.5 flex flex-wrap items-center gap-2.5">
    {/* Both scripted controls start hidden and are revealed only where the
        browser actually supports them. */}
    <button type="button" class={buttonClass} hidden data-share-native>
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0">
        <path fill-rule="evenodd" d={SHARE_PATH} clip-rule="evenodd"></path>
      </svg>
      Share
    </button>

    <button type="button" class={buttonClass} hidden data-share-copy>
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0">
        <path fill-rule="evenodd" d={COPY_PATH} clip-rule="evenodd"></path>
      </svg>
      <span data-share-copy-label>Copy link</span>
    </button>

    {TARGETS.map((target) => (
      <a
        href={target.href}
        target="_blank"
        rel="noopener"
        aria-label={target.label}
        class={buttonClass}
        data-share-link={target.method}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-[1.0625rem] shrink-0"
        >
          <path d={target.icon}></path>
        </svg>
        {target.network}
      </a>
    ))}

    <p class="text-sm text-ink-500" role="status" aria-live="polite" data-share-status></p>
  </div>
</section>

<script>
  /**
   * Reveals the two controls the browser can actually support, and reports the
   * outcome of a copy in the row's own status region.
   *
   * With this script absent the X and LinkedIn links still work: they are plain
   * links, and the two buttons stay hidden rather than appearing dead.
   */
  import { trackEvent } from "@/lib/analytics";

  const HIDE_STATUS_MS = 4000;

  for (const row of document.querySelectorAll<HTMLElement>("[data-share-row]")) {
    const url = row.dataset.shareUrl ?? "";
    const title = row.dataset.shareTitle ?? document.title;

    const nativeButton = row.querySelector<HTMLButtonElement>("[data-share-native]");
    const copyButton = row.querySelector<HTMLButtonElement>("[data-share-copy]");
    const status = row.querySelector<HTMLElement>("[data-share-status]");

    let statusTimer = 0;
    function say(text: string) {
      if (!status) return;
      status.textContent = text;
      window.clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => {
        status.textContent = "";
      }, HIDE_STATUS_MS);
    }

    if (nativeButton && typeof navigator.share === "function") {
      nativeButton.hidden = false;
      nativeButton.addEventListener("click", () => {
        void navigator
          .share({ title, url })
          .then(() => trackEvent("share_click", { method: "native" }))
          // A cancelled share sheet rejects. That is not an error to report.
          .catch(() => {});
      });
    }

    if (copyButton && navigator.clipboard) {
      copyButton.hidden = false;
      copyButton.addEventListener("click", () => {
        navigator.clipboard.writeText(url).then(
          () => {
            say("Link copied.");
            trackEvent("share_click", { method: "copy" });
          },
          () => say("Copying was blocked by your browser."),
        );
      });
    }

    for (const link of row.querySelectorAll<HTMLAnchorElement>("[data-share-link]")) {
      link.addEventListener("click", () => {
        trackEvent("share_click", { method: link.dataset.shareLink ?? "link" });
      });
    }
  }
</script>
