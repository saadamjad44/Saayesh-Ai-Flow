---
/** Card list of related internal pages (pillar ↔ cluster navigation). */
export interface RelatedPage {
  title: string;
  path: string;
  description: string;
  /** Small label above the title, e.g. "Category hub". */
  kicker?: string;
}

interface Props {
  heading: string;
  items: readonly RelatedPage[];
  /** Unique per page, for aria-labelledby. */
  id: string;
}

const { heading, items, id } = Astro.props;
---

{items.length > 0 && (
  <section aria-labelledby={id} class="not-prose my-12 border-t border-ink-200 pt-10">
    <h2 id={id} class="text-2xl font-bold tracking-display text-ink-900 sm:text-3xl">
      {heading}
    </h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {items.map((item) => (
        <li class="card card-link group relative flex flex-col p-5">
          {item.kicker && <p class="eyebrow">{item.kicker}</p>}
          <h3 class:list={["font-semibold text-ink-900", item.kicker && "mt-1.5"]}>
            <a href={item.path} class="after:absolute after:inset-0 group-hover:text-brand-700">
              {item.title}
            </a>
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{item.description}</p>
          <span
            aria-hidden="true"
            class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700"
          >
            Read guide
            <svg
              viewBox="0 0 20 20"
              fill="currentColor"
              class="size-4 transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </span>
        </li>
      ))}
    </ul>
  </section>
)}
