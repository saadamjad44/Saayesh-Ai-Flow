---
/**
 * Accessible, horizontally scrollable comparison table. The scroll container
 * is focusable so keyboard users can scroll wide tables on small screens.
 */
export interface ComparisonRow {
  label: string;
  cells: readonly string[];
}

interface Props {
  caption: string;
  /** Header for the first (row label) column, e.g. "Tool" or "Feature". */
  rowHeader: string;
  columns: readonly string[];
  rows: readonly ComparisonRow[];
}

const { caption, rowHeader, columns, rows } = Astro.props;

for (const row of rows) {
  if (row.cells.length !== columns.length) {
    throw new Error(
      `ComparisonTable "${caption}": row "${row.label}" has ${row.cells.length} cells, expected ${columns.length}`,
    );
  }
}
---

<div
  role="region"
  aria-label={caption}
  tabindex="0"
  class="not-prose my-8 overflow-x-auto rounded-lg border border-slate-200"
>
  <table class="w-full min-w-max border-collapse text-left text-sm">
    <caption class="border-b border-slate-200 px-4 py-3 text-left font-semibold text-slate-900">
      {caption}
    </caption>
    <thead class="bg-slate-50 text-slate-900">
      <tr>
        <th scope="col" class="px-4 py-3 font-semibold">
          {rowHeader}
        </th>
        {columns.map((column) => (
          <th scope="col" class="px-4 py-3 font-semibold">
            {column}
          </th>
        ))}
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200 text-slate-700">
      {rows.map((row) => (
        <tr>
          <th scope="row" class="px-4 py-3 font-medium text-slate-900">
            {row.label}
          </th>
          {row.cells.map((cell) => (
            <td class="px-4 py-3">{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
