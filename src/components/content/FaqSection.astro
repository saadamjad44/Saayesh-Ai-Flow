---
/**
 * Visible FAQ with matching FAQPage JSON-LD built from the same items.
 * Render it once per page and do not also pass faqSchema() to the layout.
 */
import { faqSchema, serializeJsonLd, type FaqItem } from "@/lib/seo";

interface Props {
  items: readonly FaqItem[];
  heading?: string;
}

const { items, heading = "Frequently asked questions" } = Astro.props;
---

{items.length > 0 && (
  <section aria-labelledby="faq-heading" class="not-prose my-10">
    <h2 id="faq-heading" class="text-2xl font-bold tracking-tight text-slate-900">
      {heading}
    </h2>
    <div class="mt-4 divide-y divide-slate-200 border-y border-slate-200">
      {items.map((item) => (
        <div class="py-4">
          <h3 class="font-semibold text-slate-900">{item.question}</h3>
          <p class="mt-2 text-slate-700">{item.answer}</p>
        </div>
      ))}
    </div>
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(faqSchema(items))}
    ></script>
  </section>
)}
