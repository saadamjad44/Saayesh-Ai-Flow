---
/**
 * Visible FAQ with matching FAQPage JSON-LD built from the same items.
 * Render it once per page and do not also pass faqSchema() to the layout.
 */
import { faqSchema, serializeJsonLd, type FaqItem } from "@/lib/seo";
import { headingId } from "@/lib/ids";

interface Props {
  items: readonly FaqItem[];
  heading?: string;
  /** Overrides the generated heading id, for deep links. Must be unique per page. */
  id?: string;
}

const { items, heading = "Frequently asked questions", id } = Astro.props;
const labelId = id ?? headingId(heading, "faq");
---

{items.length > 0 && (
  <section aria-labelledby={labelId} class="not-prose my-12">
    <p class="eyebrow">Questions</p>
    <h2 id={labelId} class="type-section mt-2">
      {heading}
    </h2>
    {/*
      Each question is a native <details>, so it opens with no script, by
      keyboard as well as by pointer, and its answer is in the document either
      way — a crawler and an in-page find both read a closed one. The first is
      open, so the section never looks like a list of bare questions.

      Questions stay real headings inside the <summary> so they still show up
      in the screen-reader outline.
    */}
    <ul class="mt-7 space-y-3">
      {items.map((item, index) => (
        <li>
          <details class="faq-item card group/faq overflow-hidden" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 transition-colors duration-180 ease-ui hover:text-brand-700 sm:p-6 motion-reduce:transition-none [&::-webkit-details-marker]:hidden">
              <h3 class="font-display text-[1.0625rem] leading-snug font-bold tracking-[-0.018em] text-current">
                {item.question}
              </h3>
              <span
                aria-hidden="true"
                class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700 transition-transform duration-180 ease-ui group-open/faq:rotate-45 motion-reduce:transition-none"
              >
                <svg viewBox="0 0 20 20" fill="currentColor" class="size-4">
                  <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
                </svg>
              </span>
            </summary>
            <p class="px-5 pb-5 leading-relaxed text-ink-600 sm:px-6 sm:pb-6">{item.answer}</p>
          </details>
        </li>
      ))}
    </ul>
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(faqSchema(items))}
    ></script>
  </section>
)}
