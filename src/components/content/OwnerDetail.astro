---
/** Renders an owner detail from src/config/site.ts, or a visible gap when it is not set. */
import ContentGap from "./ContentGap.astro";
import { OWNER, type OwnerDetails } from "@/config/site";

interface Props {
  field: keyof OwnerDetails;
}

const LABELS: Record<keyof OwnerDetails, string> = {
  name: "Owner or business name",
  contactEmail: "Contact email address",
  location: "Owner location",
  jurisdiction: "Governing law / jurisdiction",
};

const { field } = Astro.props;
const value = OWNER[field];
---

{value === null ? (
  <ContentGap label={LABELS[field]} />
) : field === "contactEmail" ? (
  <a href={`mailto:${value}`}>{value}</a>
) : (
  value
)}
