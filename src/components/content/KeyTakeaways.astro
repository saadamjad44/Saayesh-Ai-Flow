---
/**
 * Key takeaways: the few things a reader should leave with, near the top of a
 * guide that genuinely has a short answer.
 *
 * Deliberately understated — a teal rule and a tighter list, not a boxed
 * highlight — because on a page that already opens with a standfirst, a loud
 * summary panel competes with the thing it summarises. Use it where the answer
 * really can be compressed, and not otherwise: three to five points, each one
 * a claim the article goes on to support.
 *
 * Content is authored as a Markdown list inside the component, so the points
 * stay plain text that the reader, a screen reader, and the search index all
 * see the same way.
 */
import { headingId } from "@/lib/ids";

interface Props {
  heading?: string;
  /** Overrides the generated heading id, for deep links. Must be unique per page. */
  id?: string;
}

const { heading = "Key takeaways", id } = Astro.props;
const labelId = id ?? headingId(heading, "key-takeaways");
---

<aside
  aria-labelledby={labelId}
  class="not-prose my-9 border-l-[3px] border-accent-600 bg-accent-50/60 py-5 pr-5 pl-5 sm:pl-6"
>
  <h2 id={labelId} class="eyebrow eyebrow-accent">
    {heading}
  </h2>
  <div class="mt-3 text-[1.0625rem] leading-relaxed text-ink-700 [&_li]:mt-2 [&_li::marker]:text-accent-600 [&_strong]:font-semibold [&_strong]:text-ink-900 [&_ul]:list-disc [&_ul]:space-y-0 [&_ul]:pl-5">
    <slot />
  </div>
</aside>
