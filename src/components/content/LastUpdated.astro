---
/**
 * The byline row under an entry page's header: who wrote it, when it was last
 * updated, how long it takes to read, and — where the page states prices —
 * when those prices were checked.
 *
 * The author comes from AUTHOR in src/config/author.ts, the same entity the
 * page's Article structured data credits, and links to the author page. The
 * dates are the entry's own frontmatter, never a build date. The reading
 * estimate is derived from the entry's own body (see readingMinutes), and is
 * labelled as the estimate it is. Nothing here is a claim the content cannot
 * back.
 *
 * The monogram is initials, not a photograph: the site has no author portrait,
 * and a stock face standing in for a real person would be a false signal.
 */
import { AUTHOR } from "@/config/author";
import { formatDate, isoDate } from "@/lib/format";

interface Props {
  updated: Date;
  pricingVerified?: Date;
  /** Estimated minutes to read, from readingMinutes(entry.body). */
  readingMinutes?: number;
}

const { updated, pricingVerified, readingMinutes } = Astro.props;

const initials = AUTHOR.name
  .split(/\s+/)
  .map((part) => part[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<div class="not-prose flex flex-wrap items-center gap-x-4 gap-y-3">
  <div class="flex items-center gap-2.5">
    <span
      aria-hidden="true"
      class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-50 font-display text-xs font-extrabold tracking-wide text-brand-700 ring-1 ring-brand-100 ring-inset"
    >
      {initials}
    </span>
    <span class="text-sm leading-tight">
      <span class="block text-ink-500">Written by</span>
      <a
        href={AUTHOR.path}
        class="font-display font-bold text-ink-900 transition-colors duration-180 ease-ui hover:text-brand-700 motion-reduce:transition-none"
      >
        {AUTHOR.name}
      </a>
    </span>
  </div>

  {/* The vertical rule only appears once the row has room for it. */}
  <div class="h-8 w-px shrink-0 bg-ink-200 max-sm:hidden"></div>

  <dl class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
    <div class="flex items-baseline gap-1.5">
      <dt class="eyebrow eyebrow-muted">Updated</dt>
      <dd>
        <time datetime={isoDate(updated)} class="font-medium text-ink-700">
          {formatDate(updated)}
        </time>
      </dd>
    </div>

    {readingMinutes !== undefined && (
      <div class="flex items-baseline gap-1.5">
        <dt class="eyebrow eyebrow-muted">Read</dt>
        <dd class="font-medium text-ink-700">~{readingMinutes} min</dd>
      </div>
    )}

    {pricingVerified && (
      <div class="flex items-baseline gap-1.5">
        <dt class="eyebrow eyebrow-muted">Prices checked</dt>
        <dd>
          <time datetime={isoDate(pricingVerified)} class="font-medium text-ink-700">
            {formatDate(pricingVerified)}
          </time>
        </dd>
      </div>
    )}
  </dl>
</div>
