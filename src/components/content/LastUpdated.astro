---
/**
 * The byline row under an entry page's header: who wrote it, when it was last
 * updated, and — where the page states prices — when those prices were checked.
 *
 * The author comes from AUTHOR in src/config/author.ts, the same entity the
 * page's Article structured data credits, and links to the author page. The two
 * dates are the entry's own frontmatter, never a build date, so nothing here is
 * a claim the content cannot back.
 */
import { AUTHOR } from "@/config/author";
import { formatDate, isoDate } from "@/lib/format";

interface Props {
  updated: Date;
  pricingVerified?: Date;
}

const { updated, pricingVerified } = Astro.props;
---

<p class="not-prose flex flex-wrap items-center gap-x-5 gap-y-1.5 text-sm text-ink-500">
  <span class="inline-flex items-center gap-1.5">
    <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-ink-500">
      <path
        fill-rule="evenodd"
        d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-5.5-2.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0ZM10 12a5.99 5.99 0 0 0-4.793 2.39A6.483 6.483 0 0 0 10 16.5a6.483 6.483 0 0 0 4.793-2.11A5.99 5.99 0 0 0 10 12Z"
        clip-rule="evenodd"
      />
    </svg>
    By{" "}
    <a href={AUTHOR.path} class="font-medium text-brand-700 underline hover:text-brand-800">
      {AUTHOR.name}
    </a>
  </span>
  <span class="inline-flex items-center gap-1.5">
    <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-ink-500">
      <path
        fill-rule="evenodd"
        d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z"
        clip-rule="evenodd"
      />
    </svg>
    Last updated{" "}
    <time datetime={isoDate(updated)} class="font-medium text-ink-700">
      {formatDate(updated)}
    </time>
  </span>
  {pricingVerified && (
    <span class="inline-flex items-center gap-1.5">
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-ink-500">
        <path
          fill-rule="evenodd"
          d="M1 4a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4Zm12 4a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM4 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm13-1a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM1.75 14.5a.75.75 0 0 0 0 1.5c4.417 0 8.693.603 12.749 1.73 1.111.309 2.251-.512 2.251-1.696v-.784a.75.75 0 0 0-1.5 0v.784a.272.272 0 0 1-.35.25A49.043 49.043 0 0 0 1.75 14.5Z"
          clip-rule="evenodd"
        />
      </svg>
      Pricing verified{" "}
      <time datetime={isoDate(pricingVerified)} class="font-medium text-ink-700">
        {formatDate(pricingVerified)}
      </time>
    </span>
  )}
</p>
