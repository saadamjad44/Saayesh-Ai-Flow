---
/** One-line affiliate disclosure for pages with affiliate links, linking to the full policy. */
import { getPage } from "@/config/pages";

const disclosurePath = getPage("affiliate-disclosure").path;
---

<aside
  aria-label="Affiliate disclosure"
  class="callout not-prose flex gap-3 border-amber-200 border-l-amber-500 bg-amber-50 text-sm text-amber-900"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    fill="currentColor"
    class="mt-0.5 size-4 shrink-0 text-amber-600"
  >
    <path
      fill-rule="evenodd"
      d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z"
      clip-rule="evenodd"
    />
  </svg>
  <span class="leading-relaxed">
    This page may contain affiliate links. If you buy through them, we may earn a commission at no
    extra cost to you.{" "}
    <a
      href={disclosurePath}
      class="font-semibold underline underline-offset-2 hover:text-amber-950"
    >
      Read our affiliate disclosure
    </a>
  </span>
</aside>
