---
/** One-line affiliate disclosure for pages with affiliate links, linking to the full policy. */
import { getPage } from "@/config/pages";

const disclosurePath = getPage("affiliate-disclosure").path;
---

<aside
  aria-label="Affiliate disclosure"
  class="not-prose rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"
>
  This page may contain affiliate links. If you buy through them, we may earn a commission at no
  extra cost to you.{" "}
  <a href={disclosurePath} class="font-medium underline hover:text-amber-950">
    Read our affiliate disclosure
  </a>
</aside>
