---
/**
 * One guide in a listing. Four shapes, one component, so the homepage, the
 * blog archive, and the pillar hubs cannot drift apart:
 *
 *   lead      the card that opens a section: a wide image, a long summary, and
 *             display-size type
 *   standard  the ordinary grid card: the guide's own photo with its category
 *             pinned to it, then the title, summary and metadata
 *   row       a compact horizontal row: a thumbnail beside the title
 *   compare   a rail card for a head-to-head guide: photo, a "Compare" badge,
 *             title and reading time, and no summary — a rail is scanned, not
 *             read
 *
 * Every field comes from ArticleCardData, which is built from the entry's own
 * frontmatter and the page registry — there is nothing here a template can fill
 * in differently.
 *
 * Pictures: a card uses the guide's own registered photo where there is one.
 * The lead card falls back to the category artwork, and the others to the
 * category's coloured tile, so a card is never an empty box.
 *
 * The whole card is one link target (`.stretch-target` on the title's <a>), so
 * only the title is in the tab order and the clickable area is still the card.
 * The category label is a separate link, lifted above the overlay with
 * `relative z-10` so it stays independently clickable.
 */
import { Image } from "astro:assets";

import PillarTile from "@/components/layout/PillarTile.astro";
import { getMedia } from "@/config/media";
import type { ArticleCardData } from "@/lib/content";
import { formatShortDate, isoDate } from "@/lib/format";

interface Props {
  article: ArticleCardData;
  variant?: "lead" | "standard" | "row" | "compare";
  /** Loads the lead image eagerly. Use only for an above-the-fold card. */
  priority?: boolean;
  /** The `sizes` attribute for a lead card's image. */
  sizes?: string;
  /** Heading level, so a card never breaks the page's outline. */
  as?: "h2" | "h3";
  class?: string;
}

const {
  article,
  variant = "standard",
  priority = false,
  sizes = "(min-width: 1024px) 36rem, 92vw",
  as: Heading = "h3",
  class: className,
} = Astro.props;

const isLead = variant === "lead";
const isRow = variant === "row";
const isCompare = variant === "compare";

/**
 * The picture a card shows. The lead card uses its category's artwork, which
 * was drawn for a wide crop; a guide's own photo is a stock picture of any
 * shape, and blown up to lead size a centre crop of one lands wherever it
 * lands. Grid, row and rail cards are small enough that the guide's own photo
 * crops acceptably, and distinct enough that twenty cards are twenty pictures.
 */
const leadMedia = isLead ? getMedia(article.mediaId) : undefined;
const cardMedia = !isLead ? article.articleMedia : undefined;

/** The arrow every card ends on; it slides on hover via the `group`. */
const ARROW =
  "M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z";

/**
 * The category label when it sits on a photograph. Fixed colours rather than
 * tokens: it is a white pill on a picture in both themes.
 */
const photoLabel =
  "relative z-10 inline-flex items-center rounded-full bg-white/92 px-2.5 py-1 font-mono text-[0.625rem] leading-4 font-semibold tracking-[0.07em] text-[#16204a] uppercase shadow-sm backdrop-blur-sm transition-colors duration-180 ease-ui hover:bg-white motion-reduce:transition-none";
---

<article
  class:list={[
    "card card-link group relative flex overflow-hidden",
    isRow ? "items-center gap-4 p-3 sm:p-3.5" : "flex-col",
    !isRow && !isLead && !cardMedia && "p-5",
    className,
  ]}
>
  {/*
    The lead card's picture is described, not decorative. Its alt is the
    registry's own factual description of the picture — never the headline
    beneath it, which would make a screen reader read the same words twice and
    tells an image search nothing about the picture.
  */}
  {isLead && leadMedia && (
    <div class="relative overflow-hidden">
      <Image
        src={leadMedia.src}
        alt={leadMedia.alt}
        widths={[640, 960, 1280]}
        sizes={sizes}
        loading={priority ? "eager" : "lazy"}
        decoding={priority ? "sync" : "async"}
        fetchpriority={priority ? "high" : "auto"}
        class="aspect-[16/9] w-full object-cover transition-transform duration-700 ease-ui group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
      />
      {article.category && (
        <p class="absolute top-4 left-4">
          <a href={article.category.path} class={photoLabel}>
            {article.category.title}
          </a>
        </p>
      )}
    </div>
  )}

  {/* Grid and rail cards: the guide's own photo, with its category on it. */}
  {cardMedia && !isRow && (
    <div class="relative overflow-hidden">
      <Image
        src={cardMedia.src}
        alt={cardMedia.alt}
        widths={[400, 640, 960]}
        sizes="(min-width: 1024px) 24rem, 92vw"
        loading="lazy"
        decoding="async"
        class="aspect-[16/9] w-full object-cover transition-transform duration-700 ease-ui group-hover:scale-[1.06] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
      />
      <p class="absolute top-3 left-3 flex items-center gap-1.5">
        {isCompare && <span class="badge badge-solid relative z-10 shadow-sm">Compare</span>}
        {!isCompare && article.category && (
          <a href={article.category.path} class={photoLabel}>
            {article.category.title}
          </a>
        )}
      </p>
    </div>
  )}

  {/* Row card: a thumbnail, or the category tile where no photo is registered. */}
  {isRow &&
    (cardMedia ? (
      <Image
        src={cardMedia.src}
        alt=""
        widths={[160, 320]}
        sizes="6rem"
        loading="lazy"
        decoding="async"
        class="size-20 shrink-0 rounded-xl object-cover sm:size-24"
      />
    ) : (
      article.icon && <PillarTile icon={article.icon} size="lg" />
    ))}

  <div
    class:list={[
      "flex min-w-0 flex-1 flex-col",
      isLead && "p-6 sm:p-7",
      cardMedia && !isRow && "p-5",
    ]}
  >
    {/*
      Category line, for the shapes that do not already carry it on a photo:
      the row card, and a grid card with no photo of its own.
    */}
    {article.category && (isRow || (!isLead && !cardMedia)) && (
      <p class="flex items-center gap-2.5">
        {!isRow && article.icon && <PillarTile icon={article.icon} size="sm" />}
        <a
          href={article.category.path}
          class="eyebrow relative z-10 -my-1 py-1 transition-colors duration-180 ease-ui hover:text-ink-900 motion-reduce:transition-none"
        >
          {article.category.title}
        </a>
      </p>
    )}

    <Heading
      class:list={[
        isRow && article.category && "mt-1.5",
        !isRow && !isLead && !cardMedia && article.category && "mt-3.5",
        isLead
          ? "font-display text-[1.375rem] leading-[1.2] font-bold tracking-[-0.028em] text-balance text-ink-900 sm:text-[1.75rem]"
          : isRow
            ? "font-display text-[0.9375rem] leading-snug font-bold tracking-[-0.015em] text-ink-900 sm:text-base"
            : "type-card-title",
      ]}
    >
      <a
        href={article.path}
        class="stretch-target transition-colors duration-180 ease-ui group-hover:text-brand-700 motion-reduce:transition-none"
      >
        {article.title}
      </a>
    </Heading>

    {!isRow && !isCompare && (
      <p
        class:list={[
          "mt-2.5 flex-1 leading-relaxed text-ink-600",
          isLead ? "text-[1.0625rem]" : "line-clamp-3 text-[0.9375rem]",
        ]}
      >
        {article.description}
      </p>
    )}

    <p
      class:list={[
        "flex items-center gap-x-2.5 font-mono text-[0.6875rem] tracking-[0.04em] text-ink-500 uppercase",
        isRow ? "mt-2" : isCompare ? "mt-auto pt-4" : "mt-5 border-t border-ink-100 pt-4",
      ]}
    >
      <time datetime={isoDate(article.updated)}>{formatShortDate(article.updated)}</time>
      <span aria-hidden="true" class="text-ink-300">
        &middot;
      </span>
      <span>{article.minutes} min read</span>
      {!isRow && (
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="ml-auto size-4.5 text-brand-600 transition-transform duration-180 ease-ui group-hover:translate-x-1 motion-reduce:transition-none"
        >
          <path fill-rule="evenodd" d={ARROW} clip-rule="evenodd" />
        </svg>
      )}
    </p>
  </div>
</article>
