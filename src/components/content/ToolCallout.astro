---
/**
 * In-body pointer from a guide to one of the site's free interactive tools.
 *
 * Used where a reader has just been asked to work a number out and a tool on
 * this site does exactly that calculation — not as a generic cross-link block.
 * The destination and its name come from the page registry, so neither can
 * drift from the tool's real URL or title, and `tool` is typed to the
 * registry's page ids.
 */
import { getPage, type PageId } from "@/config/pages";
import { menuLabel } from "@/config/navigation";
import { headingId } from "@/lib/ids";

interface Props {
  /** Registry id of the tool page to link to. */
  tool: PageId;
  /** Link text. Defaults to the tool's short nav label. */
  label?: string;
  /** Overrides the generated region id, for deep links. Must be unique per page. */
  id?: string;
}

const { tool, label, id } = Astro.props;
const page = getPage(tool);
const linkText = label ?? menuLabel(page);
const labelId = id ?? headingId(linkText, "free-tool");
---

<aside
  aria-labelledby={labelId}
  class="callout not-prose my-8 border-brand-200 border-l-brand-600 bg-brand-50 px-5 py-5 sm:px-6"
>
  <p class="eyebrow">Free tool</p>
  <p id={labelId} class="mt-1.5 text-lg font-bold tracking-display">
    <a
      href={page.path}
      class="inline-flex items-baseline gap-1.5 text-brand-800 underline decoration-brand-300 underline-offset-[3px] hover:text-brand-900 hover:decoration-current"
    >
      {linkText}
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="size-4 shrink-0 self-center"
      >
        <path
          fill-rule="evenodd"
          d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
          clip-rule="evenodd"
        />
      </svg>
    </a>
  </p>
  <div class="mt-2 leading-relaxed text-ink-700">
    <slot />
  </div>
</aside>
