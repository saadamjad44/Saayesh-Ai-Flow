---
/** Quick verdict near the top of a page: summary slot plus optional best-for / not-for lines. */
import { headingId } from "@/lib/ids";

interface Props {
  heading?: string;
  bestFor?: string;
  notFor?: string;
  /** Overrides the generated heading id, for deep links. Must be unique per page. */
  id?: string;
}

const { heading = "Quick verdict", bestFor, notFor, id } = Astro.props;
const labelId = id ?? headingId(heading, "verdict");
---

<section
  aria-labelledby={labelId}
  class="callout not-prose my-9 border-brand-200 border-l-brand-600 bg-brand-50 px-5 py-5 text-ink-700 sm:px-6"
>
  <h2
    id={labelId}
    class="flex items-center gap-2 text-base font-bold tracking-[0.04em] text-brand-900 uppercase"
  >
    <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-brand-600">
      <path
        fill-rule="evenodd"
        d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z"
        clip-rule="evenodd"
      />
    </svg>
    {heading}
  </h2>
  <div class="mt-3 space-y-2 leading-relaxed">
    <slot />
  </div>
  {(bestFor || notFor) && (
    <dl class="mt-4 grid gap-3 border-t border-brand-200 pt-4 text-sm sm:grid-cols-2">
      {bestFor && (
        <div>
          <dt class="text-xs font-bold tracking-[0.06em] text-brand-800 uppercase">Best for</dt>
          <dd class="mt-1 text-ink-700">{bestFor}</dd>
        </div>
      )}
      {notFor && (
        <div>
          <dt class="text-xs font-bold tracking-[0.06em] text-brand-800 uppercase">Not for</dt>
          <dd class="mt-1 text-ink-700">{notFor}</dd>
        </div>
      )}
    </dl>
  )}
</section>
