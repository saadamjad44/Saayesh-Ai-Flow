---
/**
 * A tool recommendation inside a guide: what it is, who it suits, what it
 * costs, and a real link to the vendor.
 *
 * Every field is passed in by the author and rendered as given — there is no
 * rating, no score, and no "our pick" badge, because the site has no scoring
 * system for research-based pages (see ScoreTable, which requires hands-on
 * testing evidence). `verified` is the date the author checked the pricing
 * page, shown on the card so a stale price is visible as one rather than
 * reading as current.
 *
 * The outbound link goes through the site's link policy in src/lib/links.ts,
 * so a commercial destination gets rel="sponsored" from `kind`.
 */
import { formatDate } from "@/lib/format";
import { outboundLinkAttrs, type OutboundLinkKind } from "@/lib/links";

interface Props {
  name: string;
  /** Vendor URL. */
  href: string;
  /** "sponsored" for affiliate, paid, or otherwise commercial destinations. */
  kind?: OutboundLinkKind;
  /** One line on what the tool is. */
  summary: string;
  /** Who it suits, e.g. "Marketing teams producing a lot of on-brand content". */
  bestFor?: string;
  /** Price as the vendor states it, e.g. "$20/month" or "Free plan available". */
  price?: string;
  /** Date the price above was checked on the vendor's own pricing page. */
  verified?: Date;
}

const { name, href, kind, summary, bestFor, price, verified } = Astro.props;
const policy = outboundLinkAttrs(href, { kind });

const facts = [
  bestFor ? { label: "Best for", value: bestFor } : null,
  price ? { label: "Price", value: price } : null,
].filter((fact): fact is { label: string; value: string } => fact !== null);
---

<div class="card not-prose my-8 p-5 sm:p-6">
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
    <div class="min-w-0">
      <h3 class="type-card-title">{name}</h3>
      <p class="mt-1.5 leading-relaxed text-ink-600">{summary}</p>
    </div>
    <a {href} {...policy} class="btn btn-secondary shrink-0 max-sm:w-full">
      Visit {name}
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
        <path d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
        <path d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v8.5A2.75 2.75 0 0 0 4.75 18h8.5A2.75 2.75 0 0 0 16 15.25V13a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-8.5c-.69 0-1.25-.56-1.25-1.25v-8.5Z" />
      </svg>
    </a>
  </div>

  {facts.length > 0 && (
    <dl class="mt-5 grid gap-x-6 gap-y-3 border-t border-ink-200 pt-4 text-sm sm:grid-cols-2">
      {facts.map((fact) => (
        <div>
          <dt class="eyebrow eyebrow-muted">{fact.label}</dt>
          <dd class="mt-1 leading-relaxed text-ink-700">{fact.value}</dd>
        </div>
      ))}
    </dl>
  )}

  {verified && (
    <p class="mt-3 font-mono text-[0.6875rem] tracking-[0.04em] text-ink-500 uppercase">
      Price checked {formatDate(verified)}
    </p>
  )}
</div>
