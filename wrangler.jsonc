{
  // The Cloudflare Pages project that serves saayeshaiflow.com. It must match
  // the project in the dashboard: `wrangler pages deploy` targets whatever is
  // named here, and "ai-tool-website" is a different, unrelated live site.
  "name": "saayesh-ai-flow",
  "compatibility_date": "2026-10-06",
  "pages_build_output_dir": "./dist"
}
