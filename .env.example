# Copy to `.env` for local development; set the same variable in the hosting
# build environment for production. `.env` itself is git-ignored.

# Web3Forms access key for the contact form (https://web3forms.com).
#
# This is a PUBLIC key and is inlined into the built HTML on purpose: a
# Web3Forms access key only authorises delivery to the one inbox it was issued
# for and grants no account access. Rotate it from the Web3Forms dashboard if it
# ever gets abused. Never put a real secret in a PUBLIC_ variable.
#
# Without it the contact form renders disabled with an email fallback.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Newsletter subscribe endpoint — the URL your email provider gives you for an
# embedded signup form (Mailchimp, Kit/ConvertKit, Buttondown, MailerLite…).
#
# The form POSTs to it as an ordinary HTML form, so the provider's own page
# handles confirmation and double opt-in. That is deliberate: every provider
# supports a plain POST, while a fetch() submission is blocked by CORS on some
# of them. Public by design, like the key above — it only accepts subscriptions
# to the one list it belongs to.
#
# Without it the signup form renders disabled and says so.
PUBLIC_NEWSLETTER_ENDPOINT=

# The field name that provider expects the address in. Most use "email";
# Kit/ConvertKit uses "email_address" and Mailchimp's embedded form uses "EMAIL".
# Copy it from the `name` attribute of the email input in the provider's embed
# snippet rather than guessing. Leave unset for "email".
PUBLIC_NEWSLETTER_EMAIL_FIELD=
