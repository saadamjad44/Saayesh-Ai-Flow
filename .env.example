# Copy to `.env` for local development; set the same variable in the hosting
# build environment for production. `.env` itself is git-ignored.

# Web3Forms access key for the contact form (https://web3forms.com).
#
# This is a PUBLIC key and is inlined into the built HTML on purpose: a
# Web3Forms access key only authorises delivery to the one inbox it was issued
# for and grants no account access. Rotate it from the Web3Forms dashboard if it
# ever gets abused. Never put a real secret in a PUBLIC_ variable.
#
# Without it the contact form renders disabled with an email fallback.
PUBLIC_WEB3FORMS_ACCESS_KEY=replace_me
